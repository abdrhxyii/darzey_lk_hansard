    "chunk_text": "\u0db1\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dbd \u0dd9\u0dcf \u0dba\u0da7\u0dcf \u0dc0 \u0daf\u0db8\u0dca\u0dd9\u0dba\u0dd2. \u0daf\u0dd9\u0db8 \u0dda\u0dd2\u0dc5 \u0db1\u0dca\u0daf\u0dda \u0da2\u0dd3\u0dc0\u0daf\u0db1 \u0db1\u0dcf \u0dad\u0da9\u0db1\u0da7 \u0dc0\u0db1 \u0daf\u0dd9\u0dcf \u0db4 \u0dd9\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0dda \u0dad\u0dba\u0dd2\u0dad\u0dd2\u0d9a \u0dc3\u0dd4\u0dba\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0daf\u0dc0\u0db1\u0dc0\u0dcf \u0dd9? \u0dba\u0da2 \u0d92 \u0d9c\u0dd0\u0db4\u0dbd\u0dd4\u0dc0\u0db4 \u0d8b\u0dca\u0dad\u0dba \u0daf\u0dd9\u0db1\u0dca\u0db1\u0db4 \u0d95\u0db1\u0dd1. \u0dad\u0dd2\u0d9a\u0dca\u0dae\u0dca\u0db8 \u0dcf\u0dcf \u0dba\u0dcf \u0db8 \u0db4\u0dca\u200d\u0dbb\u0daf\u0daf\u0dca\u0db7\u0db0\u0daf\u0dda \u0d9a\u0dd2\u0db4\u0dad\u0db1\u0dca\u0dd9 \u0dc0\u0dba\u0dcf \u0d9c\u0dca\u0daf\u0dad\u0dcf \u0dca, \u0d91\u0dc4\u0dd2 \u0db0\u0dd3\u0dc0\u0dba \u0dbb\u0dd0\u0d9a\u0dd2 \u0dcf \u0daf\u0dda \u0dd2\u0dbd \u0dd0\u0daf\u0dc5\u0db1 \u0db0\u0dd3\u0dc0\u0dba \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf \u0dc0 \u0dd9\u0dcf\u0dca\u0dae \u0d9c\u0da7\u0db1\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf . \u0daf\u0db8\u0dca \u0daf\u0db8 \u0dcf \u0daf\u0dcf\u0dcf \u0dad \u0dc0\u0db1 \u0dc0\u0dd2\u0db4 \u0d9a\u0dd2\u0db4\u0dad\u0db1\u0dca\u0dd9 \u0db0\u0dd3\u0dc0\u0dba \u0dc0\u0dba\u0dcf \u0dca\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0da7\u0daf \u0db1\u0dca\u0db8 \u0dad\u0da9\u0db1\u0da7 \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf \u0dc3 \u0d91\u0dc4\u0dd2 \u0db0\u0dd3\u0dc0\u0dba \u0dba\u0dca\u0dae\u0dca\u0dcf \u0dc0 \u0dad\u0da9\u0db1\u0da7 \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0dd9\u0dcf\u0dca\u0dae \u0d9c\u0da7\u0db1\u0d9a\u0dca \u0da2\u0dd3\u0dc0\u0daf\u0db1 \u0db1\u0dcf \u0dd9\u0dba \u0d9c\u0dca\u0dd4 \u0d92 \u0db0\u0dd3\u0dc0\u0dba \u0dc0\u0dba\u0dcf \u0dad\u0dd9 \u0daf\u0d9c\u0dcf \u0da9 \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0dc0\u0dd0\u0dd2 \u0d89\u0dc0\u0dca \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dd2 \u0dcf \u0dba\u0da2 \u0daf\u0dd9 \u0da7\u0dd2 \u0d9c\u0da7\u0db1\u0d9a\u0dca \u0daf\u0d9c\u0dc0\u0db1\u0dc0\u0dcf . \u0d89\u0dc0\u0dca \u0dd9\u0dba\u0db1 \u0dc0\u0dd0\u0dd2 \u0da7\u0dd2\u0dd9 \u0d92 \u0dc0\u0dba\u0dcf \u0daf\u0dda \u0d91\u0dcf\u0dcf \u0db1\u0dd0\u0dca\u0daf\u0dca\u0db8 \u0dd9\u0dd0\u0db8\u0dca\u0db8 \u0dcf \u0db4 \u0db1\u0dc3\u0dd4\u0dc0 sea currents\n\n477 478\n\n[\u0d9c\u0dbb\u0dd4 1\u0d86\u0da0\u0dcf \u0dbb\u0dca\u0dbd \u0dcf\u0db4\u0dad\u0dd2\u0dbd \u0dad\u0db8 \u0dba\u0dc3\u0dd6\u0db4\u0dad ]\n\n2026 \u0dad\u0daf\u0d9c \u0dca\u0dae\u0dd4 20\n\n\u0db1\u0da7\u0dca\u0db4\u0db8\u0dca \u0dc0\u0db1 \u0daf\u0dd9\u0dcf \u0db4 \u0d92 \u0db1\u0dc0\u0dd4\u0dbd\u0dca\u0dc0 \u0dd9\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0dda \u0dad\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dc0\u0dcf \u0dc3\u0dd2\u0dd9\u0db8\u0dca \u0dc3\u0dd4\u0dba\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0daf\u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dd9\u0dcf \u0daf\u0dcf\u0dcf \u0db8 \u0dd9? \u0d92 \u0dad\u0db8\u0dca\u0db8 \u0dcf , \u0dad\u0dcf \u0dca\u0dad \u0dcf \u0db4 \u0dad\u0db8 \u0daf\u0dd6 \u0dd9\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0db4 \u0dd2\u0dbd\n\n\u0dc3\u0dd2 \u0dad\u0dcf\u0dcf \u0dba \u0daf\u0dda\u0dbd\u0dca \u0dd4\u0db1\u0d9a\u0dca \u0db3\u0dcf \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0db4\u0dad \u0daf\u0dd9\u0dcf \u0db4 \u0d92 \u0dad \u0daf\u0dda \u0dad\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dc0\u0dcf \u0dc3\u0dd2\u0dd9\u0db8\u0dca \u0dc3\u0dd4\u0dba\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dcf \u0daf\u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dd9\u0dcf \u0daf\u0dcf\u0dcf \u0db8 \u0dd9?\n\n\u0d92 \u0dc0\u0dcf \u0daf\u0dda \u0db8 , \u0dd9\u0dca\u0dd9\u0dcf\u0dca\u0dae \u0d9c\u0da7\u0dd2\u0dbd\u0db1\u0dca \u0dad\u0dbb\u0dd4\u0da7 \u0db1\u0dba\u0db8\u0dca\u0db1\u0dba\u0dcf \u0dc0 \u0db3 \u0dcf \u0daf\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf , \u0d8a\u0dbb\u0dcf \u0db4 \u0db1\u0dca\u0db1. \u0d8a\u0dbb\u0dcf \u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca \u0dcf \u0daf\u0dcf\u0dcf \u0d86\u0dd9\u0dcf \u0db8 \u0d9a\u0dca \u0db3\u0dcf \u0daf\u0d9c\u0db1 \u0d92 \u0db3\u0db1 \u0d86\u0dd9\u0dcf \u0db8 \u0d92 \u0dad \u0daf\u0dda \u0db1\u0dc0\u0dd4\u0dbd\u0dca\u0dc0 \u0db4 \u0d91\u0dda\u0dc0\u0dcf \u0db8 \u0d91\u0dd9 \u0db1\u0dd0\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0d92 \u0dc0\u0dd2\u0daf\u0daf\u0dca\u0db7\u0db0 \u0daf\u0dda\u0dc2\u0dca\u0da8\u0da7 - foreign remittances -\n\n\u0dcf \u0dba\u0daf\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0dd9 \u0db4 \u0db0\u0d9a\u0dca\u0dad\u0dd2\u0d9a \u0d9a\u0dca \u0dd0\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0dad\u0daf\u0db1\u0d9a\u0dca \u0db1\u0dd0\u0dca\u0daf\u0dad\u0db1\u0dca, \u0dad\u0db8 \u0db1\u0dca\u0daf\u0dda \u0db1\u0dc0\u0dd4\u0dbd\u0dca\u0dc0 \u0daf\u0dd6 \u0dd9\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0db4 \u0dd2\u0dbd\u0dc3\u0dd2 \u0d86\u0dcf\u0dcf \u0dba, \u0daf\u0db1 \u0dc2\u0dca\u0da8\u0da7 , \u0db0\u0d9a\u0dca\u0dad\u0dd2\u0d9a , \u0db1\u0dcf \u0dca\u0dbd\u0dca \u0d8b\u0db1\u0dd9\u0dba\u0da7, \u0dad\u0db1\u0dba\u0dcf \u0db1\u0db1 \u0db4 \u0d8b\u0dd9\u0dda \u0db3\u0dd4\u0dc5\u0dd4 \u0d94\u0d9a\u0dca\u0daf\u0dd9 \u0db8 \u0db3\u0dcf \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dc0\u0dcf . \u0dcf\u0dd0\u0db3\u0dd0\u0dba\u0dd2 \u0dad\u0dd9 \u0dc0\u0db1 \u0dc0\u0dd2\u0db4 \u0dbb\u0dd0\u0d9a\u0dd2 \u0dcf \u0dca \u0dcf\u0dcf \u0d8a\u0dbb\u0dcf \u0db4 \u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf \u0dca\u0db8 \u0dd9 \u0dd9\u0dba\u0db1 Government-to-Government programme \u0d91\u0dd9 \u0dca\u0dcf\u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db8 \u0dad\u0dd9\u0dbb\u0dca\u0dbd\u0db8 \u0da7\u0dba \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0dba\u0da2 \u0dcf\u0dba\u0dcf\u0dcf \u0d8a\u0dbb\u0dcf \u0db4 \u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0dbb\u0dd4\u0dd2\u0dc5 \u0dbd\u0dca \u0d9a\u0dca\u0dc2\u0dca\u0da8 4\u0d9a\u0dca, 5\u0d9a\u0dca \u0dad\u0db8 \u0dba\u0dd2 \u0db1\u0dca\u0daf\u0db1\u0dca. \u0daf\u0db1\u0dde\u0daf\u0dca\u0db7\u0d9c\u0dd2\u0dd9\u0dc0 \u0d8a\u0dbb\u0dcf \u0db4 \u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0dbb\u0dd4\u0dd2\u0dc5 \u0dbd\u0dca \u0d9a\u0dca\u0dc2\u0dca\u0da8 35\u0d9a\u0dca, 40\u0d9a\u0dca, 45\u0d9a\u0dca \u0db1\u0dc0\u0dcf . \u0dd2\u0dbd\n\n\u0dd9\u0db8 \u0db4 \u0dca\u0dc1\u0dca\u0db1\u0dca\u0dd9\u0db1 \u0dd9\u0dba \u0db3 \u0dcf \u0daf\u0db1\u0dcf \u0dca\u0da9\u0d9a\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd3 \u0dba\u0da2 \u0d86\u0dd9\u0dbb\u0dca\u0dbd\u0db0 \u0db4 \u0d9c\u0db1\u0dca\u0db1. \u0d92 \u0dba\u0daf\u0da7\u0dca \u0d8a\u0dbb\u0dcf \u0db4 \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dd9\u0dd2\u0db6\u0db1\u0dca\u0db8 \u0dba\u0da2 \u0dca"
  },

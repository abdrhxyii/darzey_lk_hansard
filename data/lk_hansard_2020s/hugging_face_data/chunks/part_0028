    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dad\u0dbb\u0dd4 \u0db8\u0dda\u0dd3\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, GI \u0d85\u0d9c\u0dad\u0dba \u0d9c\u0dad\u0dad\u0dca\u0dba\u0dad\u0dca\u200d\u0dcf\u0dad\u0dca, . \u0dd2\u0dba\u0dc0\u0dbd \u0dc3\u0dd2\u0dba\u0dba\u0da7 65-70 \u0d85\u0dad\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dd4\u0dad\u0dca, \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dd2\u0dbb\u0da7 - \u0dc1\u0dd4\u0dc1\u0db0 - \u0d9a\u0dd2\u0dad\u0dd4\u0dbb\u0dbd\u0dca \u0db4\u0dd0\u0dab\u0dd2\u0dc0\u0dbd \u0dc3\u0dd2\u0dba\u0dba\u0da7 35\u0d9a\u0dca\u0dad \u0dad\u0dca\u200d\u0dbb\u0db8\u0dca \u0d85\u0da9\u0dd4 \u0d85\u0d9c\u0dad\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dd2\u0dba\u0db6\u0dda\u0dba\u0dda \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0daf\u0dda\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dd2\u0dba\u0dc3\u0dcf \u0daf\u0dd2\u0dba\u0dc0\u0dd0\u0dd2\u0dba\u0dcf \u0dba\u0dbb \u0d9c\u0dd3\u0dda\u0da7 \u0dba\u0dc3\u0dde\u0d9b\u0dba \u0dc4\u0dbb\u0d9a\u0dca\u0dad\u0dc2\u0dd2\u0dad\u0dca\u200d \u0dc4\u0dc4\u0dcf\u0dbb\u0dba\u0d9a\u0dca\u0dad \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7\u0dad\u0dca, \u0dba\u0dbd \u0d9a\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dad\u0dca \u0dbb\u0dc3 \u0dc4\u0dc4\u0dcf\u0dbb\u0dba\u0d9a\u0dca\u0dad \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7\u0dad\u0dca, \u0dc0\u0dd2\u0dba\u0dba\u0dca\u0dc2 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0d9a\u0dca\u0dad \u0dd2\u0dba\u0db6\u0db1 \u0dc4\u0dc4\u0dcf\u0dbb\u0dba\u0d9a\u0dca\u0dad \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7\u0dad\u0dca \u0d9a\u0dd2\u0dad\u0dd4\u0dbb\u0dbd\u0dca \u0db4\u0dd0\u0dab\u0dd2 \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0daf\u0dd0\u0db1\u0da7 \u0dbd\u0d82\u0d9a\u0dcf\u0dba\u0dda \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dbb\u0db1 \u0dba\u0db8\u0db8 \u0dd2\u0dba\n\n\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d91\u0d9a\u0dca\u0dad\u0dc3\u0dad\u0dca \u0dbb\u0dcf\u0da2\u0db0\u0dcf\u0dd2\u0dba\u0dba, \u0d89\u0dad\u0dca\u200d\u0dcf\u0dd2\u0dba, \u0da2 \u0db8\u0dd2\u0dba\u0dba, \u0db4\u0dca\u200d\u0dbb\u0d82\u0dba\u0dba \u0dc3\u0dc4 \u0db8\u0dd0\u0daf \u0dba\u0db4\u0dbb\u0daf\u0dd2\u0d9c\u0dad \u0dbb\u0da7\u0dc0\u0dbd\u0da7 \u0d85\u0db4\u0da7 \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8\u0d9a\u0dca\u0dad \u0dd2\n\n\u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0d85\u0db4\u0dd2 \u0daf\u0dda\u0db1\u0dc0\u0dcf, \u0dc3\u0dca\u0dc0\u0dba\u0d82 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0db8\u0da7\u0da7\u0db8\u0dd2\u0dda \u0d9c\u0dad\u0dad\u0dca\u0dad\u0dca\u200d\u0dad\u0dca, \u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0dba\u0dc0\u0dba \u0db3 \u0dba\u0db4\u0dcf \u0dad\u0dd4\u0dbb \u0dba\u0db8\u0dca \u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0dc1\u0dd4\u0dc1\u0db0 \u0d9a\u0dd2\u0dad\u0dd4\u0dbb\u0dbd\u0dca \u0db4\u0dd0\u0dab\u0dd2 \u0db8\u0dd2\u0dd2\u0db1 \u0da7\u0dbb 750\u0d9a \u0dba\u0db6 \u0dad\u0dca\u200d\u0dbd\u0dba\u0d9a\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 2,000 - 3,500 \u0d85\u0dad\u0dca\u200d\u0dbb \u0db8\u0dd2\u0dbd\u0d9a\u0da7 \u0d85\u0dba \u0dc0\u0dd2 \u0d9a\u0dbb \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dd2\u0dba\u0db6\u0db1 \u0db6\u0dc0\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dd2\u0dbb\u0da7 \u0dc4\u0d9a\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd \u0d9c\u0dca\u200d\u0dbb \u0db8\u0dba\u0d9a\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 2,500\u0d9a\u0da7, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 4,000\u0d9a\u0da7 \u0dc0\u0dd0\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d91\u0da7 \u0d85\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dba\u0dad\u0dca\u200d\u0dd2\u0dd2\u0da2 \u0dbb\u0dcf \u0db1 \u0da7\u0dbb\u0dba\u0d9a\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 400\u0d9a\u0dca\u0dad, 800\u0d9a\u0dca\u0dad \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0db8\u0dd2\u0dbd\u0d9a\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4\n\n\u0dba\u0db8\u0dca \u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0dba \u0dad\u0dd4\u0dbb \u0daf\u0d9a\u0dca\u0dad\u0db1\u0da7 \u0dbd\u0dd0\u0dba\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0d9a\u0dca\u0dad \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2, \u0dba\u0db8\u0dca\u0dc0\u0dcf\u0da7 . \u0dd2\u0dba \u0d9a\u0dbd\u0dc0\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dda \u0db6\u0dcf\u0dbd \u0dd2\u0dba\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0d91\u0dba\u0dc4\u0db8 \u0dd2\u0dba\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db8\u0dd2\u0dd2\u0db1 \u0da7\u0dbb 750\u0d9a \u0db4\u0dd0\u0dab\u0dd2 \u0dba\u0db6 \u0dad\u0dca\u200d\u0dbd\u0dba\u0d9a\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 800\u0d9a\u0da7, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,200\u0d9a\u0da7 \u0dc0\u0dcf\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0dba\u0db8\u0dca \u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0dba \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0dc1\u0daf\u0dd2 \u0dba\u0db8\u0dca \u0d85\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dca\u200d\u0dba\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dad\u0dca \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dbb\u0dc0 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4\n\n\u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0dba\u0db8\u0dca \u0dba\u0dcf\u0d9a\u0dba \u0d9a\u0dd0\u0dbd \u0dba\u0dda \u0dd2\u0dba\u0d9a\u0dbb\u0dd4\u0dba\u0dab\u0dca \u0dc4\u0dd0\u0dba\u0daf\u0db1 \u0dba\u0dcf\u0d9a\u0dba\u0d9a\u0dca\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dba\u0db1\u0dcf\u0dc3\u0dbd\u0d9a\u0dcf, \u0dc0\u0dd0\u0dc0\u0dd2\u0dd2 \u0dba\u0dcf\u0d9a\u0dba\u0d9a\u0dca\u0dad - plantation crop \u0d91\u0d9a\u0d9a\u0dca\u0dad -\n\n\u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dad\u0dca, systematic \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dad\u0dca cultivation \u0d91\u0d9a\u0d9a\u0da7 \u0dba\u0dda\u0db1 \u0d85\u0db4\u0dd2 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0dda\u0db1 \u0d95\u0db1 \u0db4 \u0db8\u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dad\u0dd4\u0dbb \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dba\u0db8\u0dca\u0dc0\u0dcf \u0dc0\u0d9c\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0d92 \u0db8\u0da7\u0da7\u0db8 \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0d9c\u0dd2\u0dba\u0dba\u0dcf\u0dad\u0dca \u0d85\u0db4\u0dd2\u0da7 \u0dba\u0db8\u0dca \u0dba\u0dcf\u0d9a\u0dba\u0dba\u0dda \u0db8 \u0da7 \u0d85\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dad\u0dca\u200d\u0dc0\u0dad\u0dca \u0dba\u0db6\u0dcf\u0dba\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dba \u0da2\u0db1 \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0db4 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0dd2\u0dad\u0dd4\u0dbb\u0dbd\u0dca \u0db4\u0dd2\u0da7\u0dd2, \u0d9a\u0dd2\u0dad\u0dd4\u0dbb\u0dbd\u0dca \u0dc4\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dca\u200d \u0d85\u0dad\u0dd4\u0dbb\u0dbb\u0dd4\u0db4\u0dc3 \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad, \u0da7\u0dd2\u0dda \u0d9a \u0dbb\u0dcf, \u0dc0\u0dba\u0dd2\u0dda \u0dc0\u0dcf\u0dba \u0dba\u0dc1\u0dc0\u0dbd\u0dca \u0dd2\u0dba\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0dda\u0db1\u0dad\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0db4 \u0d91\u0da7 \u0d85\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dba\u0db8\u0dca \u0dba\u0dcf\u0d9a\u0dba\u0da7 \u0dba\u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0db3\u0d9a\u0dca\u0dad \u0dd2"

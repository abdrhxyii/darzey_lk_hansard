u0da7\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0daf\u0dca\u0daf\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0d9c\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 \u0dbd\u0d82\u0dc3\u0dab\u0da2\u0db4\u0daf\u0dca \u0dbd\u0d82\u0dd2\u0dc3\u0dc3\u0dab\u0da2 \u0dbd\u0d82 \u0da7\u0dd4\u0dad \u0dbd\u0d82 \u0dc5\u0dae \u0dbd\u0d82\u0da2\u0dd0\u0dc4\u0dd0 \u0dbd\u0d82\u0dd2\u0dbb\u0dba\u0da2\u0daf\u0db4; \u0dbd\u0d82\u0dba\u0db8\u0dca \u0dbd\u0d82\u0dba\u0db8\u0dca \u0dbd\u0d82\u0d9c\u0dca\u0db4\u0db4\u0dca \u0db8\u0dca \u0dbd\u0d82\u0d9c\u200d\u0dbb\u0db8\u0dd2 \u0dcf\u0db4 \u0dbd\u0d82\u0dc3\u0dd0\u0da2 \u0dbd\u0d82 \u0dcf\u0db4 \u0dbd\u0d82 \u0dba\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0dc4\u0dd0\u0db6\u0dd0\u0dd2 \u0dbd\u0d82020 \u0dbd\u0d82\u0d9c \u0dbb\u0dda\u0dbd\u0dca \u0dbd\u0d82\u0da2\u0db4\u0dcf\u0dba \u0dbd\u0d82\u0daf\u0da2 \u0dbd\u0dca \u0dbd\u0d82\u0dcf\u0da2\u0dca\u0da7 \u0dbd\u0d82\u0d9c\u0daf\u0db4\u0dc5 \u0dbd\u0d82 \u0db4\u0db4\u0dbd\u0dd3 \u0dbd\u0d82\u0dd4 \u0daf\u0dbd\u0dca \u0dbd\u0d82\u0d9a\u0db6\u0db4 \u0dbd\u0d82\u0dc3\u0dca\u0da2 \u0dbd\u0d82\u0d95\u0da2\u0dd1 \u0dbd\u0d82\u0dc0\u0dd4\u0dab\u0db4\u0da2 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dd4 \u0daf\u0dbd\u0dca \u0dbd\u0d82\u0d9a\u0db6\u0db4 \u0dbd\u0d82\u0dc3\u0dd0\u0db1\u0dd3 \u0db8\u0dca \u0dbd\u0d82\u0d9c\u0daf\u0dcf\u0dae\u0dcf\u0db4\u0daf \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dcf\u0dd0\u0dca\u0db4\u0dad\u0dca \u0dbb\u0dd4\u0daf\u0dca\u0da7 \u0dbd\u0d82\u0d9a\u0dd0\u0db6\u0dd4\u0dab\u0db4."

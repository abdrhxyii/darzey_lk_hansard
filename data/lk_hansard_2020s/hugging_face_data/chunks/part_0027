    "chunk_text": "\u0b95\u0b9f\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0baa\u0bbe\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bc1 \u0baa\u0bbe\u0bb5\u0bae\u0ba9\u0baf\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0bc6 \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bae\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baf\u0bb5\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd, \u0b85\u0bae\u0bcd\u0baa\u0bbe\u0bae\u0bb1 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u0baf\u0ba8\u0b95\u0bae\u0bbe\u0ba9 \u0baa\u0bbf\u0bb0\u0baf\u0ba4\u0bc6 \u0b9a\u0bc6\u0baf\u0bc8\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0b95, \u0b9a\u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0baf\u0ba4\u0bc6 \u0b9a\u0bc6\u0baf\u0bc8\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0ba8\u0bc2\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0ba9 \u0b9a\u0baa\u0bbe\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bc1 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0bb0\u0baf\u0ba4\u0bc6 \u0b9a\u0bc6\u0baf\u0bc8\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b9a\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b9a\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b86\u0ba4\u0bbe\u0bb0\u0bae\u0bbe\u0b95 \u0b95\u0b9f\u0bbf\u0ba4\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc1 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0baf\u0bae \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0b95\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0ba9\u0bcd\u0bb1\u0bc1\u0bb5\u0bae\u0bb0 \u0b85\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0b9a\u0baa\u0bbe\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bae\u0bae\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0b86\u0bb5\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bc8. \u0baa\u0bbf\u0bb0\u0baf\u0ba4\u0bc6 \u0b9a\u0bc6\u0baf\u0bc8\u0b95\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0b9a\u0bc6\u0ba9\u0bcd\u0bb1\u0bc1 \u0b9a\u0baa\u0bbe\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba4\u0bc1 \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0bb5\u0bbf\u0bc6\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baf\u0baa\u0bbe\u0ba4\u0bc1, \u0b87\u0ba8\u0bcd\u0ba4 \u0b89\u0bbe\u0bbf\u0bae\u0bae\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0b86\u0bb5\u0ba3\u0b99\u0bcd\u0b95\u0bae\u0bb3\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b9a\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0bb1\u0bcd\u0baf\u0baa\u0bbe\u0ba4\u0bc1 \u0bc6\u0b9f\u0bcd\u0b9f\u0b9a\u0bcd \u0bc6\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bbe\u0b95\u0ba4\u0bcd \u0b9a\u0ba4\u0bbe\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0ba4\u0bae\u0ba4\u0bc1 \u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba4\u0bcd\u0bae\u0ba4\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bae\u0bb3\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0b89\u0bbe\u0bbf\u0bae\u0bae\u0bc1\u0bae\u0bcd \u0b9a\u0baa\u0bb1 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0bae\u0bb2\u0bcd \u0ba4\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0b9a\u0baa\u0bbe\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b85\u0bb0\u0bc6\u0bbe\u0ba9\u0ba4\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4 \u0b89\u0bbe\u0bbf\u0bae\u0bae\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0b86\u0bb5\u0ba3\u0b99\u0bcd\u0b95\u0bae\u0bb3\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95 \u0b86\u0bb5\u0ba9 \u0baa\u0bc1\u0bbe\u0bbf\u0baf\u0bc1\u0bae\u0bbe? \u0b8e\u0ba9\u0b95\u0bcd \u0baf\u0b95\u0b9f\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0baf\u0bb1\u0ba9\u0bcd.\n\n\u0da7\u0dad\u0dca \u0dbd\u0d82\u0d9c\u0da2\u0db4\u0dcf\u0dba\u0db4\u0dcf \u0dba \u0dbd\u0d82\u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82\u0daf\u0dd0\u0da9 \u0dbd\u0d82 \u0da7\u0dd4\u0dad \u0dbd\u0d82\u0dd6 \u0daf\u0db4\u0da2\u0db8\u0dca \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0d89\u0dca\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0dc3\u0dbb\u0dd4 \u0dbd\u0d82\u0da2\u0dca\u0dd3 \u0da2\u0db1\u0dd2. \u0dbd\u0d82\u0d91 \u0dcf\u0dae \u0dbd\u0d82\u0dd6 \u0daf\u0db4\u0da2\u0db8\u0dca \u0dbd\u0d82 \u0dba\u0db4\u0dd4 \u0dbd\u0d82\u0d94\u0dda\u0db4\u0dd4 \u0dbd\u0d82\u0dcf\u0daf \u0dbd\u0d82\u0da7\u0dd2 \u0dbd\u0d82 \u0db4\u0d9a\u0dba\u0dca \u0dbd\u0d82\u0d87 \u0dc5\u0dcf \u0dbd\u0d82\u0dcf\u0da2\u0dc4\u0dba \u0dbd\u0d82\u0daf\u0dd2\u0dcf\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dca \u0daf\u0d9a\u0da7 \u0dbd\u0d82 \u0db6\u0daf\u0db4 \u0dbd\u0d82 \u0da2\u0da2\u0da7\u0dad\u0dca \u0dbd\u0d82\u0d9c\u0db4\u0da7 \u0dbd\u0d82\u0db4\u0dd4\u0dc5\u0dd4\u0daf\u0dca \u0da2 \u0dbd\u0d82\u0d9a\u0dd0 \u0db6\u0dd2.\n\n\u0d92 \u0dbd\u0d82\u0d9c\u0db1\u0dd4\u0daf \u0dbd\u0d82\"\u0d8b\u0dbb\u0dd4\u0da2\u0dba\" \u0dbd\u0d82\u0daf\u0dd0\u0da9\u0dcf\u0da7\u0dc4\u0da2 \u0dbd\u0d82\u0d89\u0dcf\u0db4 \u0dbd\u0d82\u0dcf\u0db4\u0dbb\u0dca\u0dbd\u0dcf \u0daf \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db4\u0dad\u0dca\u0da2 \u0dbd\u0d82 \u0daf\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0d87\u0dad\u0dd2 \u0dbd\u0d82 \u0daf\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2 \u0dbd\u0d82\u0dc3\u0dd0\u0da7\u0dbd\u0dd4 \u0dbd\u0d82\u0db1\u0dd2\u0dba\u0db4 \u0dba\u0dab\u0dba \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dc3\u0db1\u0dd2\u0db8\u0dd2\u0dca \u0dbd\u0d82 \u0dc3\u0daf\u0dad\u0dca \u0dbd\u0d82\u0daf\u0dd0\u0da9 \u0dbd\u0d82\u0dd2\u0dc5\u0dd2\u0db6 \u0daf\u0dc5\u0dca \u0dbd\u0d82\u0d94\u0dcf\u0dae \u0dcf\u0dae \u0dbd\u0d82\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82\u0d94\u0dda\u0db4\u0dd4 \u0dbd\u0d82 \u0db6\u0daf\u0db4 \u0da2 \u0db8\u0dca \u0dbd\u0d82 \u0da7\u0dd4\u0dad \u0dbd\u0d82 \u0dba\u0dca\u0da2 \u0dbd\u0d82\u0dd6 \u0daf\u0db4\u0da2\u0db8\u0dca \u0dbd\u0d82 \u0daf\u0d9a\u0db4 \u0dbd\u0d82\u0dd2\u0db1\u0da7\u0dd2\u0da2\u0daf\u0db4. \u0dbd\u0d82\n\n\u0dcf\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0db8\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dd4\u0dad\u0db4\u0dca\u0db4\u0db4\u0dcf\u0da9\u0dd4\n\n\u0ba4\u0baa\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd: \u0b9a\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd\n\nDEPARTMENT OF POSTS: VACANCIES\n\n1681/2025\n\n3. \u0dbb\u0dd4 \u0daf\u0dda\u0dad\u0dcf\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dbb\u0dd6\u0dc6\u0dad \u0db8\u0dc4\u0dcf\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b87\u0bae\u0bcd\u0bb0\u0bbe\u0ba9\u0bcd \u0bae\u0bb9\u0bcd\u0bb0\u0bc2\u0baa\u0bcd) (The Hon. Imran Maharoof) \u0dcf\u0dde\u0d9b\u0dca\u200d\u0dba \u0dbd\u0d82\u0dcf\u0dc4 \u0dbd\u0d82\u0da2\u0dcf\u0da2\u0da2\u0db4\u0db0\u0dba \u0dbd\u0d82\u0d9c\u0da2\u0db4\u0dcf\u0dba \u0da2\u0db4 \u0dc3\u0dca \u0dbd\u0d82\u0d87\u0dd6 \u0dbd\u0d82\u200d\u0dbb \u0dae\u0da2\u0dba- \u0dbd\u0d82(5):\n\n(\u0d9c) (i) \u0dcf\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0dbd\u0d82 \u0daf\u0db4\u0db4\u0dbb\u0dca\u0dbd\u0dcf \u0db8\u0dca\u0dca \u0daf \u0dbd\u0d82\u0dd2\u0dc5\u0dc4\u0dd2\u0da7\u0dd4\u0daf\u0da2 \u0dbd\u0d82\u0d9a\u0daf \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0dbd\u0d82 \u0daf \u0dbb\u0dca\u0dbd\u0daf;\n\n(ii) \u0db8\u0dca \u0dbd\u0d82\u0daf\u0da2\u0dd2\u0dc3\u0da7 \u0dbd\u0d82 \u0da2\u0dba\u0da7 \u0dbd\u0d82\u0dd2\u0dc5\u0dc4\u0dd2\u0da7\u0dd2 \u0dbd\u0d82\u200d\u0dbb\u0db0\u0db4\u0da2 \u0dbd\u0d82\u0dc4\u0db4 \u0dbd\u0d82\u0d8b\u0db4 \u0dbd\u0d82\u0dcf\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0dbd\u0d82 \u0db4\u0dbb\u0dca\u0dbd\u0dba\u0db4\u0d9a \u0dbd\u0d82\u0dcf\u0dcf\u0d9b\u0dca\u200d\u0dba\u0db4\u0daf \u0dbd\u0d82 \u0daf\u0dca \u0dbd\u0d82 \u0daf\u0dca \u0dbd\u0d82\u0daf \u0dba\u0dca \u0dbd\u0d82 \u0db4\u0db4\u0da2\u0dab\u0daf; \u0dbd\u0d82\n\n(iii) \u0db8\u0dca \u0dbd\u0d82\u0daf\u0da2\u0dd2\u0dc3\u0da7 \u0dbd\u0d82\u0dcf\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0dbd\u0d82 \u0daf\u0db4\u0db4\u0dbb\u0dca\u0dbd\u0dcf \u0db8\u0dca\u0dca \u0dbd\u0d82 \u0dcf\u0dae\u0daf\u0dba \u0dbd\u0d82 \u0dba\u0da2 \u0dbd\u0d82 \u0dcf\u0dae\u0daf \u0dba\u0dca \u0dbd\u0d82\u0dcf\u0dcf\u0d9b\u0dca\u200d\u0dba\u0db4\u0daf \u0dbd\u0d82 \u0db4\u0db4\u0da2\u0dab\u0daf;\n\n(iv) \u0d91\u0da2 \u0dbd\u0d82 \u0daf\u0db4\u0db4\u0dbb\u0dca\u0dbd\u0dcf \u0db8\u0dca\u0dca \u0dbd\u0d82 \u0db8\u0dca \u0dbd\u0d82\u0daf\u0da2\u0dd2\u0dc3\u0da7 \u0dbd\u0d82\u0db4\u0daf\u0dad\u0dd2\u0da2 \u0dbd\u0d82\u0db4\u0dd4\u0dba\u0dda\u0db4\u0db4\u0dca \u0dbd\u0d82\u0dcf\u0dcf\u0d9b\u0dca\u200d\u0dba\u0db4\u0daf \u0dbd\u0d82 \u0db4\u0db4\u0da2\u0dab\u0daf;\n\n(v) \u0d91\u0da2 \u0dbd\u0d82\u0db4\u0dd4\u0dba\u0dda\u0db4\u0db4\u0dca \u0dbd\u0d82\u0dd2\u0dc5\u0dba\u0dd3\u0da2 \u0dbd\u0d82\u0dcf \u0dc4\u0db4 \u0dbd\u0d82 \u0dc3\u0da2 \u0dbd\u0d82\u0d87\u0dad\u0dd2 \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db4\u0da2\u0db4\u0dbb\u0dca\u0dbd\u0dc3 \u0dbd\u0d82 \u0daf \u0dbb\u0dca\u0dbd\u0daf;\n\n\u0dba\u0dca\u0da2 \u0dbd\u0d82\u0d91 \u0da2\u0db4 \u0dbd\u0d82 \u0da2\u0da2 \u0dbd\u0d82\u0dcf\u0dcf\u0db4\u0daf\u0da7 \u0dbd\u0d82\u0daf\u0dca\u0daf\u0dca \u0da2\u0dc4\u0dd2\u0daf?"
  },

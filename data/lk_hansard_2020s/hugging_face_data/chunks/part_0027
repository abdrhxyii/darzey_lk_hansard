    "chunk_text": "\u0daf\u0dd4\u0dc1\u0dc3\u0dcf\u0dc2 \u0d9a\u0dca\u0dbb\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd0 \u0dd0\u0dad\u0dd2\u0dba\u0dd2. 1974 \u0db8\u0dda\u0d9a 2 \u0dcf\u0dbb\u0db1 \u0dca\u200d\u0dca\u0dad\u0dd2\u0d9a \u0dca\u200d\u0dbd \u0db8\u0dca\u0db4\u0dca\u0dcf\u0db1 \u0dc0\u0dca \u0dca\u200d\u0dbd\u0dca\u0db4\u0dc0\u0dc0\u0db1 \u0dab\u0dca\u0da9\u0dcf \u0dbd \u0db4\u0db1\u0dc1\u0db8\u0d9a \u0d89\u0dda\u0dca \u0db4\u0dd0\u0dc0\u0dd0\u0daf\u0dd2 \u0dc3\u0dc0 \u0db1\u0dd3\u0dad\u0dd2 \u0dba\u0dcf\u0dad \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dca\u0dcf\u0db1\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0dd0\u0db1 \u0db3\u0dc0\u0db1\u0dca\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca. \u0dca\u200d\u0db1\u0dda\u0dca\u0dc0\u0dca\u0daf\u0dd3 \u0dbb\u0dca\u200d\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0daf\u0dd4\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7 \u0db8\u0db4\u0dd2 \u0dcf\u0db1\u0dca\u0db1\u0dc0\u0dca, \u0dc1 \u0dc1\u0dda\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0d86\u0dab\u0dca\u0dd4 \u0d9a\u0dca\u0dbd\u0dc0\u0dbd, \u0d92 \u0dc1 \u0dca\u0da9\u0dcf \u0d9a\u0dca\u0d9a\u0dba \u0dda\u0dd0\u0db1\u0dca\u0dc0\u0dbd\u0daf\u0dd3 \u0dc1 \u0dc3\u0db4\u0dca\u0dbd\u0db1 \u0db8\u0db0\u0dd2\u0d9a\u0dca\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0da7 \u0db8\u0dc3\u0dd3\u0db8\u0dd2\u0dda \u0db6\u0dbd\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dca \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca. \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dc1\u0db8\u0d9a \u0db3\u0dc0\u0db1\u0dca\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca, \" \u0dab\u0dca\u0da9\u0dcf \u0dbd\u0dc1\u0dc3 \u0db6\u0dbd\u0dda\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a \u0dbb\u0dd3\u0db8 \u0dc1\u0db8\u0dca\u0daf\u0dd3 \u0dba\u0dcf\u0dad\u0db8\u0dca \u0d86\u0dbb\u0dc0\u0dd4\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dd0\u0db1 \u0db1\u0d9f\u0dd2\u0db1 \u0db8\u0dc0 \u0dcf\u0db1\u0dca\u0dc1\u0dda \u0daf\u0dd3 \u0db8 \u0dca\u0dda\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dad\u0dca \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0dd0\u0db1\u0dd3 \u0da7 \u0dc1\u0db4\u0dbb \u0dc1\u0dcf\u0db4\u0dca\u0dad\u0db8\u0dc3\u0dcf\u0dc0\u0dba\u0dcf\u0dad\u0da7 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0db8\u0d9a \u0dbb\u0dd3\u0db8 \u0db3\u0dc0\u0dca \u0db8\u0dc0 \u0dcf\u0db1\u0dca\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0dbd\u0db6\u0dca \u0daf\u0dd3 \u0da7 \u0daf\u0dd4\u0db0\u0dd2\u0daf\u0dd4\u0db0\u0dca\u0db1 \u0dbd \u0dba\u0dd2\" \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca. \u0d92\u0d9a \u0d89\u0dda\u0dca \u0dc0\u0dd0\u0dcf \u0db8\u0d9a \u0dc1\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba. \u0db8 \u0dca\u0dda\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dad\u0dca \u0daf\u0dd4\u0dc1\u0dc3\u0dcf\u0dc2 \u0db6\u0dbd\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0dbd\u0db6\u0dca \u0db1\u0dca\u0db1\u0dc0\u0dca \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7, \u0d92\u0d9a \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dbb\u0dbd\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca. \u0d92 \u0dc0\u0dca\u0dc1 \u0dc1\u0db6\u0dca\u0dc1\u0dc0\u0dca \u0dc3\u0dd4\u0db6\u0dc0\u0dca\u0daf\u0dd3 \u0d9a\u0dca\u0dbb\u0dab\u0dca \u0dc1 \u0dca\u0da9\u0dcf \u0dca\u0d9a\u0dca\u0d9a\u0dba \u0dc1\u0db8\u0dca\u0dc1\u0d9a\u0db1\u0dca \u0dd2\u0dc0\u0dbd\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0dca \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca \u0dc4\u0dd2\u0dda\u0db1\u0dc0\u0dca.\n\n2033 2034\n\n\u0db4\u0dca\u0dad\u0db8 \u0dc3\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0"

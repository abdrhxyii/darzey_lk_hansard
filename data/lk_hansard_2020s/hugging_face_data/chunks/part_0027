    "chunk_text": "\u0d9c\u0dbb\u0dd4\u0dc3 \u0dcf\u0daf \u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dd2,\u0dc3\u0dc0\u0dd2\u0dda\u0dc1\u0dae\u0dc2\u0dda\u0d9a\u0dca\u0dcf\u0dc3\u0dcf\u0dcf\u0dc3\u0d9a\u0dd2\u0d9a\u0dca \u0dc3 \u0dd0\u0dcf\u0dd0\u0dd2\u0dbb\u0dba\u0dd2,\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0d91\u0dbd\u0dca\u0dc3\u0db1\u0dd2\u0dda \u0ddd-\u0dbd\u0daf\u0dc3\u0db1\u0dd2 \u0daf\u0dc3\u0dca\u200d\u0dbb\u0dc1\u0dae \u0d9a\u0dc3\u0dca\u0dcf\u0d9f\u0dc3ENSO, \u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3IOD \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc3\u0dcf\u0dc3\u0dad\u0dd2\u0dbb\u0dc3\u0dc0\u0dca\u200d \u0dc3\u0db6\u0dc0\u0dca\u200d.\u0dc3\u0d91 \u0da7\u0dc3\u0d9a\u0dd2\u0d9a \u0dc0\u0dca\u200d\u0daf,\u0dc3El Ni\u00f1o-Southern Oscillation \u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\u0dc3\u0d92\u0dc3\u0d9a\u0dd2\u0d9a\u0dca\u0dda\u0dca,\u0dc3\u0d91\u0dbd\u0dca\u0dc3\u0db1\u0dd2\u0dda \u0ddd\u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dab\u0dc3\u0dda\u0dcf\u0ddd\u0dbd \u0d9a.\u0dc3\u0dad\u0db1\u0dd2\u0d9a\u0dca\u0dc2\u0dc3\u0d91 \u0da7\u0dc3\u0d9a\u0dd2\u0d9a \u0dc0\u0dca\u200d\u0daf,\u0dc3Indian Ocean Dipole \u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\u0dc3\u0d92\u0dc3\u0d9a\u0dd2\u0d9a\u0dca\u0dda\u0dca,\u0dc3\u0d89\u0dca\u0daf\u0dd2\u0d9a\u0dca\u0dc3\u0dca\u0daf\u0d9c \u0dda\u0dda\u0dc3\u0db4\u0dc0\u0dca\u200d\u0dd2\u0dbb \u0dc3\u0d8b\u0dc2\u0dae\u0dab\u0dad\u0dca\u0dc0\u0dca\u200d\u0dda\u0dda\u0dc3\u0dda\u0dc0\u0dca\u200d \u0dca.\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0dca\u0d82\u0d9a\u0dd3\u0d9a\u0dab\u0dc3 \u0dbb\u0dd4\u0dab\u0dd4\u0dc3\u0db4\u0dd2\u0dd2\u0db6\u0db6\u0dc4\u0dc0\u0dca\u200d\u0dc3\u0dad\u0dad\u0dca\u0dad\u0dc0\u0dca\u200d\u0dc1\u0dda\u0d9a\u0dca\u0dcf\u0dc3 \u0dda\u0da8\u0dcf\u0dc3\u0da2 \u0dad\u0daf\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc3\u0dd3\u0da7\u0da7\u0dc3\u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2\u0d9a\u0dc3\u0dcf\u0dd0\u0db1\u0dd4\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc3\u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0db8\u0dca\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dc1\u0dba\u0dad\u0daf\u0dc0\u0dca\u200d\u0dd4\u0dad\u0dca\u0dc3\u0dd2\u0dbb"

b8 \u0db1\u0dd2\u0dba\u0dd2. \u0dd4 \u0db1\u0dcf\u0db8\u0dbd\u0dca \u0d9a\u0dd4 \u0dab\u0dcf\u0dbb\u0dca \u0db1 \u0db8\u0dad\u0dad\u0dcf (\u0bc8\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba8\u0bbe\u0bc8\u0bb2\u0bcd \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9) (The Hon. Namal Karunaratne) \u0dd0\u0dc0 \u0db8 \u0dca\u0dd3\u0dd4\u0db8 \u0dd2\u0dba \u0d94\u0dcf\u0dd4\u0db8 \u0dcf \u0dc0\u0db1\u0dd9\u0dd0\u0dca \u0dbb\u0db0\u0dae\u0db1 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0db8 \u0dd4 \u0dd9\u0daf \u0dae. \u0d91\u0daf\u0dcf\u0db8 \u0dd0\u0db1\u0db4\u0dbd\u0dd4 \u0dbb\u0db8 \u0dcf \u0da7 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dd2\u0dba\u0daf\u0dcf\u0db1\u0dc0\u0dcf . \u0d85\u0db4\u0dd2 \u0d91\u0db8 \u0dd0\u0db1\u0db4\u0dbd\u0dd4 \u0dcf\u0db3\u0dd4\u0db1\u0dcf \u0daf\u0dd0\u0db1 \u0dd2\u0dba\n\n\u0daf\u0dcf\u0db1\u0dc0\u0dcf . \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dcf \u0db4 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dc0 \u0dca\u0db1 \u0dd2\u0dba\u0dca \u0dd2\u0dba\u0daf\u0dcf\u0db1\u0dc0\u0dcf . \u0d8a\u0daf\u0dda \u0dd9\u0dc0\u0daf\u0dca\u0dca \u0d85\u0daf\u0dda \u0db6\u0dcf \u0dbd\u0dca \u0dd9\u0dcf \u0dca\u0dad \u0d87\u0db8 \u0dd2\u0dba\u0dd4\u0db8 \u0dcf \u0daf\u0dda \u0db8\u0dd6\u0dbd\u0dd2\u0dd9\u0dca\u0dc0\u0daf \u0dca \u0dcf \u0dd9\u0da0\u0dca\u0da1\u0dcf \u0dc0\u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dd2\u0dba\u0db6\u0dd4\u0da7\u0dcf . \u0d92\u0dd9 \u0db1\u0db1\u0dc0\u0db1\u0dca\u0dab\u0dcf\u0daf\u0dab\u0dca\u0da9 \u0dc0\u0dd2\u0dc2\u0dca\u0da8 \u0db1 \u0db4 \u0d85\u0dd9\u0dcf \u0dc0. \u0d91\u0dad\u0db1\u0db1\u0daf\u0dd3\u0dca \u0dd0\u0db1\u0db4\u0dbd\u0dd4 \u0dc0\u0dd2\u0db0\u0dcf \u0db6 \u0dbb\u0db8 \u0dcf \u0da7 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0db8 \u0dd4 \u0dab\u0dcf\u0da7\u0dcf ."

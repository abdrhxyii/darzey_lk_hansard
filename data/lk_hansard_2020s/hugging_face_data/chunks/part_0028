\u0d9c\u0dd4 \u0dc0\u0dbb\u0ddd\u0dc4\u0dab \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba9\u0bc6\u0bc6\u0bbe\u0bb9\u0ba3 \u0baa\u0ba3\u0bcd\u0b9f\u0bc6\u0bbe\u0bc6) (The Hon. Rohana Bandara) \u0d9c\u0dad\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, \u0db8\u0dcf \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba \u0d85\u0dc4\u0db1\u0dc0\u0dcf\u0db4 \u0d9c\u0dd4 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0dc4\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0dd9\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bc6\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0bb9\u0bc6\u0bbe\u0bbf\u0ba9\u0bbf \u0b85\u0bc8\u0bc6\u0b9a\u0bc2\u0bc6\u0bbe\u0bbf\u0baf) (The Hon. (Dr.) Harini Amarasuriya) \u0d9c\u0dad\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dbb \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0db8 \u0db8\u0dcf\u0dc3\u0dba\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca\u0dad \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf\u0db4\n\n\u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dd9\u0dd4\u0dbb \u0daf\u0dd2\u0db1\u0d9a\u0daf\u0dd3 \u0dc0\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9 \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0d9c \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3. \u0bc6\u0bbf\u0ba9\u0bc6\u0bbe\u0bae\u0bc6 \u0bc8\u0bb1\u0bcd\u0ba4\u0bb1\u0bc6\u0bbe\u0bb0\u0bc1 \u0ba4\u0bbf\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd \u0bc6\u0bc8\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. Question ordered to stand down. \u0dd9\u0db0\u0dcf\u0dba\u0dd9 \u0dc3 \u0dc3\u0db1\u0d9a\u0dd8\u0dd2\u0dc0\u0d9a \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd: 201 \u0dc3\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a\n\n\u0d86\u0daf\u0dcf\u0dba\u0dd9 \u0dc3\u0dc4 \u0dc0\u0dd2\u0dba\u0daf\u0dd9 \u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0b95\u0bb2\u0bc6\u0bbe\u0bc6\u0bc6\u0bbe\u0bc6 \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0bae\u0bcd: 2015 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\n\n\u0bc6\u0bb0\u0bc1\u0bc8\u0bc6\u0bbe\u0ba9\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc6\u0bb2\u0bc6\u0bbf\u0ba9\u0bae\u0bc1\u0bae\u0bcd CENTRAL CULTURAL FUND: ANNUAL INCOME AND\n\nEXPENDITURE FROM 2015\n\n987/2025 5. \u0d9c\u0dd4 \u0d9a\u0dd2 \u0dc3\u0db1 \u0dc0\u0db1\u0dbd\u0dca\u0dc3\u0db1\u0dca \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b95\u0bbf\u0b99\u0bcd\u0bb8\u0bcd \u0ba4\u0ba8\u0bb2\u0bcd\u0bc6\u0ba9\u0bcd) (The Hon. Kins Nelson)\n\n\u0dc1\u0db0\u0dba\u0dcf\u0dc3\u0db1, \u0dc4\u0d9c\u0dad\u0db8\u0dd2\u0d9a \u0dc3\u0dc4 \u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0dbb\u0db8\u0dcf\u0dba\u0d9c\u0dad\u0dda \u0d87\u0dd6 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba - (1):\n\n(\u0d85) (i) 2015 \u0dc0 \u0dc2\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0dba\u0db8\u0dca \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0db8\u0db0\u0dba\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dd2\u0d9a \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd \u0dc0\u0dcf \u0dc2\u0dd2\u0d9a\u0dc0 \u0d8b\u0db4\u0dba\u0dcf \u0d87\u0dd2 \u0dc4\u0daf\u0dcf\u0dba\u0db8 \u0dc3\u0dc4 \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dbb \u0d87\u0dd2 \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0d91\u0d9a\u0dca\u0dad \u0d91\u0d9a\u0dca\u0dad \u0dc0 \u0dc2\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dba\u0dc0\u0dda \u0dba\u0dc0\u0dda \u0dc0\u0dba\u0dba\u0dba\u0dda \u0dba\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0daf;\n\n(ii) \u0d91\u0db8 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd \u0db8\u0d9f\u0dd2\u0dda \u0db4\u0dd4\u0dbb\u0dcf\u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4\u0dbb \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dad\u0dc2\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0dba\u0dc0\u0db1\u0dd4\u0dba\u0dc0\u0dda \u0da2\u0dcf\u0dd2\u0d9a \u0d8b\u0dbb\u0dd4\u0db8\u0dba\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0dba\u0dba\u0da7 \u0dba\u0d9c\u0dad\u0dc0\u0dd3\u0db8\u0da7 \u0d87\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dba\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0daf;\n\n(iii) \u0d91\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dba\u0d9c\u0dad\u0dc0\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf \u0dc0\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0db4\u0dcf\u0db1 \u0dbd\u0daf \u0dba\u0dc4\u0dca\u0dad\u0dd4\u0dbb \u0d9a\u0dc0\u0dba \u0daf;\n\n(iv) \u0d91\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9a\u0dd2\u0db1\u0db8\u0dd2\u0dda \u0dba\u0d9c\u0dad\u0dc0\u0dd3\u0db8\u0da7 \u0d9c\u0dad\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf \u0d9c\u0dad \u0d9a\u0dc0\u0dba \u0daf;\n\n\u0dba\u0dda\u0db1 \u0d91\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0dba\u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0daf\u0dda\u0dc0\u0dda\u0dba\u0dda\u0daf?\n\n(\u0dc4) \u0dba\u0db1\u0dcf\u0d91\u0dba\u0dc3\u0dca \u0db1\u0db8\u0dca, \u0d92 \u0db8\u0dda\u0daf?\n\n\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bc6\u0bc6\u0bbe\u0bc6\u0ba9, \u0bc6\u0bc8\u0baf \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bc6\u0bbe\u0bc6\u0bc6\u0bbe\u0bc6 \u0b85\u0bb2\u0bc1\u0bc6\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bc6\u0bae\u0bc6\u0b95\u0bcd \u0ba9\u0b95\u0b9f\u0bcd\u0b9f \u0bc6\u0bbf\u0ba9\u0bc6\u0bbe:"

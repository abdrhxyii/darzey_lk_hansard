0dd2\u0d9a\u0db1 \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0dba \u0db4\u0dca\u200d\u0dbb\u0dd3\u0da7\u0dad\u0dca\u0dc0\u0db1 \u0d85\u0dc0\u0dc1\u0dba \u0dc0\u0dd6 \u0d85\u0dc0\u0d9a\u0dda\u0dae\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0d91\u0dc0 \u0dd2\u0dba \u0db1 \u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0db1\u0dcf\u0dd3\u0dc3\u0dd2\u0d9c\u0dda \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0dd2\u0d9a\u0db1 \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0dba \u0d92\u0d9a\u0d9a\u0db1\u0db4 (CID \u0d87\u0dad\u0dd4\u0dc5\u0dd4) \u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0d85\u0db1\u0dbb\u0dcf\u0db0\u0dca\u200d \u0db1\u0dbb\u0dd3 \u0dc2\u0dca\u0da8\u0da7 \u0d9a\u0dcf\u0dbb\u0dca\u0db1\u0dcf\u0d82\u0dc1\u0db1 (\u0db8\u0dd2\u0dd2\u0dba\u0d9a\u0dda \u0db6\u0dbd\u0db1\u0dd1\u0dca \u0dc4\u0dcf \u0da2\u0dcf\u0dc0\u0dcf\u0dbb\u0dca \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0dba \u0d9a\u0dc4 \u0d9a\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0d85\u0db1\u0dbb\u0dcf\u0db0\u0dca\u200d \u0db1 \u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0d92\u0d9a\u0d9a) \u0db8\u0dd6\u0dbd\u0dba \u0d9a\u0dc4 \u0d9c\u0dc0\u0d9c\u0dc5\u0db3 \u0d85\u0db1\u0dbb\u0dcf\u0db0\u0dca\u200d \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0dba \u0d85\u0d82\u0dc1\u0db1 \u0d9c\u0dc4 \u0d9c\u0dc0\u0dba\u0dad\u0dca \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0dd2\u0d9a\u0db1 \u0d92\u0d9a\u0d9a \u0d9c\u0dc0\u0db1 \u0d9c\u0db1\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd \u0d9c\u0dda.\n\n\u0dc0\u0dd2\u0d9c\u0daf\u0dca\u0dc1 \u0dbb\u0dd0\u0d9a\u0dd2\u0db1\u0dcf \u0dba\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0db1 \u0dc0\u0d82\u0da0\u0dcf \u0d9a\u0dca\u0db6\u0dca\u0db0\u0dca\u200d\u0d9c\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dd2\u0d9c\u0daf\u0dca\u0dc1 \u0d9c\u0d9a\u0dda\u0dc0\u0dcf \u0dd2\u0dba\u0dba\u0dd4 \u0dad\u0dd2\u0d9a \u0d9a\u0dcf\u0dbb\u0dca\u0db1\u0dcf\u0d82\u0dc1\u0db1 \u0daf, \u0dc0\u0d82\u0da0\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3 \u0dbb\u0dd0\u0d9a\u0dd2\u0db1\u0dcf \u0dd2\u0dba \u0d9c\u0db1 \u0da2\u0dd2\u0db1 \u0dba\u0db1\u0db1\u0dba \u0d9a\u0dc4 \u0d9c\u0dc0\u0dba\u0dad\u0dca \u0dc0\u0dd2\u0d9c\u0daf\u0dca\u0dc1 \u0dbb\u0dd0\u0d9a\u0dd2\u0db1\u0dcf \u0d9c\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dda \u0db1\u0dd3\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dbb \u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0d9a\u0dcf\u0dbb\u0d9a\u0dca \u0dba\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0db1 \u0db1 \u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0dbd\u0db6\u0dcf\u0d9c\u0dad\u0dd2\u0dba\u0db8\u0dd2\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dbb \u0db0\u0dd3 \u0db6\u0db3\u0dc0\u0dcf\u0d9c\u0dad \u0db1\u0dd3\u0dca \u0dba\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0db1 \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0db8\u0dd2\u0dca \u0d9a \u0dbd\u0d9a\u0dd2\u0db1 \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dbb\u0dca\u0db1\u0db7\u0dcf\u0dbb\u0db1 \u0d89\u0dd4\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dc0\u0dcf. \u0d9c\u0db1\u0dcf\u0dd2\u0d9a\u0dda \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0dba \u0d85\u0dc0\u0dc1\u0dba \u0d85\u0dc0\u0d9a\u0dda\u0dae\u0dcf\u0dc0\u0dca\u0dc4\u0dd2\u0daf\u0dd3 \u0d91\u0db1 \u0d9a\u0dca\u0db6\u0dca\u0db0\u0dd3\u0d9a\u0dbb\u0da7\u0db1 \u0d9a\u0dbb \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0db1\u0dcf\u0dd3\u0dc3\u0dd2\u0db1 \u0d9c\u0dc0\u0db1 \u0d85\u0daf\u0dcf\u0dc5 \u0d85\u0db1\u0dbb\u0dcf\u0db0\u0dca\u200d \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0dba \u0d9a\u0dc4 \u0db1\u0dd3\u0dad\u0dd2\u0d9a\u0db8\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dad \u0d9a\u0db3\u0dc4\u0dcf \u0d9c\u0db1\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0dba\u0dc0\u0dcf.\n\n\u0dbd\u0dbd\u0daf\u0dcf\u0dba\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dad\u0db1 \u0d9c\u0dad \u0db1\u0dd3\u0db8\u0d9a\u0dd2\u0dca \u0d9c\u0db1\u0dcf\u0dbb\u0dc0 \u0dc0\u0dd2\u0dca\u0dbb\u0dd2\u0db1\u0db1\u0dca \u0d91 \u0dba\u
    "chunk_text": "\u0d9c\u0dca\u0d9a, \u0d9c\u0daf\u0dca\u0dc1\u0db1\u0dcf\u0dbd\u0dba \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0 \u0db8\u0dd2\u0d9a experts\u0dbd\u0dcf\u0d9c\u0dda \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0 \u0d9c\u0dba\u0dcf\u0d9c\u0dc0\u0dba\u0dd2. \u0d92\u0d9a \u0d9c\u0daf\u0dca\u0dc1\u0db1\u0dcf\u0dbd\u0dba \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0 \u0dc4 \u0dd2\u0dad\u0db1\u0db4 \u0db1\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0dbd\u0d9a\u0dca\u0d9c\u0dca. \u0dc4 \u0db6 \u0dba\u0dd2, \u0d92\u0d9a\u0db4 \u0d9c\u0dad \u0dc5\u0d9c\u0db1\u0dba experts\u0dbd\u0dcf \u0db1\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dc5\u0dcf. \u0d91\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0d85\u0dd2\u0dba\u0dbd\u0dca \u0da2\u0dcf\u0dc3\u0dd2\u0d82\u0dc4 \u0db8 \u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dcf \u0dc4\u0dd2\u0dd2\u0dad\u0d9c\u0dda \u0d9c\u0d9a\u0dde\u0d9b\u0dca\u200d\u0dba \u0d85\u0db8\u0dcf\u0db1\u0dba\u0dcf\u0d82\u0dc1\u0d9c\u0dda, \u0d9c\u0d9a\u0dde\u0d9b\u0dca\u200d\u0dba \u0d9c\u0d9a\u0dda\u0dc0\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba \u0dc2\u0dca\u0da8 \u0da2\u0dba\u0dbb\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dbb\u0db1\u0db4. \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dd2\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0d9c\u0dc5\u0dda, \u0d85\u0dbb experts\u0dbd\u0dcf \u0d9a\u0dd2\u0db1\u0dcf \u0d9c\u0dad\u0dad\u0dca \u0d9a\u0dda\u0da9\u0dcf\u0db1\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0d89\u0dbb\u0dd2\u0dbb\u0dd2\u0db1\u0dad\u0dca \u0d9a\u0dc5 \u0dad\u0dd3\u0dbb\u0da7. \u0d92 \u0dd2\u0dba\u0d9a\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0db4 \u0d9a\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb\u0da7\u0db1 \u0d89\u0dc2\u0dca\u0da8\u0dda\u0db4 \u0dc0\u0dd2\u0db1 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dcf\u0d9a\u0db1 \u0d85\u0dc0\u0d9a\u0dcf\u0dba \u0d9c\u0dda\u0daf\u0dd3 \u0db1\u0db8\u0dba\u0dd2 \u0d92 \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0 \u0d9c\u0dad\u0dad\u0dca\u0d9c\u0dad\u0dca. 2020 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dcf\u0d9a\u0db1 \u0d85\u0dca\u0dad\u0dd2\u0d9a\u0db8 \u0d9c\u0dc0\u0dba\u0d9c\u0d9a\u0dcf\u0db4 \u0db1\u0dcf\u0dbb\u0dca\u0dd2\u0d9c\u0dca\u0dca\u0dad\u0dd4 \u0db8 \u0dad\u0dd2\u0d9a\u0dc0\u0dbb\u0da7\u0db1 \u0d9a \u0db3\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0d9c\u0dda. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda \u0db8 \u0d85\u0db4\u0dd2 nominations \u0db7\u0dcf\u0dbb \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0da7\u0dcf. \u0dc4 \u0db6 \u0dba\u0dd2 \u0d92\u0d9a \u0d9a\u0dbd\u0dca \u0d9c\u0dd2\u0db1\u0dcf. \u0db1\u0dcf\u0d9a\u0dda\u0d9a\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0db1\u0db4 \u0db8\u0dd4\u0d9a\u0dda\u0dd2\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0d9a\u0db1\u0dca \u0d9a\u0dca\u0db6\u0dca\u0db0\u0dca\u200d \u0d9c\u0dc0\u0da0\u0dca\u0da0 \u0dd2\u0dba\u0d9a\u0dcf \u0d9c\u0db1\u0dcf\u0daf\u0dd4\u0da2\u0dba \u0d9c\u0db1\u0dbb\u0db8\u0dd4\u0da7 \u0da2\u0dba\u0dcf\u0d9a\u0dbb\u0db1\u0dad\u0dd2\u0d9a\u0dc0\u0dbb\u0da7\u0d9c\u0dda\u0daf\u0dd3 \u0d92 \u0db8\u0dd4\u0d9a\u0dda\u0dd2\u0dca \u0dc0\u0dd2\u0d9c\u0dbb \u0db0\u0dca\u200d\u0db1 \u0dbb\u0dd2\u0d9c\u0dad\u0db4\u0db8 \u0db7\u0dcf\u0dc0\u0dd2\u0db1 \u0d9a\u0dc5\u0dcf. \u0d91\u0db1 \u0dba\u0daf\u0dd3 \u0db8\u0dcf\u0db1\u0dad\u0d9a\u0dcf\u0dc0 \u0d9a\u0dbb \u0d9c\u0dad\u0dad\u0dca\u0d9c\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a\u0d9a \u0dba\u0dbb \u0dc2\u0dca\u0da8\u0dcf\u0dc0 \u0d9a\u0dd2\u0db1\u0dba \u0d91\u0d9a. \u0dba\u0db8\u0dd4\u0dad\u0dca \u0d9c\u0dca \u0d85\u0db1 \u0db1\u0dcf\u0dbb\u0dca\u0dd2\u0d9c\u0dca\u0dca\u0dad\u0dd4 \u0db8 \u0dad\u0dd2\u0d9a\u0dc0\u0dbb\u0da7\u0db1 \u0da2\u0db1\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0da7\u0db1 \u0d9a\u0dbb\u0dca\u0dba \u0db8\u0dd4\u0d9a\u0dda\u0dd2\u0dca \u0dc0\u0dd2\u0d9c\u0dbb \u0db0\u0dca\u200d\u0db1 \u0dc0\u0dcf\u0d9c\u0dda \u0da2\u0dba\u0db1\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0d87\u0dad\u0dd2\u0d9a \u0d9c\u0dc0\u0da0\u0dca\u0da0 \u0db1\u0dca\u0d9a\u0dd2\u0dc3\u0dd2 \u0dc0\u0dd2\u0d9c\u0dbb \u0db0\u0dca\u200d\u0db1 \u0dbb\u0dd2\u0d9c\u0dd2\u0dca \u0dbb\u0dd2\u0d9c\u0dad\u0db4\u0db8 \u0db1\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dc5\u0dcf. \u0d9c\u0db8\u0dca\u0dba \u0d9c\u0dca\u0d9a \u0db1\u0db8\u0dba\u0dd2 \u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dca\u200d \u0dc0\u0dd4\u0d9c\u0dda. \u0d89\u0dad\u0dd2\u0d9a\u0dca \u0d9c\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dd3\u0db8 \u0d85\u0db4\u0dd2 \u0d9c\u0dc4\u0dc5\u0dcf \u0daf \u0d9a\u0dd2\u0db1 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda \u0db8 \u0d9c\u0db8\u0dc0 \u0dd2\u0dba \u0dc3\u0dd2\u0daf\u0dd4\u0dd3\u0dca \u0dba \u0dc0\u0db1 \u0d87\u0dad\u0dd2\u0d9a \u0d9c\u0dba\u0dcf\u0dc0\u0dca\u0dba \u0d85\u0db4\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dad \u0d9c\u0dad\u0db1 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d92 \u0dd2\u0dba\u0d9a\u0dcf \u0d87\u0dad\u0dca\u0db1\u0db4\u0db8 \u0d85\u0db4\u0dd2 \u0d9c\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0db0\u0dca\u200d\u0dba\u0db1\u0dba\u0db1 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d92 \u0d9a\u0db3\u0dc4\u0dcf \u0db8\u0dc4\u0da2\u0dba \u0d9c\u0d9a\u0dde\u0d9b\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dbb\u0db0\u0dca\u200d\u0dbb\u0dca\u0db8, \u0dba\u0da0\u0dcf\u0dbb \u0db0\u0dca\u200d\u0dbb\u0dca\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0 \u0d87\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0db1 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0db8\u0dc4\u0da2\u0dba \u0d9c\u0d9a\u0dde\u0d9b\u0dca\u200d\u0dba\u0db1\u0db4 \u0d85\u0daf\u0dcf\u0dc5 \u0dc4\u0dbb\u0dd2\u0dc3\u0dd2 \u0d85\u0dc0\u0d9a\u0dda\u0dae\u0dcf\u0dc0 \u0d9a\u0dc5\u0db8\u0dba\u0dcf\u0d9a\u0dbb\u0da7\u0db1 \u0d9a\u0dbb\u0d9c\u0dad \u0db1\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d9a\u0dd4\u0da9\u0dcf \u0da2\u0dba \u0d9a\u0dda\u0da9\u0dcf\u0db1\u0dca\u0dc0\u0dbd \u0db8\u0dcf\u0dba\u0dc0 \u0d85\u0dba\u0dd2\u0dad\u0dd3\u0dca \u0d9a\u0dc4 \u0dba\u0d9c\u0dad\u0db8\u0dd2\u0d9a \u0dc0\u0dd2\u0dc1\u0dda\u0dc0\u0dcf\u0d9a\u0dc0\u0dbd\u0db4 \u0d9c\u0dad\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0, \u0dba\u0d9c\u0dad\u0db8\u0dd2\u0d9a \u0dd2\u0dba\u0daf\u0dc4\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d9c\u0d9a\u0dde\u0d9b\u0dca\u200d\u0dba \u0d9c\u0d9a\u0dda\u0dc0\u0db1 \u0d9a\u0db1\u0db1\u0dca\u0dba\u0dca \u0d9c\u0dad \u0dba \u0dc0\u0dd2\u0dc1\u0dda\u0dc0\u0dcf\u0d9a\u0db1 \u0db1\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d9c\u0db8\u0dc0 \u0dd2\u0dba \u0dc3\u0dd2\u0daf\u0dd4\u0dd3\u0dca\u0dc0\u0dd2\u0dca \u0d85\u0db4\u0dd2 \u0d89\u0d9c\u0d9c\u0dad\u0dba \u0d9c\u0dad\u0db1 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2, \u0d92\u0dc0\u0dcf \u0dba \u0dc0\u0db1 \u0d87\u0dad\u0dd2\u0d9a \u0dd3\u0db8 \u0dc0 \u0dc5 \u0dd3\u0db8\u0db4 \u0d85\u0dc0\u0dc1\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dad \u0d9c\u0dad \u0db1\u0dd3\u0db8\u0db4.\n\n[\u0baa\u0bbf.\u0baa. 4.29]\n\n\u0dd4\u0dab \u0d9c\u0d9a\u0dca. \u0d9a\u0dcf\u0daf\u0dbb\u0dca \u0dd9\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dca \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bae\u0b95. \u0b95\u0bc6\u0bbe\u0ba4\u0bb0\u0bcd \u0bc8\u0bb8\u0bcd\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd) (The Hon. K. Kader Masthan) \u0baa\u0bbf\u0bb8\u0bcd\u0bc8\u0bbf\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0bb9\u0bbf\u0bb0\u0bcd \u0bb0\u0bb9\u0bcd\u0bc8\u0bc6\u0bbe\u0ba9\u0bbf\u0bb0\u0bcd \u0bb0\u0bb9\u0bc0\u0bae\u0bcd.\n\n\u0ba4\u0b95\u0bcc\u0bb0\u0bc6 \u0b95\u0bc1\u0bb4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bc6\u0bbf\u0b9a\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bc6\u0bb0\u0bcd\u0b95\u0bae\u0bb3, \u0ba4\u0b95\u0bcc\u0bb0\u0bc6 \u0b87\u0bae\u0bcd\u0bb0\u0bc6\u0bbe\u0ba9\u0bcd \u0bc8\u0bb9\u0bcd\u0bb0\u0bc2\u0baa\u0bcd \u0b85\u0bc6\u0bb0\u0bcd\u0b95\u0bb3\u0bcd, \u2018\u0ba4\u0b95\u0bc6\u0bbe\u0bae\u0bb0\u0bc6\u0bbe\u0ba9\u0bc6\u0bbe\u2019 \u0ba4\u0baa\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0bb2\u0bc6\u0bbf\u0baf \u0b95\u0bc6\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc7\u0ba9\u0bc6\u0bbe\u0bb8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bae\u0bb3\u0ba4\u0bcd \u0ba4\u0b95\u0ba9\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bae\u0bc8 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0b95 \u0bc6\u0bbf\u0b9a\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b86\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1\u0ba4\u0bc6\u0bc6\u0bbe\u0ba9\u0bcd\u0bae\u0bb1 \u0ba8\u0bbf\u0baf\u0bc8\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0ba9 \u0baa\u0bbf\u0bae\u0bb0\u0bb0\u0bae\u0ba3\u0bae\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0ba4\u0bc8\u0bc6\u0bbe\u0bb4\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc6\u0bbe\u0bb0\u0bcd. \u0b89\u0ba3\u0bcd\u0bae\u0bc8\u0baf\u0bbf\u0bae\u0bb2 \u0b85\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0bc6\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0baa\u0bb2\u0bb0\u0bcd \u0b87\u0ba4\u0bc1\u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bc8\u0bc6\u0bbe\u0b95\u0b95\u0bcd\n\n2225 2226\n\n\u0db1\u0dcf\u0dbb\u0dca\u0dd2\u0d9c\u0dca\u0dca\u0dad\u0dd4\u0dc0"
  },

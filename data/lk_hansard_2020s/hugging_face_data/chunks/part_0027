    "chunk_text": "\u0d8a\u0dc5\u0dd9\u0da7 \u0dda\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd0 \u0dad\u0dd2\u0dba\u0dd2, \u0dc1\u0db8\u0dca \u0d9a\u0dca\u0dbb\u0dab\u0dba\u0dcf\u0dad\u0db8\u0d9a. \u0dc1 \u0d86 \u0db1\u0dba\u0dcf\u0dad \u0dda \u0dba\u0dd2 \u0d8b\u0dd4\u0dbd\u0dd2\u0db8\u0dca\u0db6\u0dbb \u0d86 \u0db1\u0dba\u0dcf\u0dad. \u0dc0\u0dad\u0db8\u0dc2 \u0dab\u0db1\u0dca\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0db1\u0dda\u0dbb \u0d9a\u0dbb\u0dbd\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dca\u200d\u0dbd \u0dc1\u0dba\u0dcf\u0dad \u0dca\u200d\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb \u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0dda \u0dba\u0dd2 \u0db8\u0dd2\u0dd2\u0dba\u0dc1\u0dda \u0dca\u200d\u0dbd \u0dc1\u0dba\u0dcf\u0dad \u0dca\u200d\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb \u0dba\u0dcf\u0dad. \u0db8\u0db4\u0da7 \u0db8\u0dd2\u0dd2\u0dba\u0dc1\u0dda \u0dca\u200d\u0dbd \u0dc1\u0dba\u0dcf\u0dad \u0dca\u200d\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb \u0dba\u0dcf\u0dad 2026 \u0db8\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc1 \u0db8\u0dc0 \u0dca\u0db1\u0dc1\u0dc3 \u0db1\u0dd0\u0dc0\u0dda \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca \u0dca\u0d9a\u0da0\u0da1\u0dca \u0d9a\u0dbb\u0dbd\u0dca \u0dcf\u0dd0\u0db1\u0dca \u0d91\u0dba\u0dcf\u0dad\n\n2029 2030\n\n\u0db4\u0dca\u0dad\u0db8 \u0dc3\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d8a\u0dc5\u0dd9\u0da7, \u0dc4\u0dd3\u0dda \u0dd9 \u0dca\u200d\u0dbd \u0dc1\u0dba\u0dcf\u0dad \u0dca\u200d\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb \u0dba\u0dcf\u0dad \u0dc1\u0db8\u0dca \u0dc0\u0db1\u0daf\u0dd4\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a \u0dc1\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dca. \u0dc1\u0db8\u0dca \u0daf\u0dd4\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7 \u0db8\u0d9a\u0dda\u0dca\u0da7 \u0db4 \u0dcf\u0dc1 \u0dcf, \u0d8b\u0dd4\u0dbd\u0dd2\u0db8\u0dca\u0db6\u0dbb \u0d86 \u0db1\u0dc1\u0dc3 \u0db8\u0dd2\u0dd2\u0dba\u0dc1\u0dda \u0dca\u200d\u0dbb\u0dca\u0dc1 \u0dc1\u0dd3\u0dba\u0dcf\u0dad \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dc1\u0d9a\u0dca\u0dda\u0db0\u0dca \u0dc1\u0dc3 \u0d9c\u0dca\u200d\u0dbb\u0dca \u0dd2\u0dba\u0dbd\u0db0\u0dca\u0dbb\u0dd2 \u0dc0 \u0db8\u0dca 48\u0da7 2027 \u0db8\u0dc0\u0dd4\u0dbb\u0dd4 \u0dcf \u0db8\u0dc0 \u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dca\u0da7 \u0dca\u200d\u0dbd\u0dba\u0dcf\u0dad \u0dbd\u0db6\u0dca \u0daf\u0dd3 \u0da7 \u0db8\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dca. \u0dc1\u0db8\u0dca \u0dc0\u0dd0 \u0d91\u0d9a\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db8\u0dc1\u0dda \u0dca\u200d\u0dca\u0dad\u0dd2\u0d9a \u0dca\u200d\u0dbd \u0db8\u0dca\u0db4\u0dca\u0dcf\u0db1 \u0dc0\u0dca \u0dca\u200d\u0dbd\u0dca\u0db4\u0dc0\u0dc0\u0db1 \u0dab\u0dca\u0da9\u0dcf \u0dbd\u0dba\u0dcf\u0dad \u0dba\u0dcf\u0dad\u0da7\u0dc1\u0db8\u0d9a\u0dba\u0dd2. \u0d92 \u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0d9a\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0d91\u0d9a \u0dcf\u0dd0\u0db1\u0dca \u0db1\u0dda\u0dbb \u0d9a\u0dbb\u0dbd\u0dca \u0dcf\u0dd0\u0db1\u0dca \u0db8\u0dd2\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0db1\u0dda \u0dd0\u0db1 \u0d9a\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0db8\u0dca.\n\n\u0db8\u0dcf \u0db8\u0db4\u0dd2 \u0dda\u0dc0\u0db8\u0d9a \u0db4\u0db1\u0dda\u0d9a\u0dca\u0d9a\u0dba \u0dd0\u0db1 \u0d9a\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dca. \u0d92\u0d9a \u0daf\u0dd4\u0dc1\u0dc3\u0dcf\u0dc2 \u0db4\u0db1\u0dda\u0d9a\u0dca\u0d9a\u0dba. \u0d92 \u0dda \u0dba\u0dd2, \u0db8\u0d9a\u0dc0 \u0db4\u0db1\u0dda. \u0dc1\u0db8\u0dca \u0db8\u0dc0 \u0dcf\u0db1\u0dca\u0dc1\u0dda \u0db8\u0d9a\u0dc0 \u0db4\u0db1\u0dda \u0dd0\u0db1 \u0db8\u0dcf\u0dc0 \u0dcf \u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0db1\u0dca\u0db1 \u0dc1\u0db4\u0dca\u0da9\u0dd2 \u0dc1\u0dda\u0dbd\u0dca\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0db1\u0dca\u0db1\u0dc0\u0dca. \u0db8\u0d9a\u0dc0 \u0db4\u0db1\u0dda\u0db8\u0d9a \u0d92 \u0dc0\u0dca\u0dc1 \u0dda \u0dba\u0dd2. \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0d9a\u0db8\u0dca \u0db8\u0d9a\u0dc0 \u0db4\u0db1\u0dda \u0dc3\u0dad\u0dd4\u0dc1\u0dc5\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca \u0db8\u0dd3\u0dc0\u0dbb\u0d9a\u0dca \u0dc0\u0dca \u0d91\u0dc5\u0dc0\u0dbb\u0d9a\u0dca \u0dba\u0dcf\u0dad\u0db1 \u0db8\u0d9a\u0dc0 \u0dc1\u0dcf\u0dc0\u0dad\u0db8 \u0dba\u0dcf\u0dad \u0dca\u200d\u0dbb\u0dc0\u0dca\u0dc0\u0db1\u0dba\u0dcf\u0dad \u0dbb\u0dd3\u0db8 \u0da7 \u0dc1 \u0dde\u0d9b\u0dca\u200d\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dd2\u0dda \u0dc0\u0dad\u0dd2\u0d9a\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0dbd\u0db6\u0dca \u0db1\u0dca\u0db1 \u0db8\u0dc0\u0dc3\u0dba\u0dba\u0dd2 \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca\u0dba\u0dd2. \u0db8\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0db1\u0db8\u0d9a \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dda\u0da7 \u0dc3\u0dad\u0dd4\u0dc5\u0db8\u0d9a \u0d9a\u0dbb\u0dbd\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca, \u0d91\u0dc5\u0dd4\u0dc0\u0dca, \u0db6\u0dd0\u0da7\u0dc5\u0dd4\u0dc0\u0dca, \u0d8c\u0dbb\u0dca \u0dc0\u0dd0\u0dd2\u0dba \u0dad\u0dd4\u0db1\u0dd4\u0db8\u0d9a. \u0dc1\u0db8\u0dca \u0db4\u0db1\u0db8\u0d9a \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dc1\u0dda\u0db1\u0dca \u0db1\u0dd3\u0dda\u0dba\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dba\u0dbd\u0db7\u0dca\u0dc0\u0dba\u0dcf\u0dad \u0db4 \u0dab\u0d9a\u0dca\u0d9a\u0dba \u0dc1\u0db1\u0dca\u0dc1\u0dc0\u0dba\u0dd2 \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dd2\u0dda \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db8\u0db4\u0dd2 \u0dcf\u0db1\u0dca\u0db1\u0dc0\u0dca, \u0dc1\u0db8\u0dca \u0dc0\u0dd0 \u0dc1\u0dda\u0d9a\u0dca\u0d9a\u0dba \u0db8\u0dd2\u0dd2\u0dba \u0dca \u0db6\u0dd2\u0dc4\u0dd2 \u0dc1\u0dc0\u0da0\u0da0 \u0dcf\u0dca \u0dd2\u0dc0\u0da7 \u0db8\u0dd2\u0dd2\u0dba \u0dca\u0db8\u0d9a \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0d9a \u0da2\u0dd3\u0dc0\u0db8\u0d9a \u0dc1\u0dc0\u0da0\u0da0 \u0da2\u0dd3\u0dc0\u0dd3\u0db1\u0dca \u0dc1\u0d9a\u0dca\u0da7 \u0d9a\u0dca\u0d9a\u0dba \u0db6\u0dc0. \u0dc1\u0db8\u0dca \u0da2\u0dd3\u0dc0\u0dd3\u0db1\u0dca\u0dc1 \u0db1\u0dca \u0db8\u0db4\u0dd2 \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dca\u0dc0 \u0dbd\u0db6\u0dca\u0dc1 \u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca. \u0d92 \u0dc0\u0dca\u0dc1 \u0db8\u0dc1\u0dda \u0d86\u0dc0\u0dca\u0dbb \u0db4\u0dca\u0db1 \u0da7\u0dd2\u0d9a \u0db4\u0dba\u0dcf\u0dad\u0dca \u0db1\u0dca\u0db1 \u0dad\u0dd4\u0db1\u0dca \u0dc1\u0dba\u0dcf\u0dad\u0dca\u0dcf\u0dca\u0dc1 \u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca. \u0daf\u0dd4\u0dc1\u0dc3\u0dcf\u0dc2\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca \u0db8\u0dc1\u0dda \u0dc1\u0dca\u200d\u0dbb \u0da7\u0dd3\u0db1\u0dca \u0db8\u0dc0\u0dc3\u0dba\u0dda\u0dca\u0dc0 \u0db4\u0dd4\u0dbb\u0dca \u0db1\u0dca\u0db1 \u0db8\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0da2\u0dd3\u0dc0\u0dd3\u0db1\u0dca \u0db7\u0dca\u0daf\u0dd4\u0dda \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca. \u0d92 \u0dc0\u0dca\u0dc1 \u0db8\u0dc1\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dde\u0daa\u0db8\u0d9a\u0dc0\u0dba\u0dcf\u0dad; \u0dca\u0db8\u0dca\u0dd3\u0db1\u0dbb\u0db8\u0d9a\u0dc0\u0dba\u0dcf\u0dad \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dca \u0d9a\u0dbb \u0db1\u0dca\u0db1, \u0d91\u0dc1\u0dc0 \u0db1\u0dd0\u0db8\u0d9a\u0db1\u0db8\u0dca \u0d8b \u0daf\u0dd3\u0db4\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb \u0db1\u0dca\u0db1 \u0db8\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0dad\u0dd4\u0db1\u0dca \u0db4\u0dca\u0daf\u0dd4\u0da0 \u0d9a\u0dbb\u0dbd\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dca. \u0d92 \u0dd2\u0dba \u0dca \u0dc1 \u0dc4\u0dd2\u0daf\u0dd3 \u0db4\u0db1\u0db8\u0d9a \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dda\u0d9a\u0dca\u0d9a\u0dba \u0dc1 \u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dca \u0dad\u0dd4\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dca\u0da7 \u0dc0\u0da9\u0dcf \u0dca \u0db8\u0db4\u0da7 \u0dc0\u0dd0\u0d9f\u0dd3 \u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dad\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dad\u0dd4\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8\u0db4\u0da7 \u0dc1\u0dc0\u0db1 \u0dc0\u0da7\u0dd2\u0db1\u0dca\u0d9a \u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dcf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d92\u0d9a \u0dda \u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0db1\u0db8\u0d9a\u0dc0 \u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0dcf\u0dad \u0daf\u0dd4\u0dda\u0dbb\u0d9a\u0dca\u0d9a\u0dba \u0dc1\u0db1\u0dca\u0dc1\u0dc0\u0dba\u0dd2 \u0db8\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0db1\u0db8\u0d9a \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dd2\u0db1\u0dca \u0dc1 \u0dc1\u0db1\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db8\u0db4\u0dd2 \u0dad\u0dd4\u0db1\u0dca \u0dd0\u0db1 \u0dc0\u0dd0\u0da9\u0dd2\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca \u0d9a\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0db1\u0dca\u0db1\u0dc0\u0dca. \u0dad\u0dd4\u0db1\u0dca\u0dc1 \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dca\u0dc0 \u0dd0\u0db1, \u0dad\u0dd4\u0db1\u0dca\u0dc1 \u0dc1 \u0dde\u0d9b\u0dca\u200d\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8\u0db4\u0dd2 \u0d9a\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dca."

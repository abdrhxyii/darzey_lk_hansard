u0b9c\u0baf\u0ba8\u0b9a\u0b95\u0bcd\u0b95\u0bb0) (The Hon. Dayasiri Jayasekara, Attorney-at-Law) \u0d9c\u0dbb\u0dd4 \u0dd9 \u0dcf \u0db1\u0dcf \u0dd9\u0dd4\u0db8 \u0dd2\u0dbd, \u0dd2\u0dc5\u0dd2\u0db6\u0dd4\u0dba \u0db3\u0dcf \u0daf\u0dd3\u0db8 \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db1\u0daf \u0db1\u0dca \u0db8 \u0db8 \u0d9c\u0dbb\u0dd4 \u0dd2\u0dbd\u0daf \u0da2\u0dba \u0db3\u0db8 \u0dad\u0dd2\u0d9a\u0dd4\u0db8 \u0dcf \u0db4 \u0dca\u0dae\u0dd4\u0dad\u0dd2\u0d9a\u0dc0\u0db1\u0dca\u0dad \u0daf\u0dc0\u0db1\u0dc0\u0dcf . \u0db8 \u0daf\u0dda \u0db1\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dbd \u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dae\u0db1 \u0daf\u0db8 \u0dba\u0dd2.\n\n\u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0dca\u0dcf \u0db8 \u0dca\u0db1\u0dd0\u0db1\u0dca \u0db8 \u0dad \u0db1\u0db1\u0dc0\u0db1 \u0db3\u0daf\u0dd4 \u0dc0\u0dd2\u0daf\u0db0\u0dae\u0dc2\u0dca\u0da8\u0daf \u0db1\u0dca \u0dd9\u0dbb\u0dd4\u0db8 \u0db3\u0daf\u0dd4 \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0dad\u0db8 \u0dba\u0dd2 \u0dcf\u0dd4\u0db8\u0db1\u0dca\u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca. \u0d91\u0daf\u0dcf\u0db8 \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0daf\u0dcf\u0dae\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . WHO \u0dc0\u0dcf \u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dad\u0db1\u0dd4\u0dc0 \u0dc0\u0dca\u0dba\u0dd9\u0db4 13,000-20,000 \u0dad\u0dad\u0dba \u0dd2\u0dc5\u0db4\u0dad\u0dca\u0d9a\u0dca \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0db6\u0dd3\u0daf\u0db8 \u0db1\u0dca \u0db8\u0dd2 \u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dcf \u0dca \u0dcf\u0db1\u0dca \u0dd9\u0dba \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2\n\n\u0dcf \u0db8 \u0dca\u0db1\u0dd0\u0db1\u0dca \u0db1\u0dcf \u0db1 \u0dd2\u0dbd\u0dca\u0dcf \u0db3\u0dad\u0dd2\u0d9a \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1 \u0dad\u0dca\u0dca\u0dc0 \u0dca \u0d91\u0d9a\u0dca\u0dd9 \u0dc1\u0dd9\u0dcf \u0daf\u0dda, per week, 250 \u0daf\u0dd9\u0daf\u0db1\u0d9a\u0dd4\u0db4 cancers \u0db3\u0dad\u0dd2\u0d9a \u0daf\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dcf \u0dca \u0dcf\u0db1\u0dca\u0dc0 \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0d9c\u0dbb\u0dd4 \u0dd9 \u0dcf \u0db1\u0dcf \u0dd9\u0dd4\u0db8 \u0dd2\u0dbd, 2022 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8\u0daf\u0dda 35,835 \u0daf\u0dd9\u0daf\u0db1\u0d9a\u0dd4 \u0daf\u0db8\u0dca \u0daf\u0dcf\u0dae\u0dd4\u0dc0 \u0dd2\u0dbd\u0dca\u0dcf \u0daf\u0dba \u0d9c\u0dd3 \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0d92 \u0dad\u0dad\u0db4\u0dad\u0db1\u0dca 16,398\u0d9a\u0dca \u0dd2\u0dc5\u0db4\u0dad\u0db8\u0dd2, 19,457\u0d9a\u0dca \u0dd9\u0dcf \u0db1\u0dca\u0dad\u0dcf \u0dc0\u0db1\u0dca. \u0dd9\u0dd0\u0db1\u0dca \u0dd9\u0dcf \u0db1\u0dca\u0dad\u0dcf \u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0db0\u0dcf \u0dc0\u0db0\u0daf \u0db1\u0dca \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0db1\u0dcf \u0db1 \u0db4 - smoking \u0dca \u0dcf\u0dcf - \u0db3\u0dda\u0db3\u0dd0\u0dc4\u0dd2 \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf . \u0dc3\u0dd2 \u0db4 72\u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dba \u0daf\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf \u0dc0\u0dd2 \u0db4 \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db1 \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dcf \u0dad\u0db8 \u0dba\u0dd2 \u0dca \u0dcf\u0db1\u0dca \u0daf\u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca.\n\n\u0dad\u0daf\u0db1\u0d9a\u0dca \u0dd9\u0dcf \u0dba\u0da7 \u0daf\u0db8\u0dca\u0dd9\u0dba\u0dd2, \u0d9c\u0dbb\u0dd4 \u0dd9 \u0dcf \u0db1\u0dcf \u0dd9\u0dd4\u0db8 \u0dd2\u0dbd. \u0dbb\u0dd4\u0dd2\u0dc5 \u0dbd\u0dca 160\u0d9a\u0dca \u0dc0\u0db1 \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0d91\u0dd9\u0dd9\u0db4 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbb\u0dd4\u0dd2\u0dc5 \u0dbd\u0dca 109\u0dd9 \u0db3\u0daf\u0dca\u0db7\u0dd9\u0d9a\u0dca \u0d9c\u0dcf\u0db1\u0dc0\u0dcf . \u0daf\u0db8\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0db3\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf \u0db8 \u0dad\u0dad\u0dd2\u0d9a\u0dc0\u0dd2\u0db0\u0dcf \u0db3\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf \u0da7 \u0d9a\u0dd4\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf .\n\n\u0dad\u0daf\u0db1\u0d9a\u0dca \u0db1\u0dd0\u0dca\u0daf\u0dad\u0db1\u0dca, \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0dc0\u0dd2\u0db0\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf \u0da7 \u0d9a\u0dca \u0daf\u0dcf\u0dcf \u0dba \u0db1\u0dcf \u0daf\u0dba\u0db1\u0dca \u0d91\u0db1\u0dc0\u0dcf . \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0dc0\u0dd2\u0db0\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf \u0da7 \u0d9a\u0dca detection centres\u0dc0 \u0daf\u0dd3 \u0dcf\u0dc3\u0dd4 \u0daf\u0dc0\u0db1\u0dc0\u0dcf . \u0dc1\u0dd9\u0dcf \u0dc0\u0db4 \u0daf\u0dcf\u0dcf \u0daf\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0dc0\u0dd2\u0db0\u0dcf \u0dc0\u0db0\u0daf \u0db1\u0dca \u0daf\u0d9c\u0db1\u0dca\u0dc0\u0db1\u0dc0\u0dcf . \u0d92 \u0dc0\u0dcf \u0daf\u0dda \u0db8 \u0dca\u0db8 \u0dcf\u0dba \u0d9a\u0dd4\u0da9\u0dcf \u0daf\u0dc0\u0daf\u0dc5 \u0dca\u0dd0\u0dbd\u0dca\u0dc0 \u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0db3\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf \u0db8 \u0daf\u0db1\u0daf\u0db1\u0db1\u0dc0\u0dcf , \u0da2Gold Leaf\" cigarette packet \u0d91\u0daf\u0d9a\u0dca, \"Dunhill\" cigarette packet \u0d91\u0daf\u0d9a\u0dca \u0db1\u0db8 \u0dd9\u0dcf \u0dcf \u0d9a\u0dd4\u0da9\u0dcf \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0dc0\u0dd2\u0d9a\u0dd4\u0da7\u0db1 \u0d86\u0dd9\u0dcf \u0dba . \u0db8 \u0db8 \u0d92 \u0d9c\u0dd0\u0db1 \u0dcf\u0db4\u0dad \u0db4\u0db8 \u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dcf\u0dd0. \u0daf\u0db8 \u0dcf \u0dd9\u0dd9, \u0db8 \u0db8 \u0dc3\u0dd2\u0d9c\u0dbb\u0dd0\u0da7\u0dca \u0daf\u0db3\u0dcf \u0db1 \u0daf\u0dd9\u0daf\u0db1\u0d9a\u0dca \u0daf\u0db1\u0dcf \u0daf\u0dc0\u0dba\u0dd2. \u0db1\u0db8\u0dd4\u0dca \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1 \u0dad\u0dca\u0dca\u0dc0 \u0db1\u0dca \u0d91\u0d9a\u0dca\u0dd9 \u0db8 \u0db8 \u0daf\u0db8\u0dca\u0dc0\u0dcf \u0d9a\u0dd2 \u0db1\u0dca\u0daf\u0db1\u0dca."

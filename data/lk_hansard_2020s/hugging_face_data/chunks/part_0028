    "chunk_text": "\u0dc4\u0dd2\u0dc3\u0dca\u0dd4\u0dab\u0dbd\u0dca\u0dbd\u0dcf\u0dc4\u0dca \u0db8\u0dda\u0dd3\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d85 \u0dd2\u0dba\u0daf\u0dd2\u0d9c\u0dad \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dc0\u0daf\u0dba \u0dd3\u0da8\u0dba\u0dba\u0d9a\u0dca\u0dad \u0dc3\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0dda\u0db0\u0dba\u0dba\u0dda \u0dc0\u0dd6 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0 \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0dba\u0d9c\u0dad\u0db1 \u0d92\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0dda\u0db0\u0dba\u0dba\u0db1\u0dd4\u0dad\u0dca, \u0dba\u0db8\u0dca \u0d9a\u0dd2\u0d9a\u0dcf\u0dc0\u0da7 \u0d91\u0d9a\u0dad\u0dd4\u0dbb \u0dba\u0dc0\u0da0\u0dca\u0da0 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0db8\u0dda\u0dd3\u0dc0\u0dbb\u0dd4\u0dda\u0da7\u0dad\u0dca \u0db8\u0db8 \u0dc3\u0dca\u0dad\u0dd4\u0dbb\u0dd2\u0dba \u0db4 \u0d9a\u0dbb\u0dda\u0db1 \u0d9a\u0dd0\u0db8\u0dd2\u0dba\u0dd2\u0db4\n\n\u0dc0\u0dd2\u0dba\u0dba\u0dca\u0dc2\u0dba\u0dba\u0dda\u0db8 \u0daf\u0dc0\u0daf\u0dba \u0dd3\u0da8\u0dba\u0dba\u0d9a\u0dca\u0dad \u0dc4\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0dba\u0d9a\u0dcf\u0da7 \u0d85\u0daf\u0dcf \u0dc0\u0dda\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0dba\u0dc1\u0dba\u0dba \u0dc0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dca\u0dad \u0dba\u0db1\u0dcf\u0dba\u0dc0\u0dba\u0dd2\u0db4 \u0d9c\u0dad\u0dbb\u0dd4 \u0db8\u0dda\u0dd3\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0dc3\u0db3\u0dc4\u0dda \u0d9a \u0dcf \u0dc0\u0dcf\u0dba \u0d92\u0d9a \u0da2\u0dcf\u0dd2\u0d9a \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dca\u200d\u0dcf\u0dc0\u0d9a\u0dca\u0dad\u0db4 \u0d91\u0db8 \u0dd2\u0dba\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0dda\u0db0\u0dba\u0dba\u0dda \u0d9c\u0dad\u0dda\u0dba\u0dda \u0da2\u0dcf\u0dd2\u0d9a \u0db8\u0da7\u0da7\u0dba\u0db8\u0dca \u0dad\u0dd3\u0dbb\u0dab\u0db4 \u0d91\u0dad\u0dca\u200d\u0dba\u0d9a\u0dcf\u0da7 \u0da2\u0dcf\u0dd2\u0d9a \u0db8\u0da7\u0da7\u0db8\u0dd2\u0dda \u0d85\u0db4\u0dd2 \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0db1 \u0dba\u0dc1\u0dc0\u0dbd\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca\u0dad\u0db8 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d91\u0dba\u0dd2\u0dda \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca\u0dad \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dda \u0d9a\u0dba \u0dca\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2, \u0da2\u0db1\u0d9c\u0dad\u0dc4\u0db1 \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4 \u0d87\u0dba\u0dd2 \u0d92? \u0dc0\u0dd2\u0dba\u0dba\u0dca\u0dc2\u0dba\u0dba\u0dda\u0db8 \u0d85\u0db4\u0dd2 \u0daf\u0dda\u0db1\u0dcf \u0dc4\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dc0\u0dc3\u0dca\u0dc0\u0dbd \u0da2\u0db1\u0d9c\u0dad\u0dc4\u0db1\u0dba \u0dba\u0dc0\u0db1\u0dc3\u0dca \u0dc0\u0dd4\u0dab\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0daf\u0dd0\u0dd2\u0dc0 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dbb\u0dda\u0db1 \u0dc4\u0dd2\u0dad\u0dca\u200d\u0dcf\u0dba\u0d9c\u0dad\u0db1 \u0d89\u0dda\u0db1\u0dc0\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0da2\u0db1\u0d9c\u0dad\u0dc4\u0db1 \u0daf\u0dad\u0dca\u0dad\u0dca\u200d \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4 \u0d91 \u0d9f\u0da7, \u0daf\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dba\u0dba\u0d9a\u0dd4\u0da7 \u0dba\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dba\u0dbb \u0d9c\u0dd3\u0dda \u0d89\u0dda\u0db1\u0dc0\u0dcf \u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4 \u0d91 \u0d9f\u0da7, \u0dba\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dbb \u0d87\u0db3\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dba\u0dbb \u0d9c\u0dd3\u0dda\u0da7 \u0dba\u0dc0\u0dda\u0dba\u0dc0\u0dbd\u0dcf \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf \u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4 \u0dba\u0db8\u0dc0\u0dd0\u0dd2\u0dba \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dba\u0d9c\u0dad\u0dcf\u0da9\u0d9a\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0da2\u0dcf\u0dd2\u0d9a \u0db8\u0da7\u0da7\u0db8\u0dd2\u0dda \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4\n\n\u0d91\u0da7 \u0db4\u0dc3\u0dca\u0dba\u0dc3\u0dca \u0db6\u0dbd\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dd2\u0da7 \u0daf\u0dd0\u0dda \u0daf\u0dc0\u0daf\u0dba \u0dd3\u0da8\u0dba \u0dba\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf \u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0db4 \u0dba\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d85\u0db4\u0da7 \u0daf\u0dc0\u0daf\u0dba \u0dd3\u0da8\u0dba 12\u0d9a\u0dca\u0dad \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0dba\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dba\u0db8\u0dca\u0dc0\u0dcf\u0dba\u0dd2\u0dda \u0db4\u0dd2\u0da7 \u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4 \u0da2\u0dcf\u0dd2\u0d9a \u0db4\u0dc1\u0db0\u0dd2\u0dba\u0dda \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dca\u200d\u0dcf\u0dc0 \u0dba\u0db8\u0dba\u0dd2\u0dda \u0db4\u0dd2\u0dba\u0dbb\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dc1\u0daf\u0dd3 2019-2020 \u0dc0 \u0dc2\u0dba \u0dad\u0dd4\u0dbb \u0dc3\u0dd2\u0dc3\u0dd4\u0dda 1,967 \u0dc3\u0dd2\u0da7 2023-2024 \u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 2,109 \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0d9a \u0dc2\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dba\u0db8\u0dca \u0db4\u0dc1\u0db0\u0dd2\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0dbb \u0dad\u0dca \u0dba\u0dc0\u0dbd\u0dcf \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d92\u0d9a\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0d9a\u0dca\u0dad\u0db4 \u0dba\u0db8\u0dba\u0dd2\u0dda \u0d85\u0db4\u0da7 \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda \u0daf\u0dad\u0dca\u0dad\u0dca\u200d\u0dba \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2, \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4 \u0db0\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dc0\u0dd0\u0dd2 \u0dba\u0dc0\u0db8\u0dd2\u0dda \u0db4\u0dc0\u0dd2\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0db4 \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0dda\u0db0\u0dba\u0dba\u0db1\u0dd4\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0db1\u0dc0\u0dcf\u0db4\n\n\u0d91 \u0d9f\u0da7 \u0d85\u0db4\u0dd2 \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf, \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dad\u0dbb\u0dd4 \u0db8\u0dda\u0dd3\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba\u0db4 \u0d92 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2, \u0db4\u0dca\u200d\u0dbb\u0dba\u0dc1\u0dba\u0dba\u0dda \u0daf\u0dad\u0dca\u0dad\u0dca\u200d\u0db4 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dda \u0dc3\u0db3\u0dc4\u0dda \u0d9a \u0dcf \u0dc0\u0dcf\u0dba , \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0dad \u0db8\u0dc4 \u0dba\u0dbb \u0dc4\u0dbd, \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb, \u0d87\u0db3\u0dda 840\u0dba\u0dd2\u0db4 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db1\u0dc0\u0dcf, \u0dba\u0db8\u0dca \u0dba\u0dbb \u0dc4\u0dba\u0dbd\u0dca \u0d87\u0db3\u0dda \u0db4\u0dd2\u0dbb\u0dd3\u0dba\u0dcf\u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dad\u0dca\u200d\u0dba\u0db4 Bed occupancy rate \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf\u0db4 \u0d92\u0d9a \u0dc0\u0dd0\u0dd2 \u0dba\u0dc0\u0dda\u0db1 \u0d95\u0db1 \u0db4 \u0daf\u0dd0\u0dda \u0dba\u0db8\u0dca \u0dba\u0dbb \u0dc4\u0dba\u0dbd\u0dca \u0d87\u0db3\u0dda \u0db4\u0dd2\u0dbb\u0dd3\u0dba\u0dcf\u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dad\u0dca\u200d\u0dba 52\u0d9a\u0dca\u0dad \u0dba\u0dc0\u0dbd\u0dcf \u0dd2"

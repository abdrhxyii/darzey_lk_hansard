    "chunk_text": "\u0db6\u0dd2\u0dd2\u0dba\u0da2 \u0dbd\u0d82552\u0dca \u0dbd\u0d82 \u0daf\u0dca \u0dbd\u0d82 \u0dc5\u0dae \u0dbd\u0d82\u0dbb\u0da2 \u0d86 \u0dbd\u0d82\u0daf\u0da7\u0dd2\u0da2\u0db4 \u0da2 \u0dbd\u0d82\u0dc4\u0db3\u0dd4\u0da2\u0db4 \u0dbd\u0d82\u0dc3\u0dad\u0dca\u0dcf \u0dbd\u0d82\u0dca\u0da9\u0dd4\u0d9a\u0dca\u0daf\u0dca \u0dbd\u0d82\u0db1\u0dd2\u0dcf\u0db4\u0dd2. \u0dbd\u0d82 \u0daf\u0daf\u0dd0\u0db1\u0dd2 \u0dbd\u0d82\u0d9c\u0dc0\u0dd4\u0dbb\u0dd4 \u0daf\u0dd2\u0dad\u0dca \u0dbd\u0d82\u0dba\u0db4\u0da2\u0dcf\u0dba \u0dbd\u0d82 \u0dcf\u0dae\u0daf \u0dba\u0dca \u0dda \u0dbd\u0d82\u0db4\u0da9\u0dd2 \u0dbd\u0d82\u0daf\u0dd0\u0da9\u0dd2 \u0dbd\u0d82 \u0dba\u0dca\u0da2 \u0dbd\u0d82\u0db6\u0dd2\u0dd2\u0dba\u0da2 \u0dbd\u0d82552\u0dca \u0dbd\u0d82 \u0daf\u0dca \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0dca \u0dca \u0dbd\u0d82\u0dbb\u0da2 \u0d86 \u0dbd\u0d82\u0daf\u0da7\u0dd2\u0da2\u0db4 \u0da2 \u0dbd\u0d82\u0dc4\u0db3\u0dd4\u0da2\u0db4 \u0dbd\u0d82\u0dc3\u0dad\u0dca\u0dcf \u0dbd\u0d82\u0dca\u0da9\u0dd4\u0d9a\u0dca\u0daf\u0dca \u0dbd\u0d82\u0db1\u0dd2\u0dcf\u0db4\u0dd2. \u0dbd\u0d82 \u0dca\u0daf\u0da2 \u0dbd\u0d82\u0d9c\u0dc0\u0dd4\u0dbb\u0dd4 \u0daf\u0dad\u0dca \u0dbd\u0d82- \u0dbd\u0d82 \u0db8\u0dca \u0dbd\u0d82\u0d9c\u0dc0\u0dd4\u0dbb\u0dd4 \u0daf\u0dad\u0dca \u0dbd\u0d82- \u0dbd\u0d82\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82\u0db6\u0d9a\u0db4 \u0db4\u0db4 \u0dba\u0db4\u0dad\u0dca \u0dbd\u0d82\u0daf\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0dba\u0db4\u0da2\u0dcf\u0dba \u0dbd\u0d82 \u0dcf\u0dae\u0daf \u0dba\u0dca \u0dda \u0dbd\u0d82\u0db4\u0da9\u0dd2 \u0dbd\u0d82\u0daf\u0dd0\u0da9\u0dd2 \u0dbd\u0d82 \u0dba\u0dca\u0da2 \u0dbd\u0d82\u0db6\u0dd2\u0dd2\u0dba\u0da2 \u0dbd\u0d82552\u0dca \u0dbd\u0d82 \u0daf\u0dca \u0dbd\u0d82 \u0dba\u0dca\u0da2. \u0dbd\u0d82 \u0db8\u0dca \u0dbd\u0d82\u0dcf\u0da2\u0dd2 \u0dbd\u0d82\u0dbb\u0da2 \u0d86 \u0dbd\u0d82\u0daf\u0da7\u0dd2\u0da2\u0db4 \u0da2 \u0dbd\u0d82\u0dc4\u0db3\u0dd4\u0da2\u0db4 \u0dbd\u0d82\u0dc3\u0dad\u0dca\u0dcf \u0dbd\u0d82\u0dca\u0da9\u0dd4\u0d9a\u0dca\u0daf. \u0dbd\u0d82\n\n\u0da9\u0dd4\u0d9a\u0dca\u0daf\u0dca. \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82\n\n\u0d9c\u0db4\u0da7 \u0dbd\u0d82\u0d9c\u0db4\u0da2\u0dba\u0da2 \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0db0\u0da2\u0dba \u0dbd\u0d82 \u0dba\u0dca\u0da2 \u0dbd\u0d82\u0d9c\u0daf \u0dba\u0dd2. \u0dbd\u0d82\u0d9c\u0db4\u0da2\u0dba\u0da2\u0dba \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0db0\u0da2\u0dba \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8\u0da2 \u0dbd\u0d82 \u0dd2\u0db6\u0dca \u0dbd\u0d82\u0dcf\u0da2\u0dd2 \u0dbd\u0d82\u0d9c\u0db4\u0da7 \u0dbd\u0d82 \u0da9\u0db4\u0d9a\u0dbb\u0dca\u0dbd \u0dbd\u0d82\u0dd2\u0dc3 \u0db4\u0d9a \u0dbd\u0d82\u200d\u0dbb\u0da2\u0db4\u0dab\u0dba\u0dca \u0dbd\u0d82 \u0dc4\u0db4\u0dba\u0db4 \u0dbd\u0d82\u0dc3\u0dca\u0da2 \u0dbd\u0d82\u0db4\u0dd4\u0dc5\u0dd4\u0daf\u0dca \u0da2 \u0dbd\u0d82\u0d9a\u0dd0 \u0db6\u0dca \u0dca. \u0dbd\u0d82\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82\u0d92 \u0da7 \u0dbd\u0d82\u0d89\u0d9a\u0dca \u0dba\u0dca \u0dbd\u0d82\u0dc4\u0daf\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0d9c \u0dda \u0dbd\u0d82\u0db4\u0dcf\u0dae \u0dbd\u0d82\u0d9c\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 \u0dbd\u0d82\u0dcf\u0dd0\u0d9a\u0dd0\u0dcf\u0dae\u0da2\u0dca \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0d91\u0da2 \u0dbd\u0d82\u0dcf\u0dd0\u0d9a\u0dd0\u0dcf\u0dae\u0da2 \u0dbd\u0d82\u0d87 \u0dc5\u0dae \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82 \u0db4 \u0dc4\u0db4\u0da2\u0daf \u0dbd\u0d82 \u0dd8\u0dd2 \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf\u0dba \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf \u0dbd\u0d82\u0dca \u0dc2\u0dae\u0dad\u0dca\u200d\u0dbb\u0dba \u0dbd\u0d82\u0dcf\u0dc4 \u0dbd\u0d82\u0db0\u0dd3\u0daf\u0dba \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf\u0dba \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0db0\u0da2\u0dba \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dc3\u0dca \u0dca \u0dbd\u0d82\u0dcf\u0dc4 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dc4\u0dba\u0dc4\u0db4 \u0dbd\u0d82\u0d9c\u0db4\u0da2\u0dba\u0da2 \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0db0\u0da2\u0dba \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dc3\u0dca \u0dca \u0dbd\u0d82 \u0db4 \u0dc4\u0db4\u0da2\u0daf \u0dbd\u0d82\u0dd2\u0dbb\u0dba\u0d9a\u0db4. \u0dbd\u0d82"

dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dba\u0dd2\u0db4 \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0da7 \u0dbd\u0d9a\u0dca\u0dad \u0dc0\u0dd6 - 455,303\u0dba\u0dd2\u0db4 (2026 \u0da2\u0dd4\u0dd2\u0dba \u0dc0\u0db1\u0dba\u0dad\u0dca\u200d\u0d9a\u0dca\u0dad) 2415/66 \u0d85\u0d82\u0d9a \u0daf\u0dbb\u0db1 2024\u0db412\u0db412 \u0daf\u0dd2\u0db1 \u0dd2\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9c\u0dad\u0dd0\u0dc3\u0da7 \u0db4\u0dbb\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb\u0dc0 \"\u0dc3\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dcf\u0dda\u0dd2\u0d9a\" \u0d9a\u0dcf\u0dab\u0dca\u0da9\u0dba\u0da7 2025 \u0da2\u0dd4\u0dd2\u0dba \u0dc0\u0db1\u0dba\u0dad\u0dca\u200d\u0d9a\u0dca\u0dad \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d9a\u0dd2\u0dda \u0dbd\u0dd0\u0dd4\u0dab\u0dba\u0dab\u0dca\u0db4 \u0d91\u0dba \u0dba\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6 \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0daf\u0dd3 \u0d9d \u0d9a\u0dbb\u0dbd\u0dcf \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d85\u0d82\u0d9a 2467/03 \u0d85\u0d82\u0d9a \u0daf\u0dbb\u0db1 2025\u0db412\u0db415\u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dd2\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0d9c\u0dad\u0dd0\u0dc3\u0da7 \u0db4\u0dbb\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \"\u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0da7 \u0dbd\u0d9a\u0dca\u0dad \u0dc0\u0dd6\" \u0d9a\u0dcf\u0dab\u0dca\u0da9\u0dba\u0da7 2026 \u0da2\u0dd4\u0dd2\u0dba \u0db8\u0dcf\u0dc3\u0dba \u0dc0\u0db1\u0d9a\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dcf\u0db7 \u0dbd\u0dd0\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 3) \u0dc3\u0dd4\u0db6\u0dc3\u0dcf\u0db0\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dcf\u0db7 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0db8\u0d9f\u0dd2\u0dda \u0db8\u0dd6\u0dd2\u0d9a \u0dc0\u0dba\u0dba\u0dba\u0dda \u0da2\u0da2\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dba\u0d9c\u0dad\u0dc0\u0dd3\u0db8 - direct cash transfers - \u0db4\u0db8\u0dab\u0d9a\u0dca\u0dad \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dca\u200d\u0dbb, \u0dc3\u0dc0\u0dd2\u0db6\u0dbd \u0d9c\u0dad\u0dd0\u0dda\u0dc0\u0dd3\u0dba\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dc3\u0db8\u0dd8\u0dc1\u0db0\u0dd2 \u0dc3\u0d82\u0dc0 \u0db0\u0db1 \u0dba\u0daf\u0db4\u0dcf \u0dad\u0dca\u200d \u0dba\u0db8\u0dca\u0dda\u0dad\u0dd4\u0dbb\u0dc0 \u0db8\u0d9f\u0dd2\u0dda \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dba\u0da7\u0dba\u0dad\u0dca \u0daf\u0dd0\u0db1\u0da7 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0dda 6\u0d9a\u0dca\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0db4 \u0d91\u0d9a, ADB \u0dd2\u0dba\u0dba\u0db8\u0dd4 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0db4 \u0d91\u0dba\u0dd2\u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0dca 810\u0d9a\u0dca\u0dad \u0dc4\u0dc0\u0dbb\u0dab\u0dba \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0db4 \u0dba\u0db8\u0dca \u0dc0\u0db1 \u0dba\u0d9a\u0dcf\u0da7 \u0db8\u0dd6\u0dbd\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 142\u0d9a\u0dca\u0dad \u0dc0\u0db1\u0dc0\u0dcf\u0db4 \u0dba\u0dbd \u0d9a \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dba\u0dc0\u0dda \u0dd2\u0dba\u0dba\u0db8\u0dd4 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dba\u0dc0\u0db1\u0dc0\u0dcf, \u0db4\u0dc0\u0dd4\u0dbd\u0dca 6,600\u0d9a\u0dca\u0dad \u0d89\u0dbd\u0d9a\u0dca\u0dad\u0d9a \u0d9a\u0dbb\u0dba\u0d9c\u0dad\u0db1\u0db4 \u0d91\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 587\u0d9a \u0db8\u0dd6\u0dbd\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0dba\u0db4\u0dda\u0db1\u0dd4\u0db8\
d\u0b9f\u0bcd 21, \u0ba8\u0bb5\u0bb3\u0bcd\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb4\u0b95\u0bc8 Friday, 21st August, 2026\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013\u2014\u2014\n\n\u0db4\u0dd6.\u0dc0\u0dcf. 9.30 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0 \u0dbb\u0dd0\u0dc3\u0dca\u0dad \u0dc0\u0dd2\u0dba. \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0dcf [ \u0dd4 (\u0dc0\u0dc0\u0daf\u200d) \u0da2 \u0dca \u0dc0\u0dd2\u0dca\u200d\u0dbb\u0db8\u0dbb\u0dca \u0db1 \u0db8\u0dad\u0dad\u0dcf \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0dca\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dc0\u0dd2\u0dba.\n\n\u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1\u0bae\u0bcd \u0bae\u0bc1.\u0baa. 9.30 \u0bc8\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0baf\u0ba4\u0bc1. \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd [\u0bc8\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bbe\u0bcd) \u0b9c\u0b95\u0ba4\u0bcd\n\n\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bc8\u0bb0\u0ba4\u0bcd\u0ba9] \u0ba4\u0b95\u0bb2\u0b95\u0bc8 \u0bb5\u0b95\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.\n\nThe Parliament met at 9.30 a.m., MR. SPEAKER [THE HON. (DR.) JAGATH\n\nWICKRAMARATNE] in the Chair.\n\n\u0db1\u0dd2\u0d9c\u0dda\u0daf\u0db1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd ANNOUNCEMENTS\n\n\u0dc0\u0dd2\u0dc3\u0dd2 \u0d9c\u0daf\u0dc0\u0db1 \u0d86\u0dab\u0dca\u0dd4\u0dca\u200d\u0dbb\u0db8 \u0dc0\u200d\u0dc0\u0dc3\u0dca\u0dad\u0dae\u0dcf \u0dc3\u0dca\u0dcf\u0d82\u0d9c\u0dc1\u0dba\u0dd3\u0dba\u0ddd\u0db0\u0dcf\u0db1\u0dba \u0db4\u0db1\u0dca \u0d9c\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad: \u0d9c\u0dbb\u0dad\u0dc2\u0dca\u0da8\u0dad\u0db0\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0d9c\u0db4\u0dca \u0dc3\u0dca\u0db8\u0dca \u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0bb2\u0b95\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u0bb0\u0bc1\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd\n\n\u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd: \u0b89\u0baf\u0bb0\u0bcd \u0ba8\u0bc0\u0ba4\u0bbf\u0bc8\u0ba9\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bc8\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd TWENTY SECOND AMENDMENT TO THE CONSTITUTION\n\nBILL: PETITIONS TO THE SUPREME COURT \u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0dcf (\u0bc8\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) 2026 \u0d85\u0daf\u0dd0 \u0dca\u0dae\u0dd4 19 \u0dcf\u0dcf 20 \u0daf\u0dd2 \u0db1\u0db1\u0dd2\u0dba \u0db8 \u0dcf \u0daf\u0dda \u0dd2\u0dba\u0daf\u0dda\u0dd9\u0db1 \u0dca\u0dd2\u0db8 \u0dca\u0dc4\u0dcf\u0dca \u0daf\u0db1\u0dca\u0dca\u0db8\u0dca \u0dcf\u0dad\u0db4 \u0d85\u0db8 \u0dad\u0dba\u0dc0 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dca\u0dae \u0dcf \u0daf\u0dda 12111 \u0dc0\u0dba\u0dc0\u0dca\u0dae \u0dcf \u0dc0 \u0dbb\u0dd9\u0dcf \u0dba\u0dc0 \u201c\u0dc0\u0dd2\u0dc3\u0dd2 \u0daf\u0dd9\u0dc0\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dca\u0dae \u0dcf \u0dca\u0dc1\u0daf\u0db0 \u0db1\u0db1 \u201d \u0db1\u0db8 \u0db1\u0dd2\u0dba \u0db1\u0db1\u0dca \u0daf\u0dd9\u0da7\u0dd4\u0db8\u0dca\u0db1\u0dad \u0dca\u0db8\u0dca\u0dcf\u0dca\u0db1\u0daf \u0dca \u0daf\u0dbb\u0dae\u0dc2\u0dca\u0da8\u0dae\u0db0\u0dcf \u0d9a\u0dbb\u0dd9\u0dba\u0da7 \u0daf\u0dc0\u0dad \u0dd2\u0daf\u0dd2 \u0dbb\u0dd2\u0db1\u0dca \u0dd9\u0dba\u0db1 \u0db6\u0dd9 \u0dad\u0dc0\u0dca \u0daf\u0db1\u0dca\u0dca\u0db8\u0dca \u0daf\u0dd9\u0dd9\u0dd9 \u0db4\u0dd2\u0db4\u0db1\u0dca \u0db8 \u0dcf \u0daf\u0dc0\u0dad \u0db6\u0db1\u0db6\u0dd3 \u0d87\u0dd2\u0dba \u0dcf\u0dc0 \u0db1\u0dcf \u0dca\u0dbd\u0dd2\u0daf\u
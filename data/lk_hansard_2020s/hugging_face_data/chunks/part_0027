    "chunk_text": "2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0d9c\u0dda \u0db8\u0dc4 \u0db6 \u0d82\u0d9a\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0dd2\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0dba \u0dbd\u0daf \"\u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a\u0d9a \u0dba\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0d9a \u0dc0\u0dd2\u0dc0\u0dbb\u0da7\u0db1\" \u0d85\u0db1\u0dd4\u0dc0 2022 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db1\u0db4 \u0d9a\u0dcf\u0d9c\u0dca \u0dc2\u0dca\u0da8\u0dc0 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0d9c\u0dda\u0daf\u0dd3 \u0db1\u0db8\u0da7 , - 2026-2027\u0daf\u0dd3\u0dad\u0dca \u0dc0 \u0dd4\u0db8\u0dca \u0dc0 \u0da9\u0dd2\u0dd3\u0db8 \u0dd2\u0dba\u0d9a\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db1 \u0dc1 \u0dad\u0dd2\u0d9a\u0db1 \u0d89\u0dc4\u0dc5 \u0db1\u0dcf\u0d9c\u0dca \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0db1 \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba\u0dc0\u0dcf - \u0d85\u0d9c\u0dca \u0db8\u0dd6\u0dbb\u0dca\u0db1 \u0dc0 \u0dd4\u0db8\u0dca \u0daf\u0dbb\u0dca\u0dc1\u0d9a\u0db1 \u0dc3\u0dd2\u0db1\u0db1\u0db4 70 \u0dc3\u0dd2\u0db4 77.8 \u0daf \u0dc0\u0dcf \u0dc0 \u0da9\u0dd2 \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba\u0dc0\u0dcf. \u0db8\u0dd6\u0dbb\u0dca\u0db1 \u0dc0 \u0dd4\u0db8\u0dca \u0dc0 \u0da9\u0dd2\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dc1\u0db1\u0db1 \u0dc4 \u0dd2\u0dad\u0db1\u0db4 \u0d9c\u0dad\u0dad\u0dca\u0db1\u0dcf\u0db8 14.7 . \u0d9c\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0db1 \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dca\u0d9c\u0dca \u0dbb\u0dcf\u0da2\u0dba \u0d85\u0d82\u0dc1\u0d9c\u0dda. \u0d8a\u0dc5\u0dd9\u0db4, \u0dc0\u0dd2\u0d9a\u0dbb\u0db8\u0dad\u0dca \u0d9c\u0db1\u0dde\u0daf\u0dca\u0d9c\u0dad\u0dd2\u0d9a \u0d85\u0d82\u0dc1\u0d9c\u0dda \u0db8\u0dd6\u0dbb\u0dca\u0db1 \u0dc0 \u0dd4\u0db8\u0dca \u0daf\u0dbb\u0dca\u0dc1\u0d9a\u0db1 \u0dc0 \u0da9\u0dd2 \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba\u0dc0\u0dcf, 2022\u0db4 \u0d9a\u0dcf\u0d9c\u0dca \u0dc2\u0dca\u0da8\u0dc0 \u0dc3\u0dd2\u0db1\u0db1\u0db4 112 \u0dc3\u0dd2\u0db4 119 \u0daf \u0dc0\u0dcf. 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db1\u0db4 \u0d9a\u0dcf\u0d9c\u0dca \u0dc2\u0dca\u0da8\u0dc0 \u0d91\u0dc4\u0dd2 \u0dc3\u0dd2\u0db1\u0db1\u0db4 30\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0db1 \u0d9c\u0db1\u0dca\u0db1\u0dd4\u0dca \u0d9a\u0dbb\u0dba\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda \u0db8, \u0d85\u0dc0\u0dd2\u0d9a\u0dbb\u0db8\u0dad\u0dca \u0d9c\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dad\u0dca \u0db8\u0dd6\u0dbb\u0dca\u0db1 \u0dc0 \u0dd4\u0db8\u0dca \u0daf\u0dbb\u0dca\u0dc1\u0d9a\u0db1 \u0dc3\u0dd2\u0db1\u0db1\u0db4 88.3 \u0dc3\u0dd2\u0db4 \u0dc3\u0dd2\u0db1\u0db1\u0db4 90 \u0daf \u0dc0\u0dcf \u0dc0 \u0da9\u0dd2 \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba\u0dc0\u0dcf. 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db1\u0db4 \u0d9a\u0dcf\u0d9c\u0dca \u0dc2\u0dca\u0da8\u0dc0 \u0d91\u0dc4\u0dd2 \u0dc3\u0dd2\u0db1\u0db1\u0db4 5.1\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0db1 \u0d9c\u0db1\u0dca\u0db1\u0dd4\u0dca \u0d9a\u0dbb\u0dba\u0dc0\u0dcf.\n\n5. \"\u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf \u0dc1 \u0dad\u0dd2\u0d9a\" \u0dc0 \u0da9\u0d9a\u0db4\u0dc4\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db1\u0db8\u0dba\u0dd2 \u0d9c\u0db8\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda\u0dba\u0d9c\u0db1\u0dca \u0d85\u0dc4\u0dbd\u0dcf \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dca\u0d9c\u0dca. \u0db6\u0dab\u0dd4\u0db8\u0dcf\u0dba \u0daf\u0dbb\u0dd2\u0daf\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dc0 \u0d85\u0dc0\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0d89\u0dc0\u0dc4\u0dbd\u0dca \u0dc0\u0dba \u0d9a\u0dad\u0dc2\u0dd2\u0d9a \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0db1\u0dd2\u0dad\u0db1\u0dbd \u0db1\u0dc4\u0dd4\u0d9a\u0d9a\u0dca \u0d9a\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0db1, \u0db1\u0dcf\u0db1\u0dd3\u0db1 \u0da2\u0dbd\u0db1, \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db1, \u0d9a\u0db1\u0dd3\u0db1\u0dcf\u0dbb \u0dc2\u0dca\u0da8\u0d9a \u0db1\u0dc4\u0dd4\u0d9a\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0db1\u0dba\u0dc0\u0dc1\u0dba \u0db1\u0dd2\u0dad\u0db1\u0dbd \u0db1\u0dc4\u0dd4\u0d9a\u0d9a\u0dca \u0d9a\u0dc4 \u0dd2\u0dba\u0dc2\u0dca\u0da8\u0dda\u0db1\u0dcf\u0daf\u0dba \u0dba\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0d9a\u0db1\u0db4 \u0db6\u0dbd\u0db1\u0dcf\u0dba \u0db1\u0dd2\u0dad\u0db1\u0dbd \u0db1\u0dc4\u0dd4\u0d9a\u0d9a\u0dca \u0d9a\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0db1\u0db4 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0dc0\u0dba\u0dcf\u0db1\u0dad\u0dad\u0dd2\u0d9a 15,319 \u0d9c\u0dca \u0dc0\u0dba\u0d9c\u0d9a\u0dcf\u0db4\u0dad\u0dca \u0d85\u0db1\u0dd4\u0db8\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d85\u0dbb\u0dd2\u0db1\u0d9c\u0dbb\u0dca \u0db1\u0dc0\u0dad\u0dd2\u0d9a\u0dba\u0dc0\u0dcf. \u0d91\u0db8 \u0dc0\u0dba\u0dcf\u0db1\u0dad\u0dad\u0dd2\u0d9a \u0d85\u0db1\u0dbb\u0dd2\u0dca \u0dc0\u0dba\u0dcf\u0db1\u0dad\u0dad\u0dd2\u0d9a 9,137 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dbd\u0dcf\u0dd3 \u0dca\u0d9c\u0dda \u0dba\u0daf\u0dcf\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db1\u0dcf\u0daf\u0dba\u0db1\u0db4 \u0d8d\u0da2\u0dd4\u0dc0 \u0d89\u0dc0\u0dc4\u0dbd\u0dca \u0d9c\u0dc0\u0dba\u0dc0\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dd4\u0dc5\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dbd\u0dcf\u0dd3 \u0db1\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 556,422\u0dba\u0dd2.\n\n\u0d9c\u0db8\u0db8 \u0dc0 \u0da9\u0d9a\u0db4\u0dc4\u0dba \u0db1\u0db4\u0d9c\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0d85\u0dc0\u0dc1\u0dba \u0d9c\u0db1 \u0da2\u0dba\u0dcf \u0db8\u0dd6\u0dd2\u0d9a \u0dc0\u0dc1\u0d9c\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf \u0d9a\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba \u0d9a\u0db7\u0dcf \u0db8\u0d9f\u0dd2\u0dca\n\n\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0db1 \u0db8\u0da7\u0dca\u0db4\u0db8\u0dd2\u0dca \u0dc4\u0db3\u0dd4\u0dba\u0dcf\u0d9c\u0d9c\u0dad\u0dba, \u0d91\u0db8 \u0dc0\u0dba\u0dcf\u0db1\u0dad\u0dad\u0dd2\u0d9a \u0d9a\u0db3\u0dc4\u0dcf \u0d85\u0db1\u0dd4\u0db8 \u0dad\u0dd2\u0d9a\u0db1 \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d9c\u0dca \u0dc0\u0dba\u0dc0\u0dd2\u0db4 \u0d92\u0dc0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d85\u0dbb\u0dd2\u0db1\u0d9c\u0dbb\u0dca \u0db1\u0db8\u0dba\u0dd2 \u0db1\u0dc0\u0dad\u0dd2\u0d9a\u0dca\u0d9c\u0dca. \u0d91\u0db8 \u0dc0\u0dba\u0dcf\u0db1\u0dad\u0dad\u0dd2\u0d9a\u0dc0\u0dbd \u0d87\u0d9a\u0dda\u0db1\u0d9c\u0dca\u0dca\u0dad\u0dd4 \u0d9a\u0d9a\u0d9a\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dca\u0db1\u0dcf\u0daf\u0dba \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4, \u0d85\u0daf\u0dcf\u0dc5 \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dad \u0db1\u0dd3\u0dca, \u0d89\u0dbb\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dba\u0daf\u0dd3 \u0dc0\u0dc1\u0d9c\u0db1\u0dca \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dca\u200d \u0dc0\u0dd6 \u0d85\u0dbb\u0dd2\u0db1\u0dbb\u0db1\u0dca \u0db1\u0db4\u0d9c\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dad\u0dd2\u0d9a\u0db1 \u0d85\u0db0\u0dd3 \u0dc2\u0dca\u0da8\u0da7\u0db1 \u0d9a\u0dbb\u0db8\u0dd2\u0dca \u0d89\u0dca\u0dba\u0dc0\u0dcf. 2026.12.31 \u0dc0\u0dba\u0dc0\u0dd2\u0db4 \u0d92 \u0dc3\u0dd2\u0db1 \u0dc0\u0dba\u0dcf\u0db1\u0dad\u0dad\u0dd2\u0d9a\u0dc0\u0dbd \u0dc0 \u0da9\u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dca\u0db6\u0dca\u0db0\u0dca\u200d\u0d9c\u0db1\u0dca \u0d85\u0dd2\u0dba\u0dc0\u0dcf\u0dbb\u0dca\u0db1\u0d9c\u0db1\u0dca\u0db8 \u0dc3\u0dd2\u0db1\u0db1\u0db4 \u0dc3\u0dd2\u0db1\u0db1\u0d9a \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dad\u0dd2\u0d9a\u0db1 \u0d85\u0dad\u0dca\u0db1\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dad \u0db1\u0dd3\u0db8\u0db4 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dcf\u0d9c\u0db1\u0dcf\u0d9c\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0d9c\u0dc0\u0dba\u0dc0\u0dcf."

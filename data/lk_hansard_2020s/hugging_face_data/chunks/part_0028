    "chunk_text": "\u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0d9a\u0dbb\u0dd4\u0dc0\u0dda \u0daf\u0dda\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0\u0db4 \u0db8\u0db8 \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf\u0da7 \u0dba\u0dba \u0da2\u0db1\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dbb \u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dda, \u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0d9a\u0dbb\u0dd4\u0dc0\u0dda, \u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0dd2\u0dba\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0d9a\u0dbb\u0dd4\u0dc0\u0dda, \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0dc4\u0dcf \u0dba\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u0dda\u0db1\u0dda \u0d9a\u0dd0\u0db3\u0dc0\u0dcf \u0dba\u0db8\u0dca \u0dba\u0dc3\u0dc3\u0dca \u0db6\u0dc1\u0daf \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd4\u0dbb\u0dc5\u0dd2\u0dda,- [\u0db6\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca\u0dad] \u0d9c\u0dad\u0dbb\u0dd4 \u0d87\u0db8\u0dd2\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf\u0dba \u0d8b\u0dad\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba \u0db8\u0dad\u0dca\u200d\u0dba\u0dd2 \u0db8\u0db8 \u0dba\u0db8\u0dca \u0d9a\u0dae\u0dcf\u0dc0 \u0d9a\u0dbb\u0dba\u0d9c\u0dad\u0db1 \u0dba\u0dda\u0dba\u0dda\u0db4 \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0da7\u0db8 \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dda\u0dbd\u0dcf \u0dba\u0dc3\u0dc3\u0dca \u0d91\u0d9a replace \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf\u0da7 \u0dc4\u0dcf\u0dd2\u0dba\u0dba\u0d9a\u0dca\u0dad \u0dc0\u0db1 \u0dc4\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0dba\u0db1\u0dcf\u0dc0, \u0d92 \u0d85\u0dba \u0dba\u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0db1 \u0dc4\u0d9a\u0dcf\u0dbb\u0dba\u0da7\u0db4 \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0dbb\u0da7\u0dda \u0d8b\u0dad\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0da7 \u0dba\u0dad\u0dca\u0dbb\u0dd4\u0dab\u0dd4 \u0dc4\u0d9a\u0dcf\u0dbb\u0dba\u0da7\u0dba\u0dd2 \u0db8\u0db8 \u0dba\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dda\u0dba\u0dda, \u0d9c\u0dad\u0dbb\u0dd4 \u0d87\u0db8\u0dd2\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba\u0db4 \u0d92 \u0dd2\u0dba\u0dc3\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dbb \u0dba\u0db8\u0dca \u0dba\u0dc3\u0dc3\u0dca \u0db6\u0dc1\u0dba\u0dc1 replacement \u0d91\u0d9a \u0dba\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dad\u0dd3\u0dbb\u0dd4 \u0db6\u0dbb\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca\u0dad \u0dba \u0dda\u0db1\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0d91\u0dba\u0dd2\u0db1\u0dd4\u0dad\u0dca \u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf \u0dc4\u0dbb\u0d9a\u0dca\u0dad\u0dc2\u0dcf \u0dc0\u0db1 \u0dc4\u0d9a\u0dcf\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8 \u0da7 \u0dc0\u0da9\u0dcf \u0daf\u0dd3 \u0d9d \u0dc0\u0dd2\u0dba\u0dca\u0dba\u0dbd\u0dca\u0dc2\u0dab\u0dba\u0d9a\u0dca\u0dad \u0d85\u0dc0\u0dba\u0dba\u0dba\u0dd2\u0db4\n\n\u0d9c\u0dd4 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0da2\u0dca\u200d\u0dba\u0db1\u0dca\u0dad \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bc6\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0b85\u0ba9\u0bbf\u0bb2\u0bcd \u0b9c\u0baf\u0ba8\u0bcd\u0ba4) (The Hon. (Dr.) Anil Jayantha) \u0d9c\u0dad\u0dbb\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dad\u0dc2 \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0d92 \u0db8\u0dad\u0dd4\u0dbb \u0d9a\u0dbb\u0db4\u0dd4 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc3\u0db8\u0dca\u0db6\u0dda\u0db0\u0dc0 \u0dc3\u0dca\u0dad\u0dd4\u0dbb\u0dd2\u0dba\u0dd2\u0db4 \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0da7\u0db8 \u0d85\u0dba\u0dca \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dca\u200d\u0dcf\u0dc0 \u0dc3\u0dc4 \u0d85\u0dbb\u0db8\u0dd4\u0dab \u0dc0\u0dda\u0dba\u0dda\u0db8 \u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0d9a\u0dbb\u0dd4\u0dc0\u0dda \u0db1\u0d9f\u0dcf \u0dc3\u0dd2\u0dd4\u0db4\u0dc0\u0dd3\u0db8, \u0dd4\u0dc0\u0dd4\u0dda \u0dc4\u0dbb\u0d9a\u0dca\u0dad\u0dc2\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0d92 \u0d85\u0db1\u0dd4\u0dc0, \u0dba\u0db8\u0dca \u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7\u0dad\u0dca \u0d9a \u0db8\u0dcf\u0dda\u0dad\u0dca\u200d\u0d9a\u0dbb\u0dd4\u0dc0\u0dda \u0dc3\u0db8\u0d9f \u0d9c\u0dad\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf \u0d9c\u0dad\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd6\u0dc0\u0dcf\u0db4 \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0dad\u0dca\u200d\u0dc0\u0dad\u0dca \u0d85\u0db4\u0da7 \u0db8\u0d9f \u0dc4\u0dd0\u0dbb\u0dd4\u0dab\u0dd4 \u0d85\u0dba \u0d89\u0dda\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d92 \u0d85\u0dba \u0d91\u0d9a\u0dca\u0dad\u0d9a\u0dad\u0dca \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda, \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0daf\u0dc4\u0dc3\u0dca, \u0dba\u0dba \u0da2\u0db1\u0dcf \u0d85\u0dbb\u0dba\u0d9c\u0dad\u0db1\u0db4 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dba\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0dd2\u0dba\u0db6\u0dda\u0dba\u0dda\u0db4 \u0daf\u0dd0\u0db1\u0da7 HS codes 2,634\u0d9a\u0dca\u0dad \u0dba\u0da7\u0dba\u0dad\u0dca \u0dba\u0db8\u0dca \u0dba\u0dba \u0da2\u0db1\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a \u0dcf\u0db8 \u0d91\u0dba\u0dd2\u0dda \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8 \u0dc3\u0d82\u0dba\u0dda\u0daf\u0dd3 \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dab\u0dca\u0da9\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0dc0\u0db1 Sensitive HS codes 107\u0d9a\u0dca\u0dad \u0dba\u0da7\u0dba\u0dad\u0dca \u0dba\u0db8\u0dca \u0dba\u0dc3\u0dc3\u0dca \u0db6\u0dbb\u0da7 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0db4\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dc3\u0dd2\u0dc1\u0db0 \u0d9a\u0dbb\u0dda\u0dba\u0dda\u0db4 2027, 2028, 2029 \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbd \u0db4\u0dbb\u0dcf\u0dc3\u0dba \u0d87\u0dad\u0dd4\u0dbb\u0dba \u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dc0 \u0dd4\u0dc0\u0dd4\u0dda\u0da7 \u0d85\u0db1\u0dd4\u0d9c\u0dad\u0dad\u0dca\u200d \u0dba\u0dc0\u0dda\u0db1 \u0d85\u0daf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf \u0d9c\u0dad \u0dba\u0d9c\u0dad\u0db1 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0d9a\u0dd2\u0dba\u0dda\u0dba\u0dda, 2027\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 25\u0d9a\u0dca\u0dad, 2028\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 25\u0d9a\u0dca\u0dad \u0dc3\u0dc4 2029\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 50\u0d9a\u0dca\u0dad \u0dc0\u0dba\u0dba\u0dba\u0dda\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8, \u0dad\u0dca\u200d\u0dc0\u0dad\u0dca \u0d85\u0dad\u0dca\u200d\u0dbb\u0db8\u0dd0\u0daf\u0dd2 \u0db7\u0dcf\u0dab\u0dca\u0da9 663\u0d9a\u0dca\u0dad \u0dc3\u0db3\u0dc4\u0dcf 2026\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 50\u0d9a\u0dca\u0dad, 2027\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 25\u0d9a\u0dca\u0dad, 2028\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 25\u0d9a\u0dca\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0dda\u0daf\u0dba\u0d9a\u0da7\u0dba\u0dd2 \u0dba\u0dda\u0dba\u0dda\u0db4 \u0d85\u0dbb \u0dad\u0dd3\u0dbb\u0dd4 \u0db6\u0dbb\u0da7 \u0d85\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca\u0daf\u0dd3\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0dd2 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dba\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0d85\u0db8\u0dd4\u0dbb\u0dc0\u0dba \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dcf \u0db0\u0db1 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dc0\u0dbd\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0db6\u0dd2\u0dda\u0dbb\u0da7\u0dc0\u0dad\u0dca, \u0d85\u0dad\u0dca\u200d\u0dba\u0dc0\u0dba\u0dba \u0dba\u0db1\u0dcf\u0dc0\u0db1 \u0dc3\u0dc4 \u0dd2\u0dba\u0db8\u0dd2 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dc0\u0dbd\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 30\u0d9a \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0da7\u0dad\u0dca \u0dba\u0dda\u0db1 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc0\u0dd0\u0da9\u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0d9c\u0dad\u0dbb\u0dd4 \u0dd2\u0dba\u0dba\u0dba \u0da2\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dd2\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba\u0dd2\u0dba\u0db4"

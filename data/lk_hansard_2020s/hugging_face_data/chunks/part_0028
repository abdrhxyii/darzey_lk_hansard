    "chunk_text": "\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0dba\u0db8\u0d9c\u0dad\u0dcf\u0dba\u0dc0\u0dcf\u0da7 160\u0d9a \u0db4\u0dc1\u0db0\u0dd2\u0dba \u0dbd\u0db6\u0db1 \u0db8\u0dcf\u0dc3\u0dba \u0d85\u0dc0\u0dc3\u0dda \u0dba\u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0db4\u0dc1\u0db0\u0dd2\u0dba\u0da7 \u0d91\u0d9a\u0dad\u0dd4\u0dbb \u0d9a\u0dbb \u0d9c\u0dad\u0dda\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dbd\u0dd0\u0dba\u0db6\u0dba\u0dd2\u0db4 \u0dba\u0db8\u0d9c\u0dad\u0dcf\u0dba\u0dc0\u0dcf\u0da7 250\u0d9a \u0dba\u0da7\u0dda\u0da9\u0dbb\u0dba \u0dc3\u0dcf \u0dae\u0d9a\u0dc0 \u0d85\u0dc0\u0dc3\u0dda \u0dc0\u0dd4\u0dab\u0dcf\u0db4 \u0d9c\u0dad\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0da7\u0db8 \u0dba\u0db8\u0dca \u0dba\u0dc0\u0dbd\u0dcf\u0dba\u0dda \u0dc3\u0db3\u0dc4\u0dda \u0d9a\u0dbb\u0dda\u0db1 \u0d95\u0db1 , \u0dba\u0db4\u0dbb \u0dbd\u0db6\u0dcf \u0d9c\u0dad\u0dad\u0dca \u0dba\u0db8\u0d9c\u0dad\u0dcf\u0dba\u0dc0\u0dcf\u0da7 160\u0d9a \u0db6\u0dd0\u0da7\u0dbb\u0dd2 \u0db4\u0dc1\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0daf\u0dcf \u0dba\u0da7\u0dda\u0da9\u0dbb\u0dba\u0dda \u0db8\u0dd2\u0dbd \u0d9c\u0dad\u0dab\u0dda\u0dc0\u0dbd\u0da7 \u0dc0\u0da9\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 10\u0d9a\u0dca\u0dad \u0d85\u0da9\u0dd4 \u0db8\u0dd2\u0dbd\u0d9a\u0dd2\u0dda \u0dba\u0db8\u0dca \u0dba\u0da7\u0dda\u0da9\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dd2\u0dbd \u0d9c\u0dad\u0dab\u0dda, \u0dbd\u0d82\u0dc3\u0dd4 \u0dbd\u0db6\u0dcf \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf \u0dd2\u0dba\u0db6\u0db1 \u0db6\u0dc0\u0db4 \u0dc3\u0db8\u0dc4\u0dbb commission\u0dc0\u0dd2\u0dda \u0dba\u0db8\u0dca\u0dba\u0d9a\u0dca\u0dad market \u0d91\u0d9a\u0da7 \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 signal \u0d91\u0d9a\u0d9a\u0dca\u0dad \u0dbd\u0db6\u0dcf \u0dba\u0daf\u0dda\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a \u0dad\u0dca, \u0d89\u0dad\u0dca\u200d\u0dcf \u0dba\u0dc4\u0dcf\u0db3 \u0db8\u0dd2\u0dbd\u0d9a\u0dca\u0dad \u0dbd\u0db6\u0dcf \u0d9c\u0dad\u0dda\u0db1 \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dd2\u0dba\u0dc3\u0dcf \u0dba\u0db8\u0d9c\u0dad\u0dcf\u0dba\u0dc0\u0dcf\u0da7 150\u0d9a \u0db6\u0dd0\u0da7\u0dbb\u0dd2 \u0db4\u0dc1\u0db0\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0dba\u0da7\u0dda\u0da9\u0dbb\u0dba \u0dc3\u0dd0\u0dca \u0dad\u0dca\u200d\u0dd0\u0db8\u0dca\u0db6 \u0db8\u0dcf\u0dc3\u0dba\u0dda 24\u0dc0\u0dd0\u0dd2\u0dba \u0daf\u0dcf \u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u0dca\u200d \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8, \u0dba\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba \u0dba\u0dda\u0d9c\u0dad\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 2027 \u0db8\u0dcf \u0dad\u0dd4\u0dbb \u0db8\u0dcf\u0dc3\u0dba\u0da7 \u0dba\u0db4\u0dbb \u0dba\u0db8\u0dca \u0db6\u0dd0\u0da7\u0dbb\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dad\u0dca\u200d\u0dcf\u0d9a\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0db4\u0dc1\u0db0\u0dd2\u0dba\u0da7 \u0d91\u0d9a\u0dad\u0dd4\u0dbb \u0d9a\u0dbb \u0d9c\u0dad\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0d9a\u0dbb\u0dda\u0db1 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dcf\u0dba\u0db4\u0dcf\u0dba\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0dbb \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd2\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dad\u0dad\u0dca\u200d \u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db4\u0dcf \u0dba\u0dca\u0dc0 \u0dc3\u0db8\u0d9f \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0d89\u0dc4 \u0dba\u0db4\u0dba \u0dca \u0d85\u0dda\u0dad\u0dca\u200d \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dba \u0d9a\u0db8\u0dd2\u0dd4\u0db4\u0dc0\u0d9a\u0dca\u0dad \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbd\u0db6\u0db1 \u0dc3\u0dd2\u0dba\u0dda \u0d9a\u0dd0\u0db6\u0dd2\u0db1\u0da7 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0da7 \u0dba\u0dba \u0da2\u0db1\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dc4\u0dbb\u0dc4\u0dcf \u0d85\u0db4\u0dd2\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dbd\u0dd0\u0dba\u0dda\u0dc0\u0dd2, \u0dba\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0d89\u0dad\u0dca\u200d\u0dcf \u0dba\u0dda\u0d9c\u0dad\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0dda\u0db1\u0db4\n\n\u0d92 \u0dc0\u0dcf\u0dba \u0db8, \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba emergency tender \u0d91\u0dba\u0d9a\u0dca\u0dad \u0d85\u0dc0\u0dc3\u0dda \u0d9c\u0dad\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0db1\u0dd0\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d85\u0dba\u0d9c\u0dad \u0dc3\u0dca\u0dad\u0dd4\u0dbb \u0db8\u0dcf\u0dc3\u0dba\u0dda 4\u0dc0\u0dd0\u0dd2\u0dba \u0daf\u0dcf \u0d9c\u0dad\u0dad\u0dca\u0dba\u0dad\u0dca\u0db4 \u0d85\u0db4\u0dd2\u0da7 \u0dc0\u0dcf \u0dad\u0dca\u200d\u0dcf \u0dba\u0dc0\u0dbd\u0dcf \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf, \u0d91\u0dc4\u0dd2 \u0dba\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dad\u0dba\u0da7\u0dcf\u0dda \u0d91\u0d9a\u0d9a\u0da7 \u0d9a\u0dd2\u0dba\u0dbd \u0d9a\u0dd0\u0dbd\u0dbb\u0dd2 6,000\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0dd2 \u0d85\u0d9c\u0dad\u0dba\u0d9a\u0dd2\u0dda \u0dc0\u0dd2\u0dbb\u0da7\u0dd2\u0dba \u0da2\u0db1\u0db1\u0dba \u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dad\u0dca\u200d\u0db1\u0dc0\u0dcf, \u0d92 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dad\u0d9a \u0dc0\u0dd2\u0dba\u0dba\u0dca\u0dc2\u0dba\u0dba\u0dda 2026\u0daf\u0dd3 \u0dba\u0db8\u0dca \u0d91\u0dbd\u0dca \u0dd2\u0dba\u0dba\u0db1 \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dd2\u0dba\u0dc3\u0dcf \u0d85\u0db4\u0dd2\u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0db6\u0dbd\u0db4 \u0db8\u0d9a\u0dca\u0dad \u0dba\u0dc0\u0dda\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0db4\n\n\u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0d9a\u0dd2\u0dba\u0dda\u0db1 \u0d95\u0db1 \u0dad\u0dca\u200d\u0dc0\u0dad\u0dca \u0db4\u0dd4\u0d82\u0da0\u0dd2 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0da7\u0db8 \u0d85\u0db4\u0dd2\u0da7 \u0db6\u0dbd\u0dcf\u0dba\u0db4\u0dcf\u0dba\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0dbb \u0dba\u0dc0\u0da0\u0dca\u0da0 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0dd2 \u0dc0 \u0dc2\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dbd\u0dd0\u0db6\u0dd2\u0da0\u0dca\u0da0 \u0dd2\u0dba\u0dc3\u0dcf, \u0d85\u0db4\u0dd2\u0da7 \u0dc0\u0dd2\u0dbb\u0da7\u0dd2\u0dba \u0da2\u0db1\u0db1\u0dba\u0dda \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0da7 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda \u0dd2\u0dba\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0dcf \u0dad\u0dd4\u0dbb\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dbb\u0da7\u0dd2\u0dba \u0db8\u0dd2\u0dbd \u0dc0\u0dd0\u0dd2\u0dc0\u0dd3\u0db8\u0d9a\u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0d9a \u0d89\u0dbd\u0dca\u0db1 \u0db8\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0dda\u0db1 \u0db6\u0dbd\u0dcf\u0dba\u0db4\u0dcf\u0dba\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0dbb \u0dba\u0dc0\u0dda\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dad\u0dca \u0db8\u0dad\u0dca\u200d\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8, \u0db6\u0dbd\u0dba\u0d9a\u0dca\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dba\u0dba \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0dba\u0dc1 \u0db8\u0dd4\u0dbd\u0dca \u0db8\u0dcf\u0dc3 \u0dad\u0dd4\u0dbb\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dbb\u0da7\u0dd2\u0dba \u0da2\u0db1\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc0\u0dd2\u0dbb\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d85\u0d9b\u0dab\u0dca\u0da9\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dba\u0d9c\u0dad\u0db1 \u0dba \u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dba\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf \u0d9c\u0dad \u0d85\u0dbb\u0dba\u0d9c\u0dad\u0db1 \u0dd2\n\n\u0dba\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dad\u0dca \u0db8\u0dad\u0dca\u200d\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0dda\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dba\u0dd2\u0db4"
  },

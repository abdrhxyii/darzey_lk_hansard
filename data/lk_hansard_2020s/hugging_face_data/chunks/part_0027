    "chunk_text": "\u0dad\u0dda\u0dda\u0dc3\u0d9c\u0dbb\u0dd4\u0dc3 \u0dd2\u0d9a\u0dad\u0dca\u0dc3\u0d89\u0dca\u0daf\u0dd2 \u0dc3\u0dcf\u0dca\u0dd3\u0dcf\u0daf\u0dc3\u0d8a\u0dda\u0dda\u0dc3\u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc3 \u0dc5\u0daf,\u0dc3\u0dad\u0dda\u0dda\u0dc3\u0d86\u0dab\u0dca\u0dbd\u0dca\u0dc0\u0dca\u200d\u0dc3\u0d86\u0dda \u0ddd\u0d9c\u0dba\u0daf\u0dc3\u0dc3\u0dd4\u0dc0\u0dca\u200d\u0dad\u0daf\u0dc3\u0dcf\u0db0\u0dba\u0dca\u0dae\u0dcf\u0daf \u0dc3\u0dc4 \u0dc4\u0daf\u0dc3 \u0dca \u0dc3\u0d9a \u0dc3\u0dda\u0dda\u0dc3\u0db4\u0dd2\u0dd2\u0db6\u0db6\u0dc4\u0dc0\u0dca\u200d.\u0dc3\u0dcf\u0da7\u0dc3\u0d92 \u0da7\u0dc3\u0d8b\u0dcf\u0daf\u0dc4 \u0dab\u0d9a\u0dca\u0dc2\u0dc3\u0dda\u0dcf\u0dca \u0dc3\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0dca.\u0dc3\u0dad\u0db4\u0dd2\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d \u0dda \u0daf\u0da7\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda\u0dd6 \u0dc0\u0dca\u200d,\u0dc3\u0dad\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0d9a,\u0dc3\u0dcf\u0dc5\u0dcf\u0daf\u0dc0\u0dca\u200d\u0dad\u0dca\u0dad\u0dc3\u0dda \u0daf\u0da8\u0dcf\u0dc3\u0daf\u0dca\u0dda\u0dda\u0dc3\u0d9c\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dc3\u0db1\u0dd2\u0dbd\u0db0\u0daf\u0dbb\u0dd2\u0dc3\u0dda \u0daf\u0da8\u0dcf\u0dc3\u0daf\u0dca\u0dc33 \u0da7\u0dc3-\u0dc3\u0dad\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0d9a\u0dc3\u0d8b\u0dad\u0dd4\u0db8 ,\u0dc3\u0dad\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0d9a\u0dc3\u0dcf\u0dd4\u0dab\u0dc3\u0dca\u0dc4\u0dc3 \u0daf \u0d82\u0db4\u0dd2\u0da7\u0dd2\u0d9a\u0dc3\u0d9a\u0dd2\u0d9a \u0dc3\u0dda \u0daf\u0da8\u0dcf\u0dc3\u0daf\u0dca\u0dc3\u0dad\u0dd4\u0db8 \u0da7\u0dc3-\u0dc3\u0d86\u0dda \u0ddd\u0d9c\u0dba\u0daf\u0dc3\u0dc3\u0dd4\u0dc0\u0dca\u200d\u0dad\u0daf\u0dc3\u0dcf\u0db0\u0dba\u0dca\u0dae\u0dcf\u0daf \u0d9a\u0d9a\u0dca\u0dc2\u0dc3\u0dca \u0dca\u0dae\u0dc3 \u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d91\u0dc4\u0dd2\u0dc3\u0da2 \u0d9c\u0dc4 \u0d9a\u0dc38,842\u0dba\u0dd2.\u0dc3\u0d91\u0dc4\u0dd2\u0dc3\u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dca\u0dc3\u0dca\u0d82\u0d9b\u0dba\u0daf\u0dc0\u0dca\u200d\u0dc32,640\u0d9a\u0dca\u0dc2\u0dc3\u0dda\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d91\u0dcf\u0dc3\u0dda \u0daf\u0da8\u0dcf\u0dc3\u0daf\u0dca\u0dda\u0dda\u0dc3\u0da2\u0dd3\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d \u0dc3\u0da2 \u0dad\u0daf\u0dc0\u0dca\u200d\u0da7\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dc1\u0dba\u0dc3 \u0dc3\u0db8\u0dd6\u0dd2 \u0dc3\u0dda\u0dca\u0dde\u0d9b\u0dba\u0dc3\u0dda\u0dca\u0dae\u0dc0\u0dca\u200d\u0daf\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dca\u0dd0\u0db4\u0dba\u0dd3\u0dcf\u0dc3\u0dad\u0dcf\u0dba\u0dd2\u0dc3\u0dad\u0db4\u0dd2\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0d86\u0dda \u0ddd\u0d9c\u0dba\u0daf\u0dc3\u0dc3\u0dd4\u0dc0\u0dca\u200d\u0dad\u0daf\u0dc3\u0dcf\u0db0\u0dba\u0dca\u0dae\u0dcf\u0daf \u0dda\u0d9a\u0dca\u0dc3 \u0dca\u0dda\u0dca.\n\n\u0d89\u0dc4\u0dad\u0dc3\u0dcf\u0daf\u0dc3\u0dca\u0dc4\u0dc4\u0dca\u0dc3 \u0dc5\u0dc3\u0d86\u0dda \u0ddd\u0d9c\u0dba\u0daf\u0dc3\u0dc3\u0dd4\u0dc0\u0dca\u200d\u0dad\u0daf\u0dc3\u0dcf\u0db0\u0dba\u0dca\u0dae\u0dcf\u0daf \u0d9a\u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0d92\u0dc3\u0dda \u0daf\u0da8\u0dcf\u0dc3\u0daf\u0dca\u0dda\u0dda\u0dc3\u0da2\u0dd3\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc3\u0dc0\u0dca\u200d \u0dc3\u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dc3\u0dda\u0dcf\u0dcf\u0dc4\u0dca\u0dae\u0dc3\u0d9c\u0dab \u0dc38,800 \u0da7\u0dc3\u0d86\u0dca\u0dca \u0dc3\u0da2 \u0dad\u0daf\u0dc0\u0dca\u200d\u0dc3\u0dc3\u0dd2\u0d9a\u0dbd\u0dd4\u0dc3\u0dda\u0dcf \u0daf\u0dc3\u0dd2\u0d9a\u0daf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0dc3 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92 \u0dc3\u0dad\u0dcf\u0dba\u0dd2\u0dc3\u0d8a\u0da7\u0dc3\u0dad\u0dcf\u0daf\u0dc5\u0dc3\u0dcf\u0dc4\u0da2 \u0dc3\u0dda\u0dca\u0dde\u0d9b\u0dba\u0dc3\u0dda\u0dc4\u0dcf\u0dc3\u0db1\u0dd2\u0dbd\u0db0\u0daf\u0dbb\u0dd2\u0db1\u0dd2\u0d9a\u0dda - PHNO\u0dda \u0dc3-\u0dc3\u0db8\u0dd6\u0dd2 \u0dcf\u0dc3 \u0daf\u0d9a\u0d9a\u0d9a\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca\u0dda\u0dca.\u0dc3\u0d8a\u0da7\u0dc3\u0db4\u0dc3\u0dd4\u0dc0\u0dca\u200d\u0dc3\u0d92\u0dc3\u0dd2\u0d9a\u0daf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0dc3 \u0dc3\u0dad\u0d9a\u0dc3\u0dad\u0dad \u0dc3\u0d89\u0dca \u0dc3\u0dda\u0db6\u0ddd\u0dc3\u0dda \u0daf\u0dc0\u0dca\u200d \u0dc3\u0dda \u0ddd\u0d9c\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc3\u0dda \u0ddd\u0d9c\u0dd3\u0dad\u0dca\u0dc3\u0dad\u0db4\u0dd2\u0dc3\u0dc4\u0db3\u0dd4 \u0daf\u0dc3\u0d9c\u0dca \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dd2\u0d9a\u0daf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0dc3 \u0dc5\u0dc3\u0dad\u0d9a\u0dc3\u0dad\u0db4\u0dd2\u0dc3 \u0dd0\u0dc4\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0dad\u0dda\u0dda\u0dc3\u0dc3\u0dd4\u0dc0\u0dca\u200d\u0dad\u0daf\u0dc3\u0dcf\u0db0\u0dba\u0dca\u0dae\u0dcf\u0daf \u0d9a\u0da7.\u0dc3 \u0dd0\u0dc4\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc3\u0d92\u0dc3\u0dad\u0d9a\u0da7\u0dc3\u0dcf\u0dd0 \u0da7\u0dc3\u0dda\u0db6\u0ddd\u0dc3\u0dda \u0daf\u0dc0\u0dca\u200d \u0dc3\u0dda \u0ddd\u0d9c\u0dc3\u0dd2\u0dbb\n\n\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf\u0dc3 \u0db8\u0dca,\u0dc3\u0dad\u0db4\u0dd2\u0dc3\u0d92\u0dc3\u0db4\u0dd2\u0dd2\u0db6\u0db6\u0dc4\u0dc0\u0dca\u200d\u0dc3\u0db4\u0dc3\u0dd4\u0dc0\u0dd2\u0db4 \u0dcf\u0d9a\u0dca\u0dc2\u0dc3- follow-up \u0d91 \u0d9a\u0dca\u0dc2\u0dc3-\u0dc3 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dda\u0d9c\u0daf\u0dbd\u0dca\u0dbd\u0dca\u0da7\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dc1\u0dba\u0dc3 \u0dc3\u0d8b\u0db4\u0dda\u0dcf\u0dca\u0dae\u0dc3\u0dca\u0db4\u0d9a \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0d8b\u0dc3\u0db4\u0dda\u0dda\u0dc1 \u0d9a\u0dc3\u0dca\u0db4\u0d9a \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dc1\u0dba\u0dc3 \u0dc3\u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dc2\u0dab\u0dc3 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3\u0d92\u0dda\u0d9c\u0daf\u0dbd\u0dca\u0dbd\u0dca\u0dc3\u0dad\u0dcf\u0daf\u0dc5\u0dc3\u0dda \u0ddd\u0dc4\u0dbd\u0dca\u0dc0\u0dca\u200d\u0dbd\u0da7\u0dc3refer \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3\u0dad\u0db4\u0dd2\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dc0\u0dca\u200d\u0dbd\u0dc3\u0dad\u0dbd\u0dd4\u0dd2\u0dbb\u0dca\u0dc3\u0dc4\u0db3\u0dd4 \u0daf\u0dc3\u0d9c\u0dca \u0daf\u0dc3\u0dca\u0dd0 \u0dc3\u0dc4\u0dd2\u0dda\u0dad \u0dc3\u0dda \u0ddd\u0d9c\u0dd3\u0dad\u0dca\u0da7\u0dc3screening programmes \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0d92\u0dc3\u0dda\u0d9c\u0daf\u0dbd\u0dca\u0dbd\u0dca\u0dda \u0dc3\u0dda \u0ddd\u0d9c\u0dc3\u0dc4\u0db3\u0dd4 \u0daf\u0dc3\u0d9c\u0dca .\u0dc3\u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3\u0d92\u0dc3\u0dad\u0dc0\u0dca\u200d\u0da7\u0dc3\u0d89\u0dca \u0dc3\u0da2 \u0dad\u0daf\u0dc0\u0dca\u200d\u0dda \u0dc3\u0dc3\u0dd4\u0dc5\u0dd4\u0dc3\n\n1297 1298\n\n2026 \u0dca\u0dd0\u0dda\u0dad\u0dd0\u0db8\u0dca\u0db6\u0d9a\u0dc3\u0dc310\u0dc3\n\n\u0dda \u0ddd\u0d9c\u0dc0\u0dca\u200d\u0dbd\u0da7\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0dcf\u0db0\u0dba\u0dca\u0dae\u0dcf\u0daf \u0dc3\u0dcf\u0d9f\u0dd2\u0dca\u0dc3\u0dca\u200d\u0dbb\u0dd2\u0dbb \u0daf \u0dc3 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0dda\u0d9c\u0daf\u0dbd\u0dca\u0dbd\u0dca\u0dda \u0dc3\u0d91\u0daf\u0dd2\u0dda \u0dcf\u0daf\u0dc3\u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dda\u0dda\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dc1\u0dba\u0dad\u0daf\u0dc0\u0dca\u200d\u0dbd\u0da7\u0dc3\u0dad\u0db1\u0dd4\u0dc0\u0dca\u200d\u0dc3\u0dad\u0db4\u0dd2\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0dc3\u0dd4\u0dc0\u0dca\u200d\u0dad\u0daf\u0dc3\u0dcf\u0db0\u0dba\u0dca\u0dae\u0dcf\u0daf \u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0dca\u200d\u0dbb\u0dd2\u0dbb \u0daf \u0dc3 \u0dc0\u0dca\u200d\u0daf.\u0dc3"
  },

u0bae\u0bbe\u0ba9 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0bb9\u0bbe\u0bbf\u0ba9\u0bbf \u0b85\u0bae\u0bb0\u0b9a\u0bc2\u0bbe\u0bbf\u0baf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b92\u0bb0\u0bc1 \u0bae\u0bbe\u0ba4 \u0b95\u0bbe\u0bb2 \u0b85\u0bb5\u0b95\u0bbe\u0b9a\u0bae\u0bcd \u0b9a\u0b95\u0bbe\u0bbe\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0bbe\u0bb0\u0bcd.\n\n\u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb\u0d9c\u0db8 \u0d9c\u0dd2\u0dc4\u0dc3\u0dca\u0dae \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc3\u0d82\u0dbb\u0dca\u0dbb\u0dca\u0dab\u0dba \u0d85\u0dc3\u0dbd \u0d87\u0dad\u0dd2\n\n\u0d9a\u0dc3\u0dc5 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0db8\u0d9c\u0db8\u0dca \u0db8\u0db0\u0dcf\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba: \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\n\n\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0b95\u0bae, \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0b95\u0bb3\u0baf\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0b95\u0b9f\u0bcd\u0b9f\u0b9f\u0ba4\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0bb4\u0bbf\u0bb5\u0bc1 \u0b9a\u0b9a\u0b95\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0bc1\n\n\u0ba8\u0bbf\u0b95\u0bb2\u0baf\u0bae\u0bcd: \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd WASTE COLLECTION CENTRE ADJACENT TO INDOOR SPORTS\n\nCOMPLEX, BANDARAGAMA: DETAILS\n\n2183/2026 2. \u0d9c\u0dbb\u0dd4 \u0d85\u0da2\u0dd2\u0dad\u0dca \u0db4\u0dd3. \u0d9c\u0db4\u0d9c\u0dbb\u0dca\u0dbb\u0dcf \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0baa\u0bc0. \u0baa\u0baa\u0b9a\u0bb0\u0bb0\u0bbe) (The Hon. Ajith P. Perera) \u0dbb\u0dc1\u0da2\u0dba \u0db1\u0db4\u0dad\u0db1\u0dc1\u0d9a\u0db1 \u0db1\u0dc5\u0dc1 \u0db8 \u0dc3\u0da2\u0dc1 \u0dc3\u0dc4 \u0db1\u0dc5\u0dc1 \u0db8 \u0db1\u0dc1\u0d9a\u0db1 \u0d85\u0db8\u0dc1\u0db1\u0dba\u0dad\u0dd4\u0db8\u0dc1\u0d9c\u0dd0\u0dca \u0d87\u0dc3\u0dd6 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0db1 - ( )\n\n(\u0d85) (i) \u0d9a\u0dc5\u0dd4\u0db1\u0dbb \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0d9c\u0dad \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dc1\u0dbb\u0dd0\u0db8 \u0da7\u0db4 \u0dba\u0da7\u0dd2 \u0dc5\u0d9a\u0dc5\u0dd4\u0db1\u0dbb \u0daf\u0dd2\u0dc3\u0dda\u0db1 \u0dbb\u0dd2\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dc1 \u0dc3\u0dcf\u0d9a\u0dd3\u0dbb\u0dca\u0dbd\u0dda \u0db4\u0dbd \u0dc1\u0dcf\u0dd9 \u0db8\u0dd3\u0db4 \u0d9c\u0db1\u0dbb \u0dc5\u0dcf\u0dab\u0dca\u0da9\u0da9\u0dc1\u0dbb\u0dd0\u0db8 \u0dc3\u0dad\u0dd2\u0d9a \u0d9c\u0db1\u0dc1\u0dc5\u0dbd \u0db1\u0db1 \u0dad\u0dd2\u0d9a \u0db1\u0db4\u0dad\u0dbb\u0d9c\u0dad \u0d9a\u0dc3\u0dc5 \u0d91\u0d9a\u0dca\u0dbb\u0dd0\u0dc3\u0dda \u0d9a\u0dbb\u0db8\u0dd2\u0dca \u0db1 \u0dad\u0dd2\u0d9a\u0db1 \u0dcf \u0dd9\u0dca\u0d9c\u0dca\u0dd9;\n\n(ii) \u0d91\u0db8 \u0db1\u0db4\u0dad\u0dbb \u0dad\u0dd4\u0dc5 \u0d9a\u0dc3\u0dc5 \u0d91\u0d9a\u0dca\u0dbb\u0dd0\u0dc3\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4\n\n\u0d9a\u0dcf\u0db1 \u0d86 \u0db1\u0db1 \u0d9a \u0d9c\u0dbb\u0dca\u0dbd\u0dd9;\n\n(iii) \u0db1\u0db4\u0dad\u0dbb \u0dad\u0dd4\u0dc5 \u0d9a\u0dc3\u0dc5 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0dca \u0db8\u200d\u0dba\u0dc3\u0dda\u0dae\u0dc1\u0db1 \u0d9a\u0dca \u0db1 \u0db8 \u0dc1\u0d9c\u0dd0\u0db1 \u0dc1\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0d85 \u0db1\u0dba \u0d85\u0db1\u0dd4\u0db8\u0db1\u0dad\u0dd2\u0d9a \u0dca \u0d9a\u0dcf\u0dc1 \u0d9c\u0dd0\u0db1 \u0dad\u0dd2\u0d9a\u0d9c\u0dda\u0dd9;\n\n(iv) \u0d9c\u0db1\u0dc1\u0d91\u0d9c\u0dc3\u0dda \u0db1\u0dca \u0d8a\u0db4 \u0d9c\u0dc4\u0dda\u0dad\u0dd4 \u0d9a \u0d9c\u0dbb\u0dca\u0dbd\u0dd9;\n\n\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0db8\u0db8 \u0dc3\u0da2\u0dc1 \u0db4 \u0dd9\u0dca \u0dca\u0d9c\u0dca\u0dd9?\n\n(\u0d86) \u0d91\u0db8 \u0d9a\u0dc3\u0dc5 \u0d91\u0d9a\u0dca\u0dbb\u0dd0\u0dc3\u0dda \u0d9a\u0dbb\u0db1 \u0dc3\u0dda\u0dae\u0dc1\u0db1\u0d9c\u0dad \u0dc3\u0dd2\u0db4 -\n\n(i) \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dc1\u0dbb\u0dd0\u0db8 \u0dd0\u0dad\u0dc4\u0dc3\u0dda\u0dae \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dc1\u0dd0\u0dc1\u0dbb \u0db4 \u0d87\u0dad\u0dd2\u0d9a \u0daf\u0dd4\u0dbb;\n\n(ii) \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dc1\u0dbb\u0dd0\u0db8 \u0da7\u0db4 \u0dba\u0db1\u0dd4\u0dca \u0db1\u0db4\u0dc1\u0d9a \u0db4 \u0d87\u0dad\u0dd2\u0d9a \u0daf\u0dd4\u0dbb;\n\n(iii) \u0da2\u0dc1\u0dad\u0dd2\u0d9a\u0d9a \u0da2\u0d9a \u0dc3\u0dca\u0db1\u0dc1\u0dd9\u0db1 \u0dc4\u0dc1 \u0da2\u0d9a\u0dc1\u0db1 \u0dc4\u0db1 \u0db8\u0dab\u0dca\u0da9\u0da9\u0d9a \u0db4 \u0d85 \u0db8 \u0db1\u0db4\u0dad\u0dbb \u0db4 \u0d87\u0dad\u0dd2\u0d9a \u0daf\u0dd4\u0dbb;\n\n(iv) \u0dc0\u0dd2 \u0dad\u0db1 \u0dba\u0dc1 \u0dc1\u0db8 \u0db8\u200d\u0dba\u0dc3\u0dda\u0dae\u0dc1\u0db1 \u0db4 \u0d87\u0dad\u0dd2\u0d9a \u0daf\u0dd4\u0dbb;\n\n\u0d9c\u0d9a\u0dc1\u0db1\u0db8\u0dda\u0dd9 \u0dca\u0db1 \u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0db8\u0db8 \u0dc3\u0da2\u0dc1 \u0db4 \u0dd9\u0dca \u0dca\u0d9c\u0dca\u0dd9?\n\n(\u0d87) \u0d9c\u0db8\u0d9c\u0d9a\u0dc3 \u0d85\u0db1 \u0dc3\u0dbb\u0d9c \u0dca \u0db1 \u0db8 \u0dc1\u0d9c\u0dd0\u0db1 \u0db1\u0dd4 \u0d9a\u0dcf\u0db1 \u0d9a\u0dc3\u0dc5\n\n\u0d91\u0d9a\u0dca\u0dbb\u0dd0\u0dc3\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0dca \u0db8\u200d\u0dba\u0dc3\u0dda\u0dae\u0dc1\u0db1 \u0d9c\u0dc4\u0dda\u0dad\u0dd4\u0d9c \u0dca \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dc1\u0dbb\u0dd0\u0db8 \u0dd0\u0dad\u0dc4\u0dc3\u0dda\u0dae \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dc1\u0dcf\u0dd0\u0dda\u0d9c\u0dad \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0db8\u0dda\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0da2\u0dc1\u0dad\u0dd2\u0d9a\u0d9a \u0d9c\u0db1\u0da7\u0dca\u0d9c\u0dcf \u0dbd\u0dca \u0d9a\u0dab\u0dca\u0da9\u0da9\u0dc1 \u0db8 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d91\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dc1\u0dcf\u0dd0\u0dda \u0db1\u0db4\u0dad\u0dc4\u0dbb\u0dda \u0d9a\u0dbb\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0d9a \u0dca \u0db8\u0dd4\u0dc4\u0dd4\u0dda\u0daf\u0dd3 \u0d87\u0dad\u0dd2\u0d9a \u0d9c\u0dc3\u0dde\u0d9b\u0dba \u0dd0\u0db1\u0db4\u0dbd\u0dd4 \u0dc3\u0dca\u0dcf\u0dca\u200d\u0d9c \u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0d9a\u0dd9 \u0dd9\u0db1\u0db1\u0dd4\u0dca\u0daf\u0dd3\u0dca \u0d9a\u0db4 \u0d85\u0db1\u0dd4 \u0d9c\u0dd0\u0db1 \u0d87\u0dad\u0dd2\u0d9a \u0da7\u0db4 \u0dbb \u0d9a \u0d9c\u0dbb\u0dca\u0dbd\u0dd9 \u0dca\u0db1 \u0db1 \u0daf\u0dd4\u0dbb\u0db4 \u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0db8\u0db8 \u0dc3\u0da2\u0dc1 \u0db4 \u0dd9\u0dca \u0dca\u0d9c\u0dca\u0dd9?\n\n(\u0d88) \u0d9c\u0db1\u0dc1\u0d91\u0d9c\u0dc3\u0dda \u0db1\u0dca \u0db8\u0dca\u0dd9?\n\n\u0baa\u0baa\u0bbe\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb0\u0bc1\u0bb5\u0bbe\u0b95, \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0b95\u0baa\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0b95\u0bb0\u0b95\u0bcd \u0b9a\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:"

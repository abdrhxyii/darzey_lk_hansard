    "chunk_text": "\u0db1\u0dd4 \u0dbb\u0d91\u0dc5\u0dd2 \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0d9c\u0dad \u0d9c\u0db1\u0dc1\u0dd2\u0db1\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dc1\u0db1 28\u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0d9c\u0dca \u0d9c\u0db1\u0dc1\u0dd2\u0db1\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dc1\u0db1 28 \u0dad\u0dd4\u0dc5 \u0d91\u0d9a \u0dd9 \u0dc3\u0d9a\u0daf\u0dd2 \u0d9c\u0dca \u0dc1\u0dc4\u0db1 \u0da7\u0dd2\u0d9a check \u0d9a\u0dbb\u0dca\u0db1 \u0dd0 \u0db8\u0d9c\u0db1\u0dc1 \u0db8 \u0dc1\u0d9c\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2\u0d9a \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0d9a \u0d9c \u0dd0\u0dba\u0db1\u0dc1 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0d9a check \u0d9a\u0d9c\u0dc5\u0dc1 \u0db8 \u0d85\u0db1\u0dd2 \u0dc1\u0dbb\u0dca\u0dbd \u0d9c \u0dca \u0dc1\u0d9c \u0dca \u0dc3\u0dd2 \u0db4 ] \u0d9a\u0db4 \u0db1\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0d9a\u0dca \u0db8\u0dc1\u0dbb\u0dca\u0dbd\u0dd0\u0d9c\u0dad \u200d\u0dc1 \u0db1 \u0db4 \u0db8 \u0db8\u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1 \u0db4 \u0d9c \u0dc1\u0dd9 \u0dca\u0db1 \u0db8 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0dc1 \u0d9c\u0db1\u0dc1\u0d9c \u0db1\u0dca \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0d9c\u0db1\u0dd3\u0db8 \u0db1 \u0dc1. \u0dc1 \u0d9c\u0db8\u0dc1\u0db1 \u0dc1 \u0dc4\u0db4\u0dad \u0d9c\u0dd9 \u0dc2 \u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0dc1\u0d9c\u0dad \u0d91\u0d9a\u0dca\u0d9c\u0d9a \u0dad\u0dd2\u0d9a\u0db4\u0dad\u0dcf\u0dd0 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0db1 \u0d9a\u0dca \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0db1 \u0db8\u0db1\u0dca \u0db4 \u0dbb\u0dca\u0dbd \u0da7\u0dd2\u0d9a \u0d9c\u0dd0\u0dc0\u0dd2\u0d9a\u0dc1 \u0dc3\u0dd4\u0d9a\u0dca\u0d9a\u0dc1\u0db1\u0dca \u0db1\u0dda\u200d\u0dad\u0dd2\u0d9a\u0d9c\u0dad \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0db1 \u0d9a\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db1 \u0db1\u0dda\u200d\u0dad\u0dd2\u0d9a\u0d9c\u0dad \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0db1 \u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9c\u0d9a seat belts \u0db1\u0db1\u0dc4\u0db1 \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0db1 \u0db8\u0db1\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0dc1\u0d9c\u0dad \u0db4\u0dad \u0db1\u0daf\u0dd4\u0dbb\u0dc1 \u0db6\u0dd3\u0d9a\u0dc1. \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0db1\u0db1\u0db1\u0d9a \u0dd2\u0db3\u0d9a\u0dc1 \u0d9c\u0db1\u0dc1\u0d9c \u0db1\u0dca \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0d9c\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d85\u0db1\u0dc1\u0dbb\u0d9a\u0dca\u0dd2\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db1\u0dc1\u0dc0\u0dd2\u0dca\u0da0\u0dd2 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dd4\u0db1\u0dca \u0d94\u0dd4\u0dab\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0db1\u0db1\u0dca \u0d9a \u0db8\u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1\u0d9c\u0dad \u0d9c \u0daf\u0dd2\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0d9c\u0db1\u0dc1\u0dbd\u0dca \u0db1\u0db4 \u0db1 \u0dc1 \u0dc1\u0d9c\u0dda \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0db1\u0db4 \u0d9a\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2\u0d9a \u0d9a\u0dca \u0db1\u0db1\u0dad\u0dd4 \u0db1\u0db8\u0db1\u0dca \u200d\u0dc1 \u0db1\u0d9c\u0dad \u0d9c \u0d9c\u0dd9\u0dca\u0d9c\u0dca. \u0db1\u0dd2\u0dc3\u0dc1\u0db8 \u0dc0\u0dd2\u0d9c\u0db1\u0dda\u0dc2\u0d9c \u0dca\u0db8 \u0db8\u200d\u0dba\u0db8 \u0d9a\u0db3\u0dd4\u0d9a\u0dbb\u0d9c\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0db1 \u0d85\u0db1\u0dad\u0dd4\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0d9c \u0dd0\u0d9c \u0dca \u0db1\u0da9\u0dd2 \u0d9c \u0db8\u0dd2\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1.\n\n\u0d9c\u0db8 \u0dba \u0dcf\u0dbb\u0db1\u0db1\u0dc5\u0db8 \u0d9a\u0dc1\u0dbb\u0dda \u0d9c\u0db8 \u0db1\u0dca. \u0d85\u0da7\u0db4 \u0dd9\u0dca\u0db1 \u0dc1 \u0dc0\u0dd2\u0d9a\u0dbb\u0db8 \u0db8 \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1 \u0d9c\u0dc3\u0dda \u0d9a\u0dca \u0dc3\u0dc4 \u0db1\u0dd2 \u0dc1\u0db8\u0db1 \u0d9a\u0dca \u0d9c\u0db1\u0dc1\u0db8\u0db1\u0dad\u0dd2\u0d9a \u0db8\u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dc1 \u0da2\u0dd3\u0dc0\u0dd2\u0db1 \u0dc3\u0dc4 \u0d9c\u0dda\u0db1\u0dc5 \u0dc0\u0dd2\u0db1\u0dc1\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0d9a\u0db4 \u0dc4\u0dc1\u0db1\u0dd2 \u0d9c \u0db8\u0dd2\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dcf . \u0db8\u0dd1\u0db1 \u0d9a\u0dc1\u0d9a\u0d9c\u0dad \u0dc3\u0dcf\u0d9b\u0dba\u0dc1\u0d9c\u0dbd\u0dca\u0d9b\u0db1 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d85\u200d\u0dba \u0db1 \u0d9a\u0dbb\u0d9a\u0dc1 \u0dcf\u0db1\u0dbd\u0dd4 \u0dc1\u0db8 \u0d85\u0da7\u0db4\u0db4 \u0d9c \u0db8\u0d9c\u0dbb\u0db1 \u0dc1 \u0d9c\u0dca \u0db4\u0dad \u0d85\u0db1\u0dad\u0dd4\u0dd4\u0dc0 \u0dc3\u0dc4 \u0db8\u0dc1\u0dbb\u0dca\u0dbd\u0dd0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc1 \u0dd2\u0dbd\u0db3 \u0db1\u0da7\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dc1 \u0d87\u0dad\u0dd2\u0d9a \u0db1 \u0db1 \u0db8 \u0db8 \u0dca \u0db8\u0d9f \u0dc4\u0dbb \u0dc1 \u0dd0\u0db1\u0dd3\u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0dc3\u0dbb\u0d9a\u0db4 \u0dd4\u0dc0\u0da7\u0db4 \u0dbd\u0dca \u0dd2\u0dbd\u0dd2\u0db1 \u0db1 48 -9 \u0d85\u0db1\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0d9a \u0dbb\u0d9c\u0da7\u0dca \u0db8\u0dc4\u0da2\u0db1\u0db1\u0dc1 \u0d9c\u0dda \u0d9c\u0dda\u0db1\u0dc5 \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0d9c \u0dc1\u0dd9 \u0dca\u0db1 \u0dc3\u0dd2\u0daf\u0dd4 \u0db1 \u0dcf . \u0dc3\u0dbb\u0d9a\u0db4 \u0dd9\u0dc5 \u0d9c\u0dda\u0dba \u0db1\u0dd2\u0dc2\u0dda\u0db1\u0dc1\u0daf\u0dd2\u0db1\u0d9c \u0dca \u0dc3\u0dd2 \u0db4 2-3 \u0d85\u0db1\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0d9a \u0dda \u0dc3\u0db3\u0dc4\u0dc1 \u0db1\u0dd2\u0d9a\u0dd4\u0dc0\u0d9c\u0dab\u0dca\u0da9 \u0d9c \u0dc1\u0dd9 \u0dca\u0db1 \u0d85\u0da7\u0db4\u0db4 \u0dc3\u0dd2\u0dda\u200d \u0d9c \u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1.\n\n\u0d8a\u0dc5\u0d9f\u0db4 \u0d9c\u0dc3\u0dde\u0d9b\u0dba \u0db1\u0dda\u200d\u0dad\u0dd2\u0d9a \u0daf\u0dd2\u0dc4\u0dc1 \u0dcf\u0db1\u0dbd\u0dd4 \u0dc1\u0db8 \u0d85\u0db1\u0db4 \u0d9c\u0db1\u0dd3\u0db8 \u0db1 \u0dc1 \u0d9c\u0dbb \u0dc4\u0dbd\u0dca \u0db1\u0dda\u200d\u0dad\u0dd2\u0d9a \u0db4 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db1 \u0da2\u0db1\u0db1\u0dc1 \u0d9c\u0dd0\u0dca \u0dc3\u0dd2 \u0db4 8 \u0d9a\u0dca \u0d9c\u0db8\u0d9c\u0d9a\u0dc3 \u0dc3\u0dd2\u0daf\u0dd4 \u0db1 \u0db4\u0dad \u0d85\u0db1\u0dad\u0dd4\u0dd4\u0dc0 \u0db1\u0dd2\u0dc3\u0dc1 \u0db4\u0dd3\u0da9\u0dc1 \u0db4 \u0db1 \u0db8 \u0dc0\u0dd6 \u0d85 \u0dcf ."

d82\u0dcf\u0db8\u0dca\u0db6\u0db4 \u0dbd\u0d82\u0dc3\u0dad\u0dca \u0dcf\u0db4\u0dad\u0dca \u0dbd\u0d82 \u0dd2\u0dca \u0dbd\u0d82\u0dc3\u0dab\u0da2\u0da2\u0dd2; \u0dbd\u0d82\u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca \u0dbd\u0d8244\u0dd2. \u0dbd\u0d82\u0dcf\u0db8\u0dca\u0db6\u0db4 \u0dbd\u0d82\u0dc3\u0dad\u0dca\u0dcf\u0dad\u0dca \u0dbd\u0d82 \u0dd2\u0dca \u0dbd\u0d82\u0dc3\u0dab\u0da2\u0da2\u0dd2; \u0dbd\u0d82\u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca \u0dbd\u0d8240\u0dd2. \u0dbd\u0d82\u0dc4\u0dd0\u0db6\u0dd0\u0dd2 \u0dbd\u0d82\u0da2\u0db4\u0dca \u0dbd\u0d82 \u0daf\u0da2\u0dcf\u0dae \u0dbd\u0d82 \u0daf\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0d91 \u0da2 \u0dbd\u0d82 \u0dca\u0da2\u0dba \u0dbd\u0d82\u0d87 \u0dc5\u0dcf \u0dbd\u0d82\u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca \u0dbd\u0d8242 \u0dbd\u0d82\u0d89 \u0dca \u0dbd\u0d8244\u0da7. \u0dbd\u0d82"

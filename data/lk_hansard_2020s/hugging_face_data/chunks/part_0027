    "chunk_text": "\u0d92 \u0dc0\u0dcf \u0daf\u0dda\u0db8 \u0daf\u0db8\u0dca \u0dba\u0daf\u0dda \u0dc0\u0dd2\u0dd2\u0dc2\u0dc2\u0dca\u0da8\u0dae\u0db4 \u0dd0\u0dcf \u0db1 \u0dd2\u0dc2\u0dbd\u0dca\u0db4\u0dd2\u0dd2\u0dba \u0dd9 \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0dd9\u0db4\u0dd4\u0dad\u0dd4 \u0dd9\u0dba\u0db4\u0dd4 \u0dd9\u0db0\u0dd9 \u0dd0\u0da7\u0db1\u0dcf \u0dc0\u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dd2\u0dba\u0dca\u0dae\u0daf\u0dca\u0dae \u0d85\u0daf\u0dda \u0dc3\u0dd2\u0dca\u0dca\u0dad\u0dca \u0dad \u0dad\u0daf \u0dca \u0d85\u0db8 \u0dcf \u0db1\u0dca\u0dd9 \u0db4 \u0db1\u0dca \u0dd9\u0dba\u0db4\u0dd4 \u0dd2\u0dba\u0dcf\u0dad\u0db8 \u0dcf \u0dd2\u0dba \u0dca\u0dba\u0db6 \u0daf\u0dd2 \u0dc0\u0dd2 \u0daf\u0db1\u0dc0\u0dad\u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dd0\u0dad \u0dd9\u0dba\u0db4\u0dd4 \u0d85\u0daf\u0dda \u0db1\u0dca\u0dd9\u0dcf \u0db8 \u0dcf \u0db6\u0dd3\u0db8 \u0db8 \u0dcf\u0dca\u0dd2\u0dba \u0db4\u0dca \u0dd2\u0dba\u0dc0\u0dca \u0dc3\u0dd4\u0dc0 \u0dbb\u0dcf \u0dca \u0db1\u0dcf \u0dd9\u0dba\u0db1\u0dc0\u0dcf .\n\n691 692\n\n[\u0dd0\u0dc0 \u0dd3\u0db8\u0dd2\u0dba\u0da5 \u0db7\u0dcf \u0dd0\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0daf\u0dcf\u0dae\u0dba\u0dca \u0db8 \u0dcf\u0dad\u0dcf ]\n\n2026 \u0d85\u0daf\u0dd0 \u0dca\u0dae\u0dd4 21\n\n\u0dc3\u0dd2\u0dd2\u0db8\u0db1\u0dca \u0dd9\u0dba\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dd9\u0dcf \u0db6\u0d9c\u0dd4\u0da7 \u0dc0\u0dd2\u0dd9\u0dba\u0dcf \u0daf\u0dd9\u0db1\u0dcf \u0dca\u0dad\u0daf\u0db8\u0dca\u0dca\u0dd4\u0dc0 \u0d91\u0dbd\u0dca\u0dd2\u0dba\u0daf\u0db1 \u0dad\u0dca\u0dca\u0dc0 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0db4\u0dd2\u0dc5\u0dd2\u0dcf\u0dc4\u0dc0 \u0db4\u0dd6\u0dca\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0d87 \u0dd3 \u0db8\u0dca \u0dd9\u0dba\u0daf\u0dca\u0daf\u0dd2 \u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d86\u0db1\u0dd9\u0dcf \u0db4\u0dd6\u0dca\u0dc0 \u0dc3\u0dd6\u0dd9\u0dcf \u0db1\u0db8 \u0dca\u0dd2\u0db8\u0dad\u0dc0 \u0d85\u0dc0\u0db0\u0dba \u0dc0\u0dd2\u0dd9\u0dbd\u0dca\u0db1\u0dc0\u0db6\u0db4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0db6\u0dcf \u0db1\u0db1\u0dcf\u0db1 \u0dd2\u0dbb \u0db1 \u0d91\u0dd9\u0dd2 \u0d85\u0db1\u0db4 \u0daf\u0db1\u0daf\u0db1\u0dca\u0daf\u0dca. \u0d85\u0db1\u0db4 \u0dad\u0dc0\u0db8 \u0daf\u0db1\u0daf\u0db1\u0dca\u0daf\u0dca \u0db1\u0db1\u0dcf\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d92 \u0dca\u0dc4\u0dcf\u0dcf \u0daf\u0db6\u0dcf \u0d9a\u0dd4 \u0dc3\u0dd6\u0dd9\u0dcf \u0db1\u0db8 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0daf\u0dc0\u0db1 \u0dcf\u0dc0\u0d9a\u0dca\u0dc3\u0dca\u0db4. \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc0\u0dd2\u0dd2\u0dba\u0db0\u0dae\u0da0 \u0dd9\u0dcf \u0dba \u0db8 \u0dcf\u0dca\u0db8 \u0db8 \u0dcf\u0dca\u0db8\u0dd3\u0dca\u0daf\u0dda \u0daf\u0dca\u0dae\u0dc0\u0dcf \u0dd9\u0dcf \u0db6 \u0daf\u0dd2 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dd9\u0dba\u0dca\u0db1 \u0dd0\u0dca\u0db1 \u0daf\u0dc0\u0daf\u0dcf\u0dca \u0dc0\u0dd1 \u0db8 \u0d92 \u0dd9\u0dba\u0db1 \u0d8b\u0dca\u0dca\u0dcf \u0dcf \u0dd2\u0dad\u0dcf \u0db8 \u0db1\u0dd4\u0daf\u0dd4\u0daf\u0dca\u0daf\u0dd3 \u0daf\u0db8\u0dca \u0dba\u0db4\u0db4 \u0dc0\u0dd2\u0db0\u0dcf \u0db6 \u0dc0\u0dd2\u0db1\u0dad\u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dcf\u0dc0\u0db4 \u0db1\u0dca \u0daf\u0dc0\u0db1 \u0d91\u0dbd\u0dca\u0dd2\u0dba\u0daf\u0db1 \u0dad\u0dca\u0dca\u0dc0\u0daf \u0dca \u0dd2\u0dba\u0daf\u0dd9\u0dca\u0db1 \u0dd9\u0db4\u0dd4\u0dad\u0dd4 \u0dd9\u0dba\u0db1 \u0d86\u0dd9\u0dcf \u0dba \u0dd4 \u0d85\u0db4\u0dd2 \u0dd9\u0dd2\u0dbb\u0dca\u0daf\u0dca \u0db1\u0db1\u0dcf\u0db1. \u0d91\u0db8 \u0dd2\u0dba\u0dca\u0dcf \u0d85\u0db4\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0daf\u0dc0\u0dca \u0dd2\u0dbd\u0dca\u0db6\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf \u0d94\u0dcf \u0d85\u0d9a\u0dbb\u0dd9\u0dba\u0da7 \u0daf\u0dc0\u0db1\u0dd4\u0daf\u0dc0\u0dca \u0dd0\u0dca\u0db1 \u0d92 \u0d8b\u0dca\u0dca\u0dcf \u0dcf \u0daf\u0db8\u0dca \u0dba\u0daf\u0dda \u0dd2\u0dba\u0dd2\u0dba\u0dca\u0dae\u0dc3\u0dd4 \u0da2\u0dd3\u0dc0\u0dca \u0dd9\u0dba\u0dc0\u0dca\u0db1 \u0daf\u0db8\u0dca \u0dba\u0daf\u0dda \u0dd2\u0dba\u0dd2\u0dba\u0dca\u0dae\u0dc3\u0dd4 \u0d85\u0db1\u0dcf \u0dd0\u0dad\u0daf\u0dda\u0daf\u0dd3 \u0dd4\u0db4\u0dc4\u0dd4\u0da7 \u0daf\u0dd9\u0db1 \u0db8 \u0dcf\u0dcf \u0dd9\u0da7\u0dd4\u0dd9 \u0d85\u0dca\u0dd9\u0db1\u0d9a\u0dd3\u0daf\u0db8 \u0dca \u0dd0\u0db6\u0dc0\u0dcf \u0dd0\u0dca\u0db1 \u0dd9\u0db4\u0dd4\u0dad\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dca\u0dc4\u0dcf\u0dcf \u0daf \u0dcf \u0dd9\u0dcf \u0dd0\u0dca\u0db1 \u0dd2\u0dbb \u0db1 \u0dd9\u0dcf \u0dba\u0da7 \u0dca \u0daf\u0db8\u0dca \u0daf\u0db8 \u0dcf \u0daf\u0dcf\u0dcf \u0daf\u0dca \u0dc3\u0dd2\u0dd2\u0db8\u0db1\u0dca \u0dd9\u0dba\u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0dd0\u0dc0 \u0dd2\u0dba\u0daf \u0da2\u0dba \u0dd9 \u0dcf \u0db1\u0dcf \u0dd9\u0dd4\u0db8 \u0dd2\u0dba \u0dad\u0dca\u0dd9\u0dcf \u0db1\u0dd4\u0d9a\u0dd6\u0db6\u0dc0 \u0dcf\u0db1\u0dbd\u0dd4\u0daf\u0dc0\u0dcf \u0dca \u0daf\u0db8\u0dca \u0d85\u0dca\u0db6\u0dd4\u0dd9\u0daf\u0dda \u0dbb\u0db1\u0dcf \u0db1 \u0d85\u0dc1\u0dd0 \u0dd2\u0dbb\u0dd2\u0db8\u0db1 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dd2\u0dba\u0daf\u0dcf\u0db1\u0dc0\u0dcf . \u0d91\u0dd9\u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dad\u0db8 \u0dd2 \u0db1\u0dcf \u0dd3\u0db8 \u0da2\u0db6 \u0d85\u0dca\u0db6\u0dd4\u0dd9 . \u0daf\u0dd9\u0dd9 \u0dad\u0db8 \u0dd2 \u0dd9\u0dd8\u0dd2\u0dd9\u0dcf \u0dca\u0dd2\u0dba\u0dd9 \u0d85\u0dc0\u0dd9\u0dcf \u0db1\u0db8 \u0dca\u0dcf \u0d86\u0dcf\u0dcf \u0dba \u0dc3\u0dd4\u0dba\u0d9a\u0dca\u0dc3\u0dca\u0db4\u0dd2\u0dad\u0db7\u0dcf \u0dc0 . \u0d92 \u0dc0\u0dcf \u0daf\u0dda\u0db8 \u0db1\u0dcf \u0dc1\u0dc1\u0dd4 \u0dca\u0db8\u0dca\u0db1\u0dca \u0dca\u0dcf \u0dc0\u0db1 \u0da2\u0dd3\u0dd3 \u0d85\u0dc1\u0db0 \u0daf\u0daf\u0dca\u0db1 \u0dcf\u0dcf \u0dca\u0dca\u0dc0 \u0dc0\u0dd2\u0db1\u0dcf \u0db0 . \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db8\u0dd3\u0db4 \u0dc0\u0da9\u0dcf \u0d87\u0dca\u0dae \u0d87\u0dba\u0db6\u0dcf \u0daf\u0db8\u0dca\u0dc0\u0dcf \u0daf\u0dd9\u0daf\u0dba\u0dd2\u0db8 \u0d85\u0dc0\u0db1\u0dcf \u0db1 \u0daf \u0dcf \u0dd4\u0db4 \u0dd9\u0dba\u0dca\u0db1 \u0dd2\u0dbb \u0db6\u0dcf \u0d85\u0db4\u0dd2 \u0dd2\u0dad\u0dcf \u0db8 \u0daf\u0dd0\u0dc0\u0dba\u0dc0\u0daf \u0dca \u0dd2\u0dbd\u0dca\u0db6\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf . \u0dc0\u0dd2\u0db1\u0d9a\u0dca\u0dc3\u0dca\u0db4\u0dc2\u0dca\u0da8 \u0d9a\u0dca\u0dc3\u0dca\u0db4 \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d85\u0db4\u0dd2 \u0d94\u0dcf\u0dca \u0dca\u0db8 \u0daf\u0db8\u0dca \u0dd9\u0db4\u0dd4\u0dad\u0dca\u0daf\u0dca\u0daf\u0dd3 \u0d91\u0dd9\u0db4 \u0dd2\u0db8\u0db4 \u0daf\u0dd0\u0db1 \u0da2\u0db1\u0dad\u0dcf \u0dc0 \u0dd4\u0db4\u0dd9\u0dcf \u0dd0\u0dca\u0db1 \u0d85\u0db1\u0db4 \u0dd9\u0dba\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dd2\u0dcf \u0db8 \u0dd9\u0dcf \u0dca \u0db7\u0dcf \u0dba \u0dd9\u0dba\u0db1\u0dc0\u0dcf \u0dd2\u0dbb \u0db1 \u0dd9\u0dcf \u0dba\u0da7 \u0dca \u0dc3\u0dd2\u0dd2\u0db8\u0db1\u0dca \u0dd9\u0dba\u0dca\u0db1 \u0d95\u0db1\u0dd1."

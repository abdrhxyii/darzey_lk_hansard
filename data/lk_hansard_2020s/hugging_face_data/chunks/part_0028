    "chunk_text": "\u0d87\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0d91\u0dba\u0dc4\u0db8 \u0d9a\u0dd2\u0dba\u0dda\u0dba\u0dda? \u0dba\u0db8\u0dca \u0dc4\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d9c\u0dad\u0dad\u0dca\u0dad\u0dca\u200d\u0dad\u0dca \u0dc3\u0db8\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8\u0dad\u0dca\u200d\u0dcf\u0dc0 \u0d85\u0dba\u0dca \u0db8\u0dd6\u0dd2\u0d9a \u0dc3\u0dd2\u0dc1\u0db0\u0dcf\u0dda\u0dad\u0dca\u200d\u0dba\u0d9a\u0dca\u0dad\u0db4 \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dba\u0db8\u0dca \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dc0 \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dbb\u0db1 \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0dd4\u0dc0\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dd4\u0dad\u0dca, \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0db4\u0dd2\u0dbb\u0dd2\u0dba\u0dc0\u0dda \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dbd\u0db6\u0dcf \u0dba\u0daf\u0db1 \u0d85\u0dba\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dba\u0dc0\u0dda \u0dc4\u0da0\u0dcf \u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d92 \u0dba\u0daf\u0db4\u0dcf \u0dba\u0dca\u0dc0\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0dda\u0db8 \u0dbd\u0db6\u0dcf \u0dba\u0daf\u0db1 \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dc0 \u0dc3\u0db8\u0dcf\u0db1 \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0dba\u0dca \u0d87\u0d9c\u0dad\u0dd0\u0dba\u0dd3\u0db8\u0db4 \u0d92 \u0dd2\u0dba\u0dc3\u0dcf \u0dc3\u0db8\u0dcf\u0db1 \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dbd\u0db6\u0dcf \u0dba\u0daf\u0db1 \u0d9a\u0dca\u0dad\u0dba\u0dc2\u0dca\u0dbb \u0dba\u0daf\u0d9a\u0d9a \u0dd2\u0dba\u0dbb\u0dad\u0dca\u200d \u0dba\u0dc0\u0dbd\u0dcf \u0d89\u0dda\u0db1 \u0dba\u0db8\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0dba\u0dc0\u0db1\u0dd4\u0dba\u0dc0\u0dda \u0dc3\u0db8\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8\u0dad\u0dca\u200d\u0dcf \u0db4\u0daf\u0db1\u0db8 \u0db8\u0dad\u0dca\u200d 
    "chunk_text": "\u0dcf\u0dc4\u0dda \u0dd4\u0da7\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc3\u0dc3\u0dd2\u0d9a\u0d9a\u0da7\u0dc310 \u0dc3\u0db8\u0dd4\u0dcf\u0dbd\u0dd4\u0dad\u0dca\u0dc3\u0dda\u0d9c\u0dc0\u0dca\u200d\u0daf\u0dda\u0d9c \u0dc3\u0d9a\u0daf\u0dcf\u0dc3\u0d86 \u0db8\u0dca\u0dcf\u0dc3 \u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf\u0dbd\u0dd4.\u0dc3\u0dcf\u0dcf\u0dc3\u0d9a\u0dd2\u0d9a \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0dc3\u0dd2\u0d9a\u0d9a\u0da7\u0dc310 \u0dc3\u0db8\u0dd4\u0dcf\u0dbd\u0d9a\u0dca\u0dc2\u0dc3\u0dda \u0daf\u0dda\u0dc0\u0dca\u200d\u0dba\u0dd2,\u0dc3\u0d89\u0dad\u0dd4\u0db8\u0dbb\u0dd4\u0dc3\u0d94\u0d9a\u0dca\u0dc2\u0dda \u0ddd\u0dcf\u0dc3\u0db8\u0dd4\u0dcf\u0dbd\u0dca\u0dc3\u0da7\u0dd2 \u0dc3\u0dbd\u0db6\u0daf\u0dc3\u0dda\u0dcf\u0dca \u0dc3\u0d95 \u0dd1\u0d9a\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\u0dc3\u0dad\u0dad\u0dca\u0dad\u0dc3\u0dc0\u0dca\u200d\u0dc1\u0dda\u0d9a\u0dca\u0dcf\u0dc3\u0d92\u0dc3\u0dda\u0dc4\u0dae\u0dad\u0dd4\u0db8\u0dda\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dad\u0dca\u0dc4 \u0d9a\u0da7\u0dc3\u0db4\u0dad\u0dca\u0dda\u0dc0\u0dca\u200d\u0da0\u0dca\u0da0\u0dc36,300\u0d9a\u0dca\u0dc2\u0dc3\u0d89\u0dca \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dcf\u0dc3\u0dc6\u0dd2 \u0dd1\u0dca\u0dca\u0dae\u0dc3\u0d86\u0d9a\u0dad \u0d9a\u0dc3\u0dcf\u0dc4\u0dc3\u0db6\u0dd0\u0d82\u0dd4\u0dda\u0dda\u0dc3\u0dcf\u0daf \u0daf \u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0da7\u0dc3\u0dbd\u0db6\u0daf\u0dc3\u0dda\u0dcf\u0dca \u0da7\u0dc3\u0dda\u0db4 \u0dc3\u0dd2\u0dbb\u0db6\u0dd4\u0dab\u0dd4\u0dc3profit \u0d91 \u0dc3Rs. 1.7 billion, \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca\u0dc3\u0db8\u0dd2\u0dd2\u0d9a \u0dc31,700\u0d9a\u0dca\u0dc2.\u0dc3\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2,\u0dc3\u0dcf\u0dc4\u0dc3\u0db6\u0dd0\u0d82\u0dd4\u0dc0\u0dca\u200d\u0dc3\u0db4\u0daf\u0dbd \u0d9a\u0dc3\u0dcf\u0daf \u0dc3\u0d9c\u0dad\u0dca\u0dad\u0daf\u0da7\u0dc3\u0db4\u0dca\u0dae\u0dda\u0dca\u0dae\u0dc32008-2018\u0dc3 \u0daf\u0dbd\u0dc3\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0daf\u0db1\u0dd4\u0dc0\u0dca\u200d\u0dc3\u0dad\u0dd4\u0db8\u0dc5\u0daf\u0dd3\u0dc3\u0d92\u0dc3\u0d86\u0d9a\u0dad \u0d9a\u0dc3\u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca\u0dc3\u0db6\u0dd2\u0dd2\u0d9a \u0dc319\u0d9a\u0dca\u0dc2\u0dc3\u0db4\u0daf\u0dbd\u0dca\u0dc3\u0dbd\u0db6 \u0dc3\u0d86\u0d9a\u0dad \u0d9a\u0d9a\u0dca\u0dc2\u0dc3\u0db6\u0dc0\u0dca\u200d\u0da7\u0dc3\u0db4\u0dad\u0dca\u0dda\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d91\u0dda\u0dca\u0dae\u0dc3\u0dd2\u0dbb\u0db6\u0dd2\u0d9a\u0daf\u0dd3,\u0dc3\u0dcf\u0dc4\u0dc3\u0db6\u0dd0\u0d82\u0dd4\u0dc0\u0dca\u200d\u0dc3\u0d9a\u0da7\u0dda\u0dad\u0dca\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc3\u0dcf\u0dc3\u0dc6\u0dd2 \u0dd1\u0dca\u0dca\u0dae\u0dc3\u0d86\u0d9a\u0dad \u0d9a\u0dc3\u0db4\u0daf\u0dbd\u0dca\u0dc3\u0dbd\u0db6 \u0dc0\u0dca\u200d\u0daf\u0d9a\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dc3\u0dcf\u0dd0 \u0dc3\u0dcf\u0dd0 \u0dad\u0dca,\u0dc32019\u0daf\u0dd3\u0dc3\u201cOne Billion \u201d \u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dc3\u0dc0\u0dca\u200d\u0dd0\u0da9\u0dca\u0da7\u0dc4 \u0d9a\u0dca\u0dc2\u0dc3\u0dcf\u0d9f\u0dd2\u0dca\u0dc3\u0d92\u0dc3\u0d86\u0d9a\u0dad \u0d9a\u0dc3\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0d9a\u0db0 \u0d9a\u0dc3 \u0dca \u0da7\u0dad\u0dca\u0dc3 \u0da7\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0dc3 \u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dad\u0dad\u0dca\u0dad\u0dc3\u0dc0\u0dca\u200d\u0dc1\u0dda\u0d9a\u0dca\u0dcf\u0dc3\u0d92\u0dc3\u0d86\u0d9a\u0dad \u0d9a\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dca\u0db8\u0dca\u0db4\u0dad\u0dca\u0dc3\u0dda \u0daf\u0dbd\u0dca\u0dbd\u0dc3 \u0daf\u0dbd\u0daf,\u0dc3\u0db8\u0dd4\u0dcf\u0dbd\u0dca\u0dc3\u0dda \u0daf\u0dbd\u0dca\u0dbd\u0dc3 \u0daf\u0dbd\u0daf,\u0dc3\u0d89\u0da9\u0db8\u0dca\u0dc3\u0dda \u0daf\u0dbd\u0dca\u0dbd\u0dc3 \u0daf\u0dbd\u0daf,\u0dc3\u0d88\u0dc0\u0dca\u200d \u0dc3\u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0db8\u0dca\u0dc3\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d\u0dd2\u0d9a\u0dc3\u0d89\u0dad\u0daf\u0dcf\u0dc3\u0dad \u0daf\u0d9a\u0d9a\u0d9a\u0dca\u0dc2\u0dc2\u0dcf\u0dc3\u0dad\u0dca\u0dcf\u0db8\u0dd2\u0dca,\u0dc3\u0daf\u0dd4\u0d9a\u0dc0\u0dca\u200d\u0dbd\u0dc3\u0dad\u0dca\u0dcf\u0db8\u0dd2\u0dca\u0dc3\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dad\u0dca\u0dcf \u0dc3 \u0dbd\u0daf\u0dc3\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\n\n\u0dcf\u0dc3\u0dc6\u0dd2 \u0dd1\u0dca\u0dca\u0dae\u0dc3\u0d86\u0d9a\u0dad \u0dda\u0dda\u0dc3\u0dad\u0dd0\u0dca\u0db4\u0dad\u0dca \u0dbb\u0dd4\u0dc0\u0dca\u200d\u0dca\u0dc36,300 \u0dda \u0dc3\u0dad\u0dba\u0dd2\u0dd2\u0dbb\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dd2 \u0db8\u0dca\u0dc3\u0dc3\u0dd4 \u0d9a\u0dca\u0dc2\u0dc2\u0daf\u0dc3 \u0dc0\u0dca\u200d\u0daf\u0d9a\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dc3\u0dda\u0db8\u0dca\u0dc3 \u0da2\u0d9a\u0dc3\u0dda\u0db4\u0daf\u0dda \u0daf\u0dca\u0daf\u0dd4\u0dc3\u0dc0\u0dd4\u0dab\u0daf.\u0dc3\u0d91\u0dda\u0dca\u0dae\u0dc3 \u0dc0\u0dca\u200d\u0daf\u0dc3 \u0db8\u0dca,\u0dc3\u0dca\u0daf\u0db0\u0daf \u0dab\u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dcf\u0dda\u0dda\u0dcf\u0d9a\u0d9a\u0dca\u0dc2\u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0d92\u0dc3\u0dca"
  },

    "chunk_text": "\u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3\u0dad\u0dcf\u0dba\u0dd2,\u0dc3\u0dc0\u0dca\u200d\u0dd0\u0da9\u0dc3 \u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc0\u0dca\u200d\u0dca\u0dda \u0dc3\u0dad \u0d9c\u0dc5.\u0dc31908\u0daf\u0dd3\u0dc3\u0db1\u0dd2\u0dda\u0dda\u0d9a\u0ddd\u0d9a\u0d9a\u0dca\u0dc2\u0dc3 \u0d9c \u0dda\u0dda\u0dc3\u0dad\u0d9f\u0dbd\u0dd4\u0db8\u0dca\u0dc3\u0d9a\u0dca\u0dc2\u0dda\u0dc2\u0dae\u200d\u0dbb\u0dda\u0dda\u0dc3\u0db1\u0dd2 \u0dad\u0dc3\u0dc0\u0dd6\u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc0\u0dca\u200d\u0dca\u0dc3\u0db4\u0dd0\u0d9a\u0dc3\u0dad\u0da7 \u0dc3\u0dc0\u0dca\u200d\u0dd0\u0da9\u0dc3\u0db8\u0dd4 \u0d9a\u0d9a\u0dca\u0dc2\u0dc3\u0dca\u0dc4\u0dc3\u0dca\u0daf\u0db0\u0daf \u0dab\u0dc3\u0dda\u0dda\u0dad \u0d9a\u0d9a\u0dca\u0dc2\u0dc3\u0d89\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0dad \u0d9c\u0dc5\u0d9a\u0d9a\u0dca\u0dc2\u0dc3 \u0dc5\u0daf.\u0dc3\u0d92 \u0da7\u0dc3\u0d9a\u0dd2\u0dda\u0dda\u0dda,\u0dc3\"Bread and Peace\" \u0dad \u0d9c\u0dc5\u0d9a\u0dc3\u0d9a\u0dd2\u0d9a\u0daf\u0dba\u0dd2.\u0dc3\u0da2\u0daf\u0dad\u0dba\u0dca\u0dad \u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc3\u0daf\u0dd2 \u0d9a\u0dc3\u0db1\u0dd2\u0d9a\u0dcf\u0daf\u0dab\u0d9a\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca \u0dad\u0dca\u0dc3\u0db6\u0dbd\u0db4\u0dd1\u0dda\u0dda\u0dc3\u0d91\u0dcf\u0dc3\u0dad \u0d9c\u0dc5\u0d9a\u0dba\u0dd2.\u0dc3\u0dda \u0dda\u0dca\u0dae\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dad\u0dad\u0dca,\u0dc3\u0dcf\u0daf\u0d9a\u0dad\u0dd4\u0db8\u0dc308\u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc3\u0daf\u0dd2 \u0d9a\u0dc3\u0db6\u0dc0\u0dca\u200d\u0da7\u0dc3\u0db4\u0dad\u0dca\u0dc3\u0dc0\u0dca\u200d\u0dca\u0dda\u0dca\u0dc31922\u0daf\u0dd3\u0dc3\u0dda\u0dbd\u0db1\u0dd2\u0dca\u0dc3\u0dca\u0dda\u0dc4\u0ddd\u0dcf \u0d9a\u0daf\u0dc3\u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dc3\u0d92\u0dc3\u0dc0\u0dd2\u0dda\u0dbd\u0dc0\u0dca\u200d\u0d9a\u0da7\u0dc3\u0dcf\u0daf\u0d9a \u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dc0\u0dca\u200d\u0dd4\u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc0\u0dca\u200d\u0dca\u0da7\u0dc3\u0d9c\u0dbb\u0dd4\u0dc3\u0d9a\u0dd2\u0dbb\u0dd3\u0dcf\u0d9a\u0dca\u0dc2\u0dc3\u0dc0\u0dca\u200d\u0dc1\u0dda\u0d9a\u0dca\u0dc3\u0d91\u0dcf\u0dc3\u0daf\u0dd2 \u0d9a\u0dc3 \u0db8\u0dca\u0dc3 \u0db1\u0dd4\u0dc3\u0dbd\u0dd0\u0dd6 \u0dc3\u0db1\u0dd2\u0dca\u0daf\u0dba\u0dd2.\u0dc3\u0db8\u0dd6\u0dbd\u0daf\u0dca \u0daf\u0dbb\u0dd6\u0daa\u0dc3\u0d9c\u0dbb\u0dd4\u0dc3\u0dcf\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0d9a\u0db1\u0dd2,\u0dc3\u0d92\u0dc3\u0dad\u0db1\u0dd4\u0dc0\u0dca\u200d\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0\u0dca\u200d\u0dc3\u0dda\u0db4\u0dda \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0dda\u0db8\u0dca \u0dc3\u0d93\u0dd2\u0dbb\u0dc4\u0daf\u0dc3\u0dd2 \u0dc3\u0dad \u0d9c\u0dc5\u0d9a\u0d9a\u0dca\u0dc2\u0dc3\u0db6\u0dc0\u0dca\u200d.\u0dc3\u0dda\u0dcf\u0dc0\u0dca\u200d \u0dc3\u0dda\u0dbd\u0ddd \u0dc3\u0dd4\u0dad\u0dda\u0db0\u0dda\u0d9a\u0dca\u0dc3\u0db4\u0dca\u0dae\u0dda\u0dca\u0dae\u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc0\u0dca\u200d\u0dca\u0dda \u0dc3\u0db1\u0dd2\u0dc2\u0dae\u0db4\u0daf\u0dcf \u0dc3\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d\u0dd2\u0d9a\u0da7\u0dc3\u0d8d\u0da2\u0dd4\u0dc0\u0dca\u200d\u0dcf\u0dc3\u0dcf\u0daf\u0d9a \u0dc3\u0dc0\u0dd6\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dca\u0dcf\u0d9f\u0dc3\u0dd0\u0d9a\u0d9a\u0dd2\u0d9a\u0daf\u0dc3\u0dca\u0dae\u0dcf\u0daf \u0dda\u0dda\u0dc3\u0dca\u0dcf\u0daf \u0dc3\u0dca\u0dd0\u0dbd\u0d9a\u0dd2\u0dd2\u0dc3\u0dca\u0dc4\u0dc3\u0dad\u0db0\u0dba\u0daf\u0db4 \u0dc3\u0dad\u0dba\u0dd2\u0dd2\u0dbb\u0d9a\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dda\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dca\u200d\u0dbb\u0db6\u0dbd\u0dc3\u0dcf\u0dad\u0dc0\u0dca\u200d\u0daf\u0dcf\u0dc3\u0dda\u0d9c\u0daf\u0da9 \u0dd0\u0d9f\u0dd4\u0dab\u0daf.\u0dc3\n\n1281 1282\n\n[\u0d9c\u0dbb\u0dd4\u0dc3\u0d91\u0db8\u0dca.\u0d92.\u0d91\u0db8\u0dca.\u0dc3\u0dad\u0daf\u0dc4\u0dd2\u0d9a\u0dc3\u0dcf\u0dc4\u0dad\u0daf]\n\n2026 \u0dca\u0dd0\u0dda\u0dad\u0dd0\u0db8\u0dca\u0db6\u0d9a\u0dc3\u0dc310\u0dc3\n\n\u0dad\u0dda\u0dda\u0dc3 \u0dda\u0da8\u0dcf\u0dc3\u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2\u0dcf\u0dc3\u0d86\u0dcf\u0daf\u0d9a\u0db8\u0dca\u0dc3\u0d8b\u0db4\u0d9a ,\u0dc3\u0dca\u200d\u0dbb\u0db0\u0daf \u0dc3\u0dc0\u0dd2\u0dda\u0dda\u0dc1\u0dc3\u0dc0\u0dd2\u0db1\u0dd2\u0dcf\u0d9a\u0dc3\u0d8b\u0db4\u0d9a \u0dc3\u0d86\u0dcf\u0daf\u0d9a\u0db8\u0dca\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0dad\u0dd4\u0db8 \u0d9a\u0dca\u0dc2\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0d86\u0dcf\u0daf\u0d9a\u0db8\u0dca\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0dad\u0dd4\u0db8 \u0dc3\u0dad\u0dcf\u0dba\u0dd2,\u0dc3\u0dda\u0dad\u0dca,\u0dc3\u0dad\u0d9f\u0dbd\u0dd4\u0db8\u0dca\u0dc3\u0dca\u0dc4\u0dc3\u0dc0\u0dd2\u0dda\u0dda\u0dc1\u0dc3\u0dbb\u0db8\u0dd2 \u0d9a\u0dca\u0dda \u0dc3\u0dda\u0dda\u0dc2\u0dab.\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0dda\u0da9\u0daf\u0dbd\u0d9a\u0dc3\u0dda\u0dc4\u0daf\u0d9a\u0dca\u0dda\u0dca\u0dc3\u0dad\u0dda\u0dda\u0dc3 \u0dda\u0da8\u0dcf\u0dc3\u0daf\u0dd4\u0dda\u0db4\u0dad\u0dca\u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc0\u0dca\u200d\u0dca\u0dda \u0dc3\u0dcf\u0dc4\u0da9\u0dd2\u0dda\u0d9a\u0dca\u0dc3\u0dca\u0dc4\u0dc3\u0dcf\u0dc4\u0dca\u0dc3\u0dd2\u0dda\u0d9a\u0dca.\u0dc3\u0dad\u0dda\u0dda\u0dc3 \u0da7\u0dc3\u0da2\u0dd3\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca\u0dda\u0dca\u0dc3\u0d92\u0dda \u0dca.\u0dc3\u0d91\u0dda\u0dc4\u0dcf\u0dc3 \u0db8\u0dca,\u0dc3\u0d94\u0dc0\u0dd4\u0dca\u0da7\u0dc3\u0dd0\u0d9a\u0d9a\u0dd2\u0d9a\u0daf\u0dc3\u0dca\u0dae\u0dcf\u0daf \u0dc3\u0dad\u0dd4\u0db8\u0dc5\u0dc3\u0dca\u0daf\u0db0\u0daf \u0dab\u0dc3\u0d86 \u0d9a\u0dca\u0dc2\u0dc2\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc3\u0dbd\u0db6\u0daf\u0dc3\u0daf\u0dd3\u0dcf,\u0dc3\u0dca\u0daf\u0db0\u0daf \u0dab\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc3\u0dbd\u0db6\u0daf\u0dc3\u0daf\u0dd3\u0dcf\u0dc3 \u0dc5\u0dc3\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0dba\u0dd2.\u0dc3\u0dda\u0db8\u0dca \u0dc3\u0dc0\u0dca\u200d \u0dcf\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dc0\u0dca\u200d\u0da7\u0dc4\u0daf\u0dc3\u0d9c\u0dca \u0dc3\u0dda\u0dc4\u0daf\u0dc4\u0dc3 \u0dd0\u0dc4\u0dd0,\u0dc3\u0dad\u0db4\u0dd2\u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dda\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dc0\u0dd2\u0dda\u0dc1\u0dae\u0dc2\u0dc3\u0dad\u0dba\u0dd2\u0dd2\u0dbb\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dd2 \u0db8\u0dca\u0dc3\u0d89\u0dbd\u0dca\u0dbd \u0dc0\u0dca\u200d\u0daf\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\u0dc3\u0dda\u0db8\u0dca,\u0dc3 \u0daf\u0dca\u0dad\u0daf\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dda\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dc0\u0dd2\u0dda\u0dc1\u0dae\u0dc2\u0dc3\u0dad\u0dba\u0dd2\u0dd2\u0dbb\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dd2 \u0db8\u0dca\u0dc3\u0d89\u0dbd\u0dca\u0dbd \u0dc0\u0dca\u200d\u0daf\u0dc3\u0dda \u0daf\u0dda\u0dc0\u0dca\u200d\u0dba\u0dd2.\u0dc3 \u0db8\u0dd4\u0dad\u0dca,\u0dc3\u0dca\u0dcf\u0daf\u0da2\u0d9a\u0dc3\u0dad\u0dd4\u0db8\u0dc5\u0dc3\u0d94\u0dc0\u0dd4\u0dca\u0dc0\u0dca\u200d\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca\u0dda \u0daf\u0da7\u0dc3 \u0dc3\u0dca\u0dd0\u0dbd\u0d9a\u0dd3\u0dcf,\u0dc3marginalize \u0dd3\u0dcf\u0dc3\u0dc0\u0dca\u200d\u0dc5\u0d9a\u0dca\u0dc2\u0dc0\u0dca\u200d\u0dca \u0dc3\u0d95 \u0dd1\u0dcf\u0dc3 \u0da2\u0d9a\u0d9a\u0dca\u0dc2,\u0dc3\u0dca\u0dcf\u0daf\u0da2\u0d9a\u0d9a\u0dca\u0dc2\u0dc3\u0db4\u0dd2\u0d9a\u0dc0\u0dca\u200d \u0dc3\u0d9c\u0dca \u0dc3\u0d95 \u0dd1\u0dc3\u0d9a\u0dd2\u0d9a \u0dc3\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d \u0dda\u0dda\u0dc3\u0dad\u0dcf\u0dba\u0dd2\u0dc3\u0dad\u0dda\u0dda\u0dc3\u0da2\u0daf\u0dd2\u0dbb \u0dc3\u0da2 \u0dc3\u0db6\u0dbd\u0dda\u0dda\u0d9c\u0d9a\u0dc3 \u0da2\u0d9a\u0dc3\u0d89\u0dca\u0dda\u0dca.\u0dc3 \u0dca"
  },

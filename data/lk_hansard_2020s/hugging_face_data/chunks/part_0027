    "chunk_text": "\u0d9c\u0dd4\u0dda\u0dc1 \u0db8\u0db8\u0d9a \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1 \u0d9c\u0dc3\u0dda \u0dc1 \u0d9a\u0dca \u0d9a\u0dcf\u0dc1 \u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0d85\u0da7\u0db4 \u0d9c\u0dca \u0db1 \u0dc0\u0dd2\u0db4 \u0d9a\u0dcf\u0dd0\u0db8\u0db4 \u0dcf\u0db3 \u0dc1 \u0d9c\u0dd0\u0db1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1 \u0db4\u0dad \u0db1\u0daf\u0dd4\u0dbb\u0dca 4 8\u0d9a\u0dca \u0d9c\u0d9a\u0dc1\u0dca\u0d9c\u0dd9\u0dc1\u0dc3\u0dda\u0db1\u0dbb \u0dd4\u0dc0\u0dca 24]\u0d9a\u0dca. \u0dd2\u0dad\u0dd2\u0d9a\u0dc4\u0dc1\u0dc3\u0d9c\u0dad \u0db1\u0dc5\u0db8\u0dd4 \u0db1 \u0db1\u0dc1 \u0db4 \u0d85\u0da7\u0db4 \u0db1\u0dc3\u0dd4\u0d9c\u0dd2 \u0dd9 \u0dc3\u0dda \u0d9a \u0d9c\u0d9a\u0dc1\u0dca\u0d9c\u0dd9\u0dc1\u0dc3\u0dda\u0db1\u0dbb \u0db4\u0dad \u0dca 23\u0d9c\u0dd9\u0d9c\u0db1\u0d9a\u0dca \u0dcf\u0db3 \u0dc1 \u0dd0 \u0db8\u0db1\u0dc1. \u0dc0\u0dd2\u0db1\u0dbb\u0d9a\u0dca \u0d9c\u0db1\u0dc1\u0d9c \u0db1\u0dca. \u0dcf\u0db3 \u0dc1 \u0dd0 \u0db8 NTC \u0d9c \u0d9a\u0dc1 \u0dc3\u0db4\u0dc4\u0dca\u0d9a\u0dd4\u0dc0 \u0dca 8\u0d9c\u0dd9\u0db1\u0dc1 \u0d85\u0db1\u0dbb \u0d9a\u0dc1\u0dca\u0db1\u0dc1 \u0dca \u0d9c\u0dd9\u0d9c\u0dd9\u0d9c\u0db1 \u0dc4 \u0dd9 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc1. \u0dc1\u0d9c\u0dda \u0db8 \u0d9a\u0dc1\u0dbb\u0dca\u0dbd\u0db8\u0dd2\u0d9a \u0d85\u0dcf\u0db1 \u0db4 \u0dcf\u0db3 \u0dc1 \u0dd0\u0db1\u0dd3\u0db8\u0dca 428\u0d9a\u0dca \u0d9a\u0dbb\u0dca\u0db1 \u0db8 \u0d85\u0da7\u0db4 \u0d9c\u0dca \u0db1 \u0dc0\u0dd2\u0db4 \u0dc3\u0dca\u0db8\u0dd4\u0d9b \u0db1\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dda \u0db1 \u0db8 \u0dc1 \u0d85 \u0dc3\u0dca \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1.\n\n\u0d9c\u0db8\u0dc1\u0db1\u0dbb\u0dc1\u0dd0\u0d9a \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0d87\u0dad\u0dd4\u0d9c\u0dc5\u0dda \u0db8\u0dc1\u0dbb\u0dca\u0dbd\u0dd0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dda - road safety - \u0db1\u0da9 \u0da7\u0db4\u0dc5\u0dd2\u0d9c \u0dc5 \u0d9c \u0db1\u0dd4\u0d9c \u0dca \u0dd4\u0dc0\u0da7\u0db4 \u0dbd\u0dca 53 8]4 3 4\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0d9a\u0dca \u0d85\u0da7\u0db4 \u0d9c \u0dca \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d9c\u0dca \u0dbb\u0db4 \u0dad\u0dd4\u0dc5 \u0d85\u0d9a\u0dbb\u0d9c \u0d9c\u0dd3 \u0db8\u0dc1\u0dbb\u0dca\u0dbd\u0dd0 \u0dc4\u0db1\u0d9c\u0dd9\u0db1 \u0dc1 \u0dc3\u0dc1\u0db8\u0dc1\u0db1\u0dba \u0db8\u0dc1\u0dbb\u0dca\u0dbd\u0dd0 \u0db1\u0dda\u200d\u0dad\u0dd2\u0d9a \u0dc4\u0db1\u0d9c\u0dd9\u0db1 \u0dc1. \u0d85\u0d9c\u0db4\u0dca \u0db1 \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1 \u0db1\u0dda\u200d\u0dad\u0dd2\u0d9a \u0db4 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9c\u0db8\u0d9c\u0dbb \u0dcf\u0dc3\u0dda \u0dbb\u0dae \u0dc0\u0dd2\u0db1\u0dbb\u0d9a\u0dca \u0d9c\u0db1\u0dc1\u0d9c \u0db1\u0dca. \u0dc1\u0d9c\u0dda \u0db8 \u0db8\u0dc4\u0da2\u0db1 \u0d85 \u0db1\u0dba\u0db1\u0dc1 \u0db8\u0db1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dca\u0db4 \u0d9c\u0dd4\u0dda\u0dc1 \u0db8\u0db8\u0d9a \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1 \u0d9c\u0dc3\u0dda \u0dc1 \u0d9a\u0dca \u0d9a\u0dcf\u0dc1 \u0daf\u0dd3\u0db8 \u0dc0\u0dd2\u0db1\u0dbb\u0d9a\u0dca \u0d9c\u0db1\u0dc1\u0d9c \u0db1\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0db1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc1 \u0d9a\u0dbb\u0d9c\u0dd0\u0db1 \u0dd0\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0d85 \u0db1\u0dba \u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbb\u0dca\u0dbd\u0dd0 \u0db8 \u0d85\u0da7\u0db4 \u0d9c\u0dca \u0db1 \u0dc0\u0dd2\u0db4 \u0d9c\u0db1 \u0dbb\u0db8\u0dd2\u0dca \u0dd2\u0dca\u0d9c\u0dca. \u0dc0\u0dd2\u0d9c\u0db1\u0dda\u0dc2\u0d9c \u0dca \u0dd0 \u0db8\u0d9c\u0db1\u0dc1 \u0db8 \u0d9a\u0db3\u0dd4\u0d9a\u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0db1 \u0d9a\u0db4 \u0dc3\u0dd3\u0da7\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0d9c\u0dd9\u0d9c\u0d9a\u0dca \u0dcf\u0dc3\u0dda \u0dbb\u0dae \u0d85\u0da7\u0db4 \u0d86\u0db1 \u0db1 \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0dc1\u0d9c\u0dda \u0db8 \u0daf\u0dd2\u0d9c\u0dd2\u0dca \u0d85\u0dd4 \u0dcf\u0dc3\u0dda \u0dbb\u0dae 9 \u0d9a\u0dca \u0d86\u0db1 \u0db1 \u0d9a\u0dbb\u0dca\u0db1 \u0db8 \u0d85\u0da7\u0db4 \u0d9c\u0dca \u0db1 \u0dc0\u0dd2\u0db4 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dd6\u0dd9\u0dc1\u0db1\u0dca \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0d9c\u0db8\u0dc1\u0d9a\u0dd9 \u0d9c\u0dca \u0d9c\u0dd4\u0dda\u0dc1 \u0db8\u0db8\u0d9a \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1 \u0d9c\u0dc3\u0dda \u0dc1 \u0d87\u0dad\u0dd4\u0d9c\u0dc5\u0dda \u0db8\u0dc4\u0da2\u0db1\u0db1\u0dc1 \u0db1 \u0daf\u0dd4\u0dbb\u0db4 \u0db8 \u0db1\u0db8\u0dca\u0d9c\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0db1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc1 \u0d9a\u0dbb\u0d9c\u0dd0\u0db1 \u0dd0\u0db8\u0dca \u0d9a\u0dbb\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d85\u0da7\u0db4 \u0dc0\u0dd2\u0db1\u0dda \u0dc1\u0dc3 \u0d9a\u0dbb\u0db1 \u0dc1.\n\n\u0db8\u0dd6\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0dd0\u0dd4\u0dc0 \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0db8 \u0d9c\u0dca \u0d9c \u0d9a\u0dc1\u0d9c \u0d9c\u0dca \u0d9a\u0dc1\u0dbb\u0dda \u0db8 \u0d9a\u0dd2 \u0dca\u0db1 \u0d9a\u0db1\u0db8\u0db1\u0dad\u0dd2\u0d9a\u0db1\u0dca. \u0d85\u0d9c\u0db4\u0dca \u0dbb\u0dcf\u0dd2\u0db1 \u0db8 \u0db8\u0dda\u0daf\u0dd4\u0db8 \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dc1\u0dbb \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dc1 \u0db1\u0dd2\u0d9c \u0da2\u0db1 \u0d9a\u0dbb\u0dca\u0d9c\u0dca \u0d9c\u0db8\u0dc1\u0db1\u0dbb\u0dc1\u0dd0\u0d9a \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a . \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0db4\u0dd4\u0db1 \u0db4\u0dd4\u0db1\u0dc1 \u0d9a\u0dd2 \u0dc1 \u0dba\u0da7\u0dd2 \u0dc1 \u0d9c\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dc4\u0dd9\u0d9a\u0dc1 \u0d85\u0dd4\u0dab\u0dd4\u0dc0\u0dda\u0dd9\u0db1\u0dca \u0db8\u0dc1\u0dc3 \u0dd9\u0dc4 \u0db1\u0dca \u0d9c\u0dca \u0d9a\u0dc1\u0d9a \u0d87\u0dad\u0dd4\u0dc5\u0db1 \u0d9c\u0db8\u0dc1\u0db1 \u0dc1\u0dd9 \u0d9a\u0d9c\u0dc5\u0dda \u0dc3\u0dc4 \u0d9a\u0dbb\u0db8\u0dd2\u0dca \u0dd2\u0dca\u0d9c\u0dca \u0d9a\u0dd2 \u0d9a\u0dc1. 5] \u0dc3\u0dbb\u0d9a \u0d9c\u0dda\u0db1\u0db1\u0dc1\u0d9a\u0db1 \u0d87\u0dad\u0dd4\u0d9c\u0dc5\u0dda \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dc1 \u0db8\u0dca\u0dd3 \u0dbb\u0d9c \u0dc4 \u0dc4\u0db1\u0da7\u0dd2 \u0db4 \u0d87\u0db8\u0dad\u0dd2\u0d9a \u0dbb\u0d9c \u0dc4 \u0dc4\u0db1\u0da7\u0dd2 \u0db4 \u0d9c\u0d9a\u0dc1\u0db1\u0db8\u0dda \u0dbb\u0dca\u0dbd\u0dc2 \u0dd0\u0dda\u0db1\u0d9a\u0dca \u0d9c\u0dca \u0db1\u0dc1\u0dbb\u0dca\u0dbd\u0dd2\u0db1\u0d9c\u0dca\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0d9c \u0da2\u0db1 \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1\u0dd9? \u0dc4\u0db1\u0dcf\u0db1\u0db1\u0dca \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dca\u0d9a\u0dc1 \u0dd2\u0dad\u0dd2\u0d9a\u0dc4\u0dc1\u0dc3\u0d9c\u0dad \u0dd2\u0db1\u0d9c \u0d9c \u0d9c\u0db8\u0dc1\u0db1\u0dbb\u0dc1\u0dd0\u0d9a \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0db1 \u0daf\u0dd4\u0dbb\u0db4 \u0db8 \u0daf\u0dd4\u0db4\u0dca\u0db1 \u0db8\u0db8 \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0d9a\u0dbb\u0d9a\u0dc1\u0db1\u0dca. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dc1 \u0dc4\u0dad\u0dd9 \u0dc3\u0dc1\u0d9a\u0dca\u0dd2 \u0db4 \u0d91\u0d9a\u0d9f \u0d9c\u0dca \u0da7\u0db4\u0dc5\u0dd2\u0dcf\u0db3 \u0d85\u0d9c\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0db1 \u0d9a\u0dbb\u0dca\u0db1 \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0d85\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0d9a\u0dca \u0dad\u0dd2\u0d9a \u0d9c\u0dcf\u0db1 \u0dc1\u0dd9 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0db8\u0db8 \u0d85\u0dc4\u0dca\u0db1 \u0d9a\u0db1\u0db8\u0db1\u0dad\u0dd2\u0d9a\u0db1\u0dca.\n\n887 888\n\n\u0db1\u0dc1\u0dbb\u0dca\u0dbd\u0dd2\u0db1\u0d9c\u0dca\u0dca\u0dad\u0dd4\n\n\u0db8\u0dd6\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0dd0\u0dd4\u0dc0 \u0db8\u0dca\u0dd3\u0
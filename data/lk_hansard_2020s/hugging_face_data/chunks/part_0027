    "chunk_text": "\u0d9c\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0d9a \u0da7\u0db4\u0dc5\u0dd2\u0dcf\u0db3 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0db8\u0db8 \u0d9c\u0dca \u0d9a\u0dc1\u0dbb\u0dda \u0db8 \u0d9a\u0dd2 \u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dd9\u0db1\u0dca \u0d85\u0db1\u0dca\u0dc3\u0dda \u0db8 \u0db8\u0daf\u0dca\u200d\u0dbb \u0dba \u0d9a\u0dd2\u0d9c\u0d9a \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0dca 452\u0d9a\u0dca \u0d85\u0da9\u0dcf\u0d9c\u0dd4 \u0d9a\u0dca\u0d9c\u0da7\u0dca\u0db1\u0dbb \u0d9a\u0dca \u0db4\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0d9a\u0dcf\u0d9a\u0dc1\u0d9c \u0d9a\u0dc5 \u0dd9\u0db1 \u0db1\u0dca\u0db1\u0db8 \u0db1\u0db4\u0db8\u0dca\u0db8\u0d9a\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0dd9\u0db1\u0dca \u0d9c\u0db1\u0dc1\u0dd2\u0db1\u0dc3\u0dda\u0db1\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0dd9 \u0d9a\u0dbb\u0dca\u0d9c\u0dca? \u0d85\u0db1\u0dca\u0dc3\u0dda \u0d9a\u0dca\u0d9c\u0da7\u0dca\u0db1\u0dbb \u0db1\u0db4\u0db8\u0dca\u0db8 \u0dd0\u0db1\u0db1 \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dbd\u0db1\u0db1 \u0d9a\u0dca \u0d9a\u0dbb\u0db1 \u0dc1. \u0db8\u0db4 \u0dba\u0db1\u0dc1\u0dd0\u0dca\u0db1 \u0dcf\u0db1\u0dc4\u0db1. \u0d9c\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0dd9 \u0d9c\u0dca\u0d9a\u0db4 \u0d9c\u0dc4\u0dda\u0dad\u0dd4 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d85\u0da7\u0db4 \u0db1\u0dd2\u0d9a\u0dca \u0d9c\u0dc3\u0dc1 \u0dc1 \u0dcf\u0db1\u0dbd\u0dd4 \u0dc1. \u0daf\u0dd2\u0db1 4\u0d9a\u0dca \u0dc0\u0dd2\u0db1\u0dbb \u0db1\u0dbb\u0d9a\u0dca \u0dc4 \u0dd4\u0dab\u0dda\u0dc1 \u0d9a\u0dd2 \u0db1 \u0dc1. \u0dc3\u0dc1\u0db8\u0dc1\u0db1\u0dba\u0d9c \u0dca Sri Lanka Customs \u0d91\u0d9c\u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 system \u0d91\u0d9a \u0d85\u0db1\u0dd4 \u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0d91\u0d9c\u0dc4\u0db8 \u0d9c \u0db1 \u0dc1. \u0db1\u0db1 \u0db8\u0db1\u0dca \u0d95\u0d9a \u0d9a\u0dd2\u0db1\u0dca \u0d9c\u0dd2 \u0dc1 \u0db1\u0dca a bull in a China shop \u0dc1\u0d9c\u0dda \u0d9c\u0dca\u0d9a\u0db4 \u0db1\u0db1\u0dca\u0db1\u0dc1 \u0db1\u0dca \u0d9c\u0db8\u0dc1\u0d9a\u0dd9 \u0d9c \u0dca\u0d9c\u0dca? \u0d9c\u0dca\u0d9c\u0d9a\u0dca \u0dba\u0db4\u0db4\u0dd4 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0db8 \u0db1 \u0dc1. \u0d9c\u0dca\u0d9a\u0db4 8\u0d9c\u0dd9\u0d9c\u0db1\u0d9a\u0dca \u0d85 \u0db8\u0d85\u0da9\u0dcf\u0d9c\u0dd4 \u0db4 \u0d85\u0dbb\u0d9c\u0dd0\u0db1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0d9c\u0dca \u0dc1 \u0d85 \u0db8\u0d85\u0da9\u0dcf\u0d9c\u0dd4 \u0db4 \u0dd0 \u0db8 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4\u0dca\u0db4 \u0dc0\u0dd2\u0dd4\u0dc0\u0dda\u200d \u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0db1 \u0db1\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dda \u0d9a\u0dca \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dbd\u0db1\u0db1 \u0d9a\u0dca \u0d9a\u0dbb\u0db1 \u0dc1 \u0d9c\u0dca\u0d9a \u0d85\u0dbd\u0dca\u0d9a\u0dc1 \u0dd0 \u0db8\u0db1\u0dc1\u0db4. \u0d91\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0d9c\u0dca\u0d9a\u0db4 \u0d9a\u0dd4\u0dab\u0dd9 \u0d86\u0db1\u0dc3\u0dd4 \u0dc3\u0dca\u0dcf\u0dca\u200d \u0d9c \u0dca\u0d9c\u0dca? \u0db1\u0dd2\u0dc3\u0dc1 \u0d9a\u0dd4\u0dc0\u0dda\u0dc1\u0d9a\u0dbb\u0d9a\u0dc1 \u0d9c\u0dca \u0dc1 \u0dd0\u0db1\u0db1 \u0d9a\u0dbd\u0dca\u0db1\u0db1\u0dc1 \u0d9a\u0dbb\u0dca\u0db1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0dc0\u0dd2\u0d9c\u0db1\u0dda\u0dc2\u0d9c \u0dca\u0db8 \u0d85\u0da7\u0db4 \u0db8\u0db1\u0d9a\u0dca \u0d9a\u0dbb\u0dca\u0db1 \u0d9a\u0db1\u0db8\u0db1\u0dad\u0dd2\u0d9a\u0db1\u0dca.\n\n\u0d9a\u0dc1\u0d9a\u0d9c\u0dad \u0d9c\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0dd9 \u0d9a\u0dd2 \u0d9c ? \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9c\u0dbd\u0dca \u0d87\u0db3\u0dca \u0db1\u0db1 \u0db8\u0db1\u0dca \u0db1\u0dd4 \u0dd9\u0db8\u0dca\u0db1 \u0d9a\u0dd2 \u0dc1. \u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db1\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dc1\u0d9a\u0d9c\u0dad \u0d9c\u0db8\u0dc1\u0db1 \u0dc1\u0dd9 \u0d9a\u0dd2 \u0d9c ? \u0db8\u0dd6\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0dd0\u0dd4\u0dc0 \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0db8\u0db1\u0d9a \u0d87\u0dad\u0dd2\u0d9a \u0d9c\u0dca. \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9c\u0dbd\u0dca \u0d87\u0db3\u0dca \u0db1\u0db1 \u0db8\u0db1\u0dca \u0db1\u0dd4 \u0dd9\u0db8\u0dca\u0db1 \u0d85\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0d9a\u0dca \u0dc4\u0dd9\u0db1 \u0dc1 \u0d9a\u0dd2 \u0dc1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dba \u0dc3\u0dda\u0dae\u0dc1\u0d9c \u0dca. \u0dd9\u0db1\u0dca \u0d9c\u0db8\u0dc1\u0d9a\u0dd9 \u0d9a\u0dd2 \u0dca\u0d9c\u0dca? \u0dba\u0d9c\u0db1\u0db1 \u0dba\u0d9c\u0db1\u0db1 \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9a \u0dd0\u0dda\u0d9c\u0dca \u0dca\u0db1 \u0dcf\u0db1\u0dc4\u0db1 \u0d9a\u0dd2 \u0db1 \u0dc1. \u0d9c\u0db1\u0dc1\u0dc5\u0db4 \u0d86 \u0db8 \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9c\u0d9a\u0db4 \u0db1 \u0dc1 \u0dc4\u0dca\u0daf\u0dd2 \u0db4 \u0d86 \u0db8 \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9c\u0d9a\u0db4 \u0db1 \u0dc1 \u0d91\u0d9c\u0dc4\u0db8 \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9c\u0d9a\u0db4 \u0dca\u0d9c\u0dca \u0db1\u0db1\u0dad\u0dd4 \u0d9c\u0dd0\u0dd9\u0dbb\u0db4 \u0d9c \u0d9a\u0dc1 \u0dd2\u0dca\u0db1\u0dbd\u0dd4 \u0d9c\u0d9a\u0dc1 \u0db8\u0db1\u0db8\u0dbd\u0dca\u0dd2\u0db1 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0db6\u0dd3\u0d9a\u0dc1. \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9c\u0dbd\u0dca \u0d9c\u0dcf\u0d9c\u0dc4 \u0db8 \u0dba\u0d9f \u0db1\u0db1\u0dad\u0dd2\u0d9a \u0d9a\u0d9c\u0dc5\u0dda \u0db1\u0db1\u0dc4\u0db1. \u0dd2\u0dc3\u0dda\u0da7\u0db4\u0db4\u0dad\u0db1\u0dc1\u0d9c\u0d9a\u0db4 \u0db1 \u0d91\u0d9a \u0db1\u0db1\u0dbb \u0d9a\u0dbb\u0db1 \u0dc1 \u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db1\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1. \u0d94\u0dca\u0db1 \u0db1 \u0db8 \u0db8 ; \u0db1\u0db8\u0dd4\u0dca\u0db1\u0dc1\u0dca\u0d9c\u0dc3\u0dda\u0d9a\u0dc1 \u0d9a\u0dbb\u0db4\u0dd4 \u0d9c\u0dda \u0dbd\u0dca. \u0db8\u0db8 \u0dd9\u0db1\u0d9a\u0dca\u0d9a\u0dc1 \u0d9a \u0dd9\u0db8\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1 \u0d85\u0d9c\u0db4\u0dca \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd2 \u0d9a\u0dca. comments \u0d94\u0d9a\u0dca\u0d9c\u0d9a \u0db8 block \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0d9c\u0db8\u0dc1\u0d9a\u0dd9 \u0d85\u0db1\u0dd2\u0d9a\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0daf\u0dd2\u0dd0\u0db4 \u0dc4\u0dbb\u0dc4\u0db4 \u0dd0\u0dc4\u0db1 \u0dc1 \u0d9c\u0dca \u0dc1 \u0dd9\u0db1\u0dca\u0db8\u0dc1\u0db4 \u0db1\u0dc3\u0dd4 .\n\n\u0db8\u0db8 \u0dd9\u0db1\u0d9a\u0dca\u0d9a\u0dc1 \u0d85\u0d9c\u0db4\u0dca \u0d85\u0d9c\u0dda\u0dc3\u0dd2\u0dcf\u0dc4 \u0db8\u0db1\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0d8a\u0d9c\u0dad \u0db4\u0dd4\u0daf\u0dd4\u0db8 \u0d86\u0d9c \u0dd0 \u0d9a\u0dca \u0d9c\u0dca \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0d9c\u0dab\u0dca\u0da9. \u0d85\u0da7\u0db4 \u0d9c\u0dcf\u0dc1\u0d9c\u0dc4\u0dc1\u0db8 \u0dd0\u0dd4\u0dc0 \u0d9a\u0dbb\u0db1 \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dc1. \u0d85\u0dd4\u0dab\u0dd4\u0dc0\u0daf\u0dd4 9 \u0d9a\u0dca \u0db1\u0d9a\u0dca \u0da7\u0dca\u0db4\u0dca\u0db1 \u0dcf\u0db1\u0dc4\u0db1 \u0d9a\u0dd2 \u0dc1. \u0dc4\u0db1\u0dcf\u0db1\u0db1\u0dca \u0d91\u0dc4\u0dc1 \u0db1\u0db1 \u0db8\u0d9c \u0db8 \u0d9c\u0db8\u0dc1\u0dbb \u0d9a\u0dca \u0d9c\u0d9a \u0dbb\u0d9c\u0dc5\u0dda \u0dc3\u0db8\u0dd4\u0db1\u0d9a\u0dc1\u0dbb\u0d9c\u0dad \u0dcf\u0d9a \u0d85\u0dd4\u0dab\u0dd4\u0dc0\u0daf\u0dd4 \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0db1\u0db8\u0dd4\u0dca\u0db1\u0dc1\u0dca\u0d9c\u0dc3\u0dda\u0d9a\u0dc1\u0db4 \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0d9c\u0dab\u0dca\u0da9. \u0d9a\u0db4 \u0d9c\u0db8\u0dc1\u0d9a\u0dd9 \u0dd4\u0dab\u0d9c\u0dab\u0dca\u0da9? \u0d9c\u0d9a\u0dca \u0d85\u200d\u0dba\u0d9a\u0dca\u0dc2 \u0db8\u0dab\u0dca\u0da9\u0da9\u0d9a\u0d9c\u0dad \u0db1 \u0d9c \u0dca \u0db1 \u0db8 \u0dc0\u0dd2\u0db1\u0d9a\u0dca\u0dc2\u0d9c \u0dca \u0d9c \u0db8\u0dbb\u0dd3 \u0db1 \u0db8 \u0dd4\u0dab\u0dda\u0dc1. \u0db1\u0db8\u0dd4\u0dca\u0db1\u0dc1\u0dca\u0d9c\u0dc3\u0dda \u0d85\u0dbb\u0d9c\u0dc4\u0dda \u0d9c\u0dcf\u0db4\u0dad\u0dc4\u0dca \u0d9c\u0dd9\u0db1 \u0dc1 \u0d85\u0dd4\u0dab\u0dd4\u0dc0\u0daf\u0dd4 9 \u0d9a\u0dca \u0db1\u0d9a\u0dca \u0da7\u0dca\u0db4\u0dca\u0db1 \u0dcf\u0db1\u0dc4\u0db1 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0db8\u0db4 \u0d9c \u0db8\u0d9c\u0dbb\u0dca\u0d9c\u0dca \u0db1\u0db1\u0dc4\u0db1 \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0d9a\u0dc1\u0d9c\u0dc4\u0dc1\u0db8\u0dd9 \u0d91\u0d9c\u0dc4\u0db8 \u0d9a\u0dd2 \u0dca\u0d9c\u0dca \u0d9a\u0dd2 \u0d9a\u0dc1. \u0db4 \u0db1\u0da7\u0dca\u0dd4\u0db8\u0d9c \u0db1\u0d9c\u0da9\u0dca\n\n913 914\n\n\u0dad\u0dd0\u0dd4\u0dc0 \u0dd3\u0db8\u0dad\u0dd2\u0d9a\u0da5 \u0dd9 \u0dc1\u0dc3\u0dd2\u0db4\u0dad \u0da2 \u0d9c\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dc4\u0db1\u0dc1\n\n2026 \u0dc3\u0db1\u0db4\u0dca\u0db1\u0db1\u0dca\u0dcf\u0dbb\u0dca\u0dbd 08"

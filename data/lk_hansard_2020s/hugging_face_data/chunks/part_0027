    "chunk_text": "\"\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dbd\u0d82 \u0daf\u0dc3\u0db4\u0daf\u0d9a\u0dd2\u0dda\u0db8\u0dca\u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc0\u0dca\u200d\u0dc4\u0dd2\u0dc3 \u0dcf\u0daf \u0daf\u0d9a \u0dc0\u0dca\u200d \u0d9a\u0daf\u0da7\u0dc3\u0d89\u0dca\u0db0 \u0dc3\u0dcf\u0daf\u0dc0\u0dd2\u0dad\u0d9a\u0dc3\u0dca\u0db8\u0dca\u0db6\u0dca\u0db0\u0dda\u0d9a\u0dca\u0dc3\u0dc3\u0dd3\u0dcf\u0daf\u0dc0\u0dca\u200d\u0dca\u0dc3\u0db4 \u0dc0\u0dca\u200d\u0daf\u0dc3\u0dda \u0daf\u0dd2\u0dbb\u0db6\u0dd3\u0dcf\u0dc3\u0dda\u0dc4\u0dae\u0dad\u0dd4\u0db8\u0dda\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dc3\u0dd3\u0dcf\u0daf \u0dc4\u0dd2\u0dad\u0dc3\u0dda\u0dbd\u0dca\u0dc3\u0d89\u0dca\u0db0 \u0dc3\u0dcf\u0daf\u0dc0\u0dd2\u0dad\u0dc3\u0d9a\u0dd2\u0dbb\u0dd3\u0dcf\u0da7\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d\u0dc3\u0dca\u0dbd\u0dca\u0daf\u0dc3\u0daf\u0dd3\u0dc3\u0dad\u0dd2\u0dbb\u0dc3\u0db6\u0dc0\u0dca\u200d\u0dc3\u0dc0\u0dd2\u0d9c\u0dab \u0d9a\u0da7\u0dc3\u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dc2\u0dab\u0d9a\u0dc3\u0dc0\u0dd2\u0d9a.\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dcf\u0dc3\u0dda\u0dcf\u0dcf\u0dc3\u0dc3\u0dd3\u0dcf\u0daf \u0dc4\u0dd2\u0dad\u0dc0\u0dca\u200d\u0dc3\u0d89\u0dca\u0db0 \u0dc3\u0dbd\u0db6\u0daf\u0dc3\u0daf\u0dd3\u0dcf\u0dc3\u0dda\u0dc4\u0dae\u0dad\u0dd4\u0db8\u0dda\u0dc0\u0dca\u200d\u0dca\u0dc3\u0d89\u0dc4\u0dad\u0dc3\u0dc0\u0dca\u200d\u0d9c\u0dd4\u0dc0\u0dca\u200d\u0dc3\u0dad\u0d82 \u0dc307\u0dc4\u0dd2\u0dc3\u0dcf\u0dd0\u0d9a\u0dca\u0dc2\u0dda\u0dc0\u0dca\u200d \u0dc3\u0db4\u0dbb\u0dd2\u0daf\u0dd2\u0dc39\u0dc0\u0dca\u200d \u0dc3\u0db4\u0daf\u0d9a\u0dd2\u0dda\u0db8\u0dca\u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc0\u0dca\u200d\u0dc4\u0dd2\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dca\u0dca\u0dc3\u0dc0\u0dca\u200d\u0d9a\u0dc2\u0dc3\u0dda\u0dcf \u0dc3\u0dc0\u0dca\u200d \u0dc32023\u0dc3\u0dc4\u0daf\u0dc32024\u0dc3\u0dc0\u0dca\u200d\u0d9a\u0dc2\u0d9a\u0dca\u0dc3\u0dad\u0dd4\u0db8\u0dc5\u0daf\u0dd3\u0dc3 \u0dcf\u0daf \u0daf\u0d9a \u0dc0\u0dca\u200d \
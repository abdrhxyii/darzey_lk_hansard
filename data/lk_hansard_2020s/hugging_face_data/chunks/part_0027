    "chunk_text": "\u0d85\u0dd9 \u0d9c \u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0d9c\u0dbb\u0dda\u0dc2\u0dda\u0db0\u0dc1\u0d9a\u0dbb\u0d9a\u0dbb\u0dda \u0db4 \u0dd2\u0daf\u0dd2\u0db4\u0dad\u0db1 \u0db8 \u0d9a\u0dbb\u0db4\u0dd4 \u0db1\u0dd4 \u0dc4\u0db1\u0db4 \u0dd0\u0dda\u0db1\u0d9a\u0dd2\u0dca \u0dc4\u0db1 \u0db8\u0db1\u0dd1 \u0dd0\u0dda\u0db1\u0d9a\u0dd2\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0d9a\u0dca \u0d85\u0dc4\u0d9a\u0dc1 \u0db1\u0db1\u0dad\u0dd2\u0d9a \u0db1 \u0db8 \u0db8 \u0d9a\u0db4 \u0db1\u0db8\u0db1\u0dca \u0dd9\u0db1\u0dca \u0db1 \u0db8 \u0d9c \u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0db1 \u0db8 \u0db8 \u0dad\u0dd4\u0dc5 \u0dd9\u0db1\u0dca \u0d9c\u0dca \u0dc3\u0db3\u0dc4\u0dc1 \u0d85 \u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db1\u0dd2 \u0d9c \u0dd0 \u0d91 \u0dca\u0db1 \u0dcf\u0d9a\u0dc1\u0d9c\u0db1\u0dc1\u0d9c\u0dbb\u0dc1 \u0db8\u0dad\u0dd4 \u0d9c \u0db1 \u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d85\u0d9c\u0dca\u200d\u0dbb \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dda\u0da0\u0dbb \u0d9a\u0dc1\u0dbb\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0dda\u0dc1. \u0db8\u0db8 \u0d9a\u0dd2 \u0dca\u0db1 \u0d9a\u0db1\u0db8\u0dad\u0dd2\u0d9a\u0db1\u0dca \u0d9a\u0dd4\u0dc0\u0dda\u0dc1\u0d9a\u0dbb\u0d9a\u0dc1 \u0d9c\u0dca \u0dd2\u0dad\u0dd2\u0d9a\u0db4\u0dad \u0db1\u0dd4 \u0db8 \u0d85\u0dc4\u0d9a\u0dc1 \u0dd2 \u0dbb \u0d9c \u0d9a\u0dc1\u0db8 - \u0dc3\u0dad\u0dd2\u0d9a \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1 \u0d9c\u0dca - \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dca\u0d9a\u0dc1 \u0dd3\u0dbb\u0dca\u0daf\u0dd4 \u0d9a\u0dca \u0d91 \u0dca\u0db1 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d85 \u0d9c\u0db4\u0dca \u0d85\u0d9a\u0dbb\u0d9a\u0dbb\u0dda \u0d87\u0db8\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1 \u0daf\u0dd2\u0d9c\u0dd2\u0dca \u0daf\u0dd2\u0dd0\u0db4\u0db8 \u0d9a\u0dd2 \u0db4\u0dd4 \u0d9a\u0dc1\u0dbb\u0dda \u0db1\u0db8\u0db1\u0dca \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dda\u0da0\u0dbb \u0d9a\u0dc1\u0dbb \u0dd4\u0dc0 \u0d9c\u0da2\u0dba\u0dc2\u0dda\u0db0 \u0dd4\u0dab\u0dda\u0dc1\u0db8 \u0d85 \u0db4 \u0dc0\u0dd2\u0db1\u0dc1\u0d9a \u0db1\u0db4\u0dad\u0dda\u0db1\u0da2\u0dc1 \u0d9a\u0dca \u0d9a\u0db1\u0d9c\u0dcf\u0db1 \u0dc1 \u0db1\u0db4\u0dad\u0dda\u0db1\u0da2\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0db1 \u0db1\u0dca \u0db1\u0dbb\u0dda \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dda\u0da0\u0dbb \u0d9a\u0dc1 \u0dd4\u0dc0 \u0db1\u0da9\u0dd2\u0d9c \u0dca \u0db1\u0da9 \u0d9a\u0dbb\u0db4\u0dd4 \u0d85 \u0db1 \u0dd2\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a. \u0dd2\u0dad\u0dd2\u0d9a\u0dca \u0d85\u0d9c\u0db4\u0dca \u0d85\u0d9c\u0dca\u200d\u0dbb \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dda\u0da0\u0dbb \u0d9a\u0dc1\u0dbb\u0dad\u0dd4\u0db8\u0dc1\u0db8 \u0d9a \u0d9c\u0dcf\u0dc1\u0dd4\u0dc0 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d94\u0db4\u0dca\u0db4\u0dd4 \u0d9a\u0dbb\u0d9a\u0dc1 \u0d9c\u0db1\u0dca \u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1.\n\n\u0db8\u0dd6\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0dd0\u0dd4\u0dc0 \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0dca \u0db1\u0dd4 \u0d85\u0dc4\u0dca\u0db1 \u0d9c\u0db1 \u0dbb\u0dc1 \u0dd0\u0dca\u0d9c\u0dca \u0d9a\u0dc1 \u0dd9? \u0d9c\u0dca \u0d9a\u0db1\u0db1\u0dca\u0dc3\u0dda\u0dad\u0dd4\u0d9c \u0d85\u0d9c\u0db4\u0dca \u0d9c\u0dbb\u0dda\u0dc2\u0dda\u0db0\u0dc1\u0d9a\u0dbb\u0d9a\u0dbb\u0dda\u0d9c\u0dad 4\u0d9c\u0dd9\u0d9c\u0db1 \u0dc4\u0d9c\u0dda \u0db1\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0d91 \u0dba \u0db1\u0dc5\u0db8\u0dd4 \u0db1\u0db1\u0dd2 \u0dc1\u0db4 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0dd2\u0dca\n\n\u0db8\u0dd6\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0dd0\u0dd4\u0dc0 \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dd9\u0db1\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0db1 \u0d9a \u0d9c\u0db1\u0dc1\u0d9c \u0db1\u0dca. \u0dd9\u0db1\u0dca \u0db1\u0dd4 \u0dd3\u0dbb\u0dca\u0daf\u0dd4 \u0d91\u0dca\u0db1 \u0d9a\u0dd2\u0db1\u0dca \u0dd3\u0dbb\u0dca\u0daf\u0dd4 \u0d9a\u0dd2 \u0db1 \u0dc1. \u0d85\u0d9c\u0db4\u0dca \u0dc4\u0dbb\u0dca\u0dbd\u0dc2\u0dda \u0db1\u0dc1\u0db1\u0dc1 \u0d9a\u0dca\u0d9a\u0dc1\u0dbb \u0db8\u0dc4 \u0db8\u0db8 \u0dc1 \"\u0dc3\u0dd2\u0dbb\u0dc3\" \u0db8\u0dc1\u200d\u0dba\u0d9c\u0dad \u0db1\u0da9\u0dc3\u0db4\u0dc4\u0db1\u0d9a\u0db4 \u0d9c\u0dd2 \u0dba\u0dbd\u0dca\u0d9a\u0dc1 \u0d9a\u0dd2 \u0dc1 \u0da2\u0db1\u0db8\u0db1 \u0dc0\u0dd2\u0da0\u0dbb\u0dc1\u0dbb\u0dda \u0d9a\u0dca \u0d91\u0dca\u0d9c\u0dca \u0db1\u0db1\u0dc4\u0db1 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d8a\u0d9c\u0dad \u0d94\u0dcf\u0dad\u0dd4\u0db8\u0dca\u0d9a\u0dc1\u0d9c\u0dda \u0dbb\u0dd0\u0dc3\u0dda\u0db8\u0dda\u0d9c\u0dca\u0daf\u0dd3 \u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db1\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dd2 \u0d9c \u0d9c\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0dd9? \u0d9c\u0dca 8 \u0db1\u0db1\u0dd2 \u0dd9\u0dc1 \u0dd9 \u0d9c\u0d9a\u0dc1\u0d9c\u0dc4\u0dda\u0dd9 \u0d9c\u0dca\u0d9c\u0d9a\u0dca \u0dd3\u0dbb\u0dca\u0daf\u0dd4 \u0d91\u0dca\u0db1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1 \u0d86\u0db4\u0dd4 \u0dd0\u0db8\u0dca \u0d85\u0da7\u0db4 \u0dad\u0dd4\u0d9c\u0db1\u0dca \u0d9c\u0dd9\u0d9c\u0d9a\u0dca \u0dcf\u0dc4\u0dd4\u0db1\u0dbb\u0d9c \u0dca \u0d9c\u0dca\u0d9a \u0dc3\u0dca\u0db8\u0db1 \u0d9a\u0dbb\u0d9a\u0dc1 \u0dd2 \u0dbb \u0d9a\u0dbb\u0db1 \u0dc1 \u0d9a\u0dd2 \u0dc1. \u0d91 \u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0da2\u0db1\u0db8\u0db1 \u0dc0\u0dd2\u0da0\u0dbb\u0dc1\u0dbb\u0dda \u0d9a\u0dca \u0d91\u0db1 \u0dc1\u0dd9 \u0db1\u0db1\u0dda\u0dd9 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0dca\u0d9c\u0dca \u0db1\u0db1\u0dc4\u0db1. \u0d9a\u0dd2 \u0dca\u0d9c\u0dca \u0d9c\u0dca\u0d9a \u0dad\u0dd4\u0d9c\u0db1\u0dca \u0d9c\u0dd9\u0d9c\u0d9a\u0dca \u0dcf\u0dc4\u0dd4\u0db1\u0dbb\u0d9c \u0dca \u0dc3\u0dca\u0db8\u0db1 \u0d9a\u0dbb\u0dca\u0db1 \u0db1\u0db8\u0db1\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dca\u0d9a\u0dc1\u0d9c\u0dda \u0dcf\u0d9a\u0dc1\u0d9c\u0db1\u0dc1\u0d9c\u0dbb\u0dc1 \u0db8\u0dad\u0dd4 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0dca\u0d9c\u0dca. \u0d91\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0da2\u0db1\u0db8\u0db1 \u0dc0\u0dd2\u0da0\u0dbb\u0dc1\u0dbb\u0dda \u0d9a\u0dca \u0dc3\u0dca\u0dcf\u0dca\u200d \u0d9c\u0dbb\u0dda\u0dc2\u0dda\u0db0\u0dc1\u0d9a\u0dbb\u0d9a\u0dbb\u0dda\u0d9c\u0dad \u0dd3\u0dbb\u0dbb\u0dda \u0d91 \u0db1\u0dca\u0dd9 \u0db1\u0db1\u0dda\u0dd9 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0dd9\u0dca\u0db1 \u0dc1. \u0dd9\u0db1\u0db1\u0d9c\u0dd0\u0db1 \u0db1\u0db8\u0db1\u0dca \u0d9c\u0dca\u0d9a \u0d9a\u0dd2 \u0dca\u0d9c\u0dca. \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0db1 \u0db8\u0db1\u0dca \u0d9a\u0dd2 \u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0db1\u0dc4\u0db1 \u0d9c\u0dca \u0d85\u0da7\u0db4 \u0dd3\u0dbb\u0dca\u0daf\u0dd4 \u0d86\u0db4\u0dd4 \u0dd0\u0db8\u0dca \u0dad\u0dd4\u0d9c\u0db1\u0dca \u0d9c\u0dd9\u0d9c\u0d9a\u0dca \u0dcf\u0dc4\u0dd4\u0db1\u0dbb\u0d9c \u0dca \u0dc3\u0dca\u0db8\u0db1 \u0d9a\u0dbb\u0d9a\u0dc1 \u0d9c\u0dca\u0d9a \u0dd2 \u0dbb \u0d9a\u0dbb\u0db1 \u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d91\u0d9c\u0dc4\u0db8 \u0d9a\u0dd2 \u0dca\u0db1 \u0d95\u0db1\u0dd1\u0dd9? \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dca \u0d9a\u0dd2 \u0dca\u0db1 \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0d9c\u0dab\u0dca\u0da9 \"\u0d85\u0da7\u0db4 \u0dd9\u0dca\u0d9c\u0dca \u0db1\u0db1\u0dc4\u0db1 \u0d9c\u0db8\u0dc1\u0db1 \u0dc0\u0dd2\u0d9a\u0dbb\u0d9c\u0dad \u0dd3\u0dbb\u0dca\u0daf\u0dd4 \u0d9a\u0dca \u0d91\u0db1\u0dca\u0dd9 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d95\u0db1\u0dd1 \u0d9c\u0dd9 \u0d9a\u0db4 \u0d85\u0da7\u0db4 \u0dc3\u0dd6\u0dd9\u0dc1\u0db1\u0dca. \u0dad\u0dd4\u0d9c\u0db1\u0dca \u0d9c\u0dd9\u0d9a\u0d9a\u0dca \u0db1\u0dca \u0dad\u0dd4\u0d9c\u0db1\u0dca \u0d9c\u0dd9\u0d9a\u0d9a\u0dca \u0da2\u0db1\u0db8\u0db1 \u0dc0\u0dd2\u0da0\u0dbb\u0dc1\u0dbb\u0dda \u0d9a\u0dca \u0db1\u0dca \u0da2\u0db1\u0db8\u0db1 \u0dc0\u0dd2\u0da0\u0dbb\u0dc1\u0dbb\u0dda \u0d9a\u0dca. \u0d95\u0db1\u0dd1 \u0d91\u0d9a\u0d9a\u0dd2\u0dca \u0d85\u0da7\u0db4 \u0d9a\u0dbb\u0db1 \u0dc1\" \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d9c\u0dca. \u0d91\u0d9c\u0dc4\u0db8 \u0d9a\u0dd2 \u0d9c \u0db1\u0db1\u0dc4\u0db1. \u0d87\u0db1\u0dca? \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0dd9\u0dca\u0db1 \u0dc1 \u0d91\u0db1 \u0dd3\u0dbb\u0dca\u0daf\u0dd4 \u0d9c\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0dd9 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0db1\u0dd2\u0dc3\u0dc1 \u0d85\u0db1\u0db4 \u0d86\u0db1\u0dc4\u0dd4 \u0d9a\u0dbd\u0dca\u0db1\u0db1\u0dc1 \u0d9a\u0dbb\u0dca\u0db1 \u0d9c\u0dd9 \u0d9a\u0dca \u0db1\u0db1\u0dc4\u0db1. \u0d9c\u0db8\u0dc1\u0d9a\u0dd9 \u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db1\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dd2 \u0db4\u0dd4 \u0dc4\u0db1\u0db8 \u0d91\u0d9a\u0db8 \u0d9c \u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. 29 \u0db1\u0db1\u0dd2 \u0dd9\u0dc1 \u0d91\u0d9a\u0dca\u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca"

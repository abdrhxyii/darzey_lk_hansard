    "chunk_text": "\u0dda\u0db6\u0dca\u0dda\u0dca.\u0dc3\u0d92\u0dc3\u0dad\u0dad\u0dbb\u0dd2\u0dca\u0dc3\u0da2\u0dbd\u0dc3\u0db8\u0dd6\u0dbd\u0daf\u0dbb\u0dc31,897\u0d9a\u0dca\u0dc2\u0dc3\u0dad\u0d9a\u0da2 \u0d9a\u0da7\u0dc3\u0dbd\u0d9a\u0dca\u0dc2\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dca\u0dcf\u0dc4 \u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dc3\u0dd2\u0dd3 \u0dc3\u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0daf.\u0dc3\u0dca\u0dcf\u0dc4 \u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dc3\u0dd2\u0dd3 \u0dc3\u0d9a\u0daf\u0dc3\u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dd2\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dc3\u0dad\u0db4\u0dd2\u0dc3\u0dd4\u0dda \u0ddd \u0dcf \u0d9a\u0dc3 \u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0da2\u0dbd\u0dc3\u0db8\u0dd6\u0dbd\u0daf\u0dbb\u0dc3\u0d9a\u0dd2\u0d9a\u0dca\u0dda\u0dca\u0dc3\u0dca\u0dcf\u0dc4 \u0dc3\u0dc0\u0dd2\u0da7\u0dc3\u0dd2\u0db6\u0d82\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca \u0dc3\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0dca,\u0dc3 \u0dc5\u0dc3\u0dd2\u0db6\u0d82\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca \u0dc3\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0dca,\u0dc3\u0dd4\u0da9\u0daf\u0dc3\u0dc0\u0dca\u200d\u0dd0\u0dda\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca \u0dc3\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0dca,\u0dc3\u0dd4\u0da9\u0daf\u0dc3\u0dad\u0dc5\u0dc0\u0dca\u200d\u0dbd\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca \u0dc3\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0dca.\u0dc3\u0dda\u0db8\u0dca\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dda\u0dc0\u0dca\u200d \u0dad\u0dca\u0dc3\u0daf\u0dd2\u0d9a\u0dc3\u0db4\u0dc4 \u0dc0\u0dca\u200d\u0dbd\u0dca\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dc3\u0dda\u0db4\u0daf\u0da9\u0dd2\u0dc3\u0dda\u0db4\u0daf\u0da9\u0dd2\u0dc3\u0da2\u0dbd\u0dc3\u0db8\u0dd6\u0dbd\u0daf\u0dbb\u0dc0\u0dca\u200d\u0dd2\u0dca\u0dc3\u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dc3100 \u0da7,\u0dc3150 \u0da7\u0dc3\u0da2\u0dbd\u0dc3\u0dca\u0db8\u0dca\u0db4\u0daf\u0dcf \u0d9a\u0dc3 \u0dc3\u0dd4\u0da9\u0daf\u0dc3\u0da2\u0dbd\u0dc3\u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0dd8\u0dd2\u0dbb.\u0dc3\u0dcf\u0dcf\u0dc3\u0d89\u0dca\u0dae\u0dda\u0dca\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda ,\u0dc3\u0d92\u0dc3\u0dc3\u0dd2\u0dd3 \u0dc3\u0d9c\u0dd2\u0d9a\u0dc3\u0da2\u0dbd\u0dc3\u0db8\u0dd6\u0dbd\u0daf\u0dbb\u0dc0\u0dca\u200d\u0dd2\u0dca\u0dc3\u0dad\u0db4\u0dc4\u0dc3\u0dd4\u0dad\u0daf\u0dc0\u0dca\u200d\u0da7\u0dc3\u0db4\u0dad\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d\u0da0\u0dca\u0da0\u0dc3\u0da2 \u0dad\u0daf\u0dc0\u0dca\u200d\u0dc3\u0dc0\u0dd2\u0dd2\u0d9a\u0da7\u0dc3\u0dad\u0dcf\u0dba\u0dd2\u0dc3\u0dda\u0db8\u0dca\u0dc3\u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dc3\u0dc4\u0dad\u0dd2\u0db6\u0dca\u0dae\u0dcf\u0dc4\u0dca\u0dae\u0dc3\u0d9c\u0dab \u0dc3\u0dc0\u0dca\u200d\u0daf\u0d9a\u0dad\u0daf\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca\u0dda\u0dca.\u0dc3\u0d94\u0dc0\u0dd4\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dda\u0dc0\u0dca\u200d\u0dca\u0dc3\u0dcf\u0dd0 \u0da7\u0dcf\u0dad\u0dca\u0dc3\u0da2\u0dbd\u0dc3\u0dca\u0db8\u0dca\u0db4\u0daf\u0dcf \u0dc3 \u0da7\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0dc3\u0d86 \u0db8\u0dca\u0dcf\u0dc3 \u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dad\u0dad\u0dca\u0dad\u0da7\u0dcf\u0dc3\u0dda\u0db8\u0dca\u0dc3 \u0da7\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0dc3\u0d86\u0db4\u0dcf\u0daf\u0dc3 \u0dc5\u0dcf \u0daf \u0dab\u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dab\u0d9a\u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0dad\u0dcf\u0dba\u0dd2\u0dc3\u0dc3\u0dd2\u0dda\u0db0\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dca\u0dda\u0dca.\u0dc3\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dba \u0d9a\u0dc3\u0dda\u0dbd\u0dca \u0db8\u0dca\u0dda \u0dc3\u0dca\u200d\u0dbb\u0db0\u0daf \u0dad\u0dca\u0dc0\u0dca\u200d\u0dda\u0d9a\u0dca\u0dc3\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dba \u0d9a\u0dc3\u0d86\u0db4\u0dcf\u0daf\u0dc3 \u0dc5\u0dcf \u0daf \u0dab\u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dab\u0d9a\u0dc3\u0dd2\u0dbb\u0dda\u0db6 \u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0dc3\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dba \u0d9a\u0dc3\u0dda\u0dbd\u0dca \u0db8\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dc3\u0d89\u0dca \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dba \u0d9a\u0dc3\u0dca\u0dcf\u0daf\u0dda\u0dda\u0dc3\u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dc3\u0dda\u0dc4\u0ddd\u0dc3\u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0d9a\u0dc3\u0d89\u0dca \u0dc0\u0dca\u200d\u0daf,\u0dc3\u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3\u0dda\u0dc0\u0dca\u200d \u0dad\u0dca\u0dc3\u0db1\u0dd2\u0dbd\u0db0\u0daf\u0dbb\u0dd2\u0dca\u0dc3\u0d89\u0dca \u0dc0\u0dca\u200d\u0daf.\u0dc3\n\n1203 1204\n\n\u0db4\u0daf\u0d9a\u0dd2\u0dda\u0db8\u0dca\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d"
  },

200d\u0dbb\u0da2 \u0dba\u0dca \u0dbd\u0d82\u0dd2\u0dd2\u0dd3\u0db8\u0da2. \u2022 \u0dcf\u0dd4 \u0db4 \u0db4\u0dba \u0dbd\u0d82\u0daf\u0dba\u0db4\u0db4\u0db4\u0dba \u0d86 \u0dbd\u0d82\u200d\u0dbb\u0db4 \u0dc1\u0dd2 \u0dbd\u0d82\u0dc4\u0dba\u0dc4\u0db4 \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db4\u0dad\u0dca\u0da2 \u0dbd\u0d82\u0dc0\u0dd6 \u0dbd\u0d82\u0dba\u0db4\u0da2\u0dcf\u0dba \u0dbd\u0d82\u0dcf\u0dc4\u0da2\u0db4\u0db0\u0db4\u0dba \u0dbd\u0d82\u200d\u0dbb\u0da2 \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db4\u0dad\u0dca\u0da2 \u0dbd\u0d82 \u0da2\u0db4\u0dd3\u0da2. \u2022 \u0dcf\u0db8\u0dd2\u0dad\u0dd2 \u0dbd\u0d82\u0d9c\u0dcf\u0dba\u0dca\u0dcf\u0dba \u0dbd\u0d82\u0db4\u0dbb\u0dd2\u0db4\u0db4\u0d9a\u0da2 \u0dbd\u0d82\u0dc4\u0db4 \u0dbd\u0d82\u0db8\u0dd6\u0d9a\u0dba \u0dbd\u0d82\u0dc3\u0dd0\u0da7\u0dbd\u0dd4 \u0dbd\u0d82\u0db1\u0dd2\u0dcf\u0db4 \u0dbd\u0d82\u200d\u0dbb\u0db4 \u0dc1\u0dd2 \u0dbd\u0d82\u0daf\u0dd2\u0dd2\u0dca \u0dbd\u0d82\u0daf\u0dd2\u0dc3\u0da7\u0da2 \u0dbd\u0d82\u0db4\u0db4\u0dca \u0dbd\u0d82\u0d9a\u0dd0\u0db6\u0dd3\u0da2. \u2022 \u0da2\u0dd3\u0da2 \u0dbd\u0d82\u0daf\u0dba\u0db4\u0db4\u0db4\u0dba \u0dbd\u0d82\u200d\u0dbb\u0da2 \u0daf\u0dba \u0dbd\u0d82\u0db8\u0dd6\u0d9a\u0dba \u0dbd\u0d82 \u0dc5\u0da2\u0da2\u0db4 \u0dba\u0dab \u0dbd\u0d82\u0dcf\u0db4\u0dca\u0dc2\u0dab\u0dba \u0dbd\u0d82\u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0dbd\u0d82\u0db1\u0dd2\u0d9a\u0db0\u0db4\u0dbb\u0dd2\u0dca \u0dda \u0dbd\u0d82\u0dc4\u0db4 \u0dbd\u0d82 \u0dcf\u0dae\u0daf \u0dd2\u0dca \u0dda \u0dbd\u0d82\u0daf\u0dd0\u0db1\u0dd4\u0da2 \u0dbd\u0d82\u200d\u0dbb\u0da2\u0db4\u0dab\u0daf\u0dad\u0dca \u0dbd\u0d82 \u0da2\u0db4\u0dd3\u0da2.\n\n(v) \u2022 \u0dc3\u0dd3/\u0dcf \u0dbd\u0d82\u0db6\u0dd4\u0d9a\u0dad\u0dca \u0db4\u0dd4\u0dc0\u0dd2\u0dc5\u0da7\u0dd2\u0dba \u0dbd\u0d82\u0dd2\u0dc3\u0dd2\u0dc3\u0db0 \u0dbd\u0d82 \u0dcf\u0dae\u0daf\u0db4 \u0dbd\u0d82\u0dcf\u0dd4 \u0db4 \u0db4\u0dba \u0dbd\u0d82\u0dcf\u0db8\u0dd2\u0dad\u0dd2\u0dba \u0dbd\u0d82- \u0dbd\u0d820203.50.35\u0dca \u0dbd\u0d82\u0d9c\u0daf\u0dcf\u0dca \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0dbd\u0d82\u0daf\u0dca\u0daf\u0db4 \u0dbd\u0d82\n\n\u0dc3\u0dab\u0da2\u0dba\u0dca \u0dbd\u0d82\u0db1\u0dd2\u0da2 \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dd2\u0dc3\u0dc3\u0dab\u0da2 \u0dbd\u0d82\u0daf\u0db4\u0dbb\u0dca\u0dbd\u0dcf\u0db4 \u0dbd\u0d82\u0dcf\u0db8\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0db1\u0dd2\u0daf\u0dc4\u0dcf\u0dae \u0db4\u0da7 \u0dbd\u0d82\u0d87\u0dcf. \u0dbd\u0d82\n\n020(.50.35\u0dca \u0dbd\u0d82\u0d9c\u0daf\u0dcf\u0dca \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0dbd\u0d82\u0dcf \u0dc4\u0db4 \u0dbd\u0d82\u0dd2\u0dc3\u0dc3\u0dab\u0da2\u0dba \u0dbd\u0d82\u0dd2\u0db1\u0dd4\u0dc0 \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0db4\u0daf\u0dad\u0dd3. \u0dbd\u0d820204 \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0da7 \u0dbd\u0d82\u0d9c\u0daf\u0db4\u0dc5 \u0dbd\u0d82\u0dd2\u0dc3\u0dc3\u0dab\u0da2 \u0dbd\u0d82\u0dcf \u0dc4\u0db4 \u0dbd\u0d82\u0db1\u0dd2\u0d9a\u0db0\u0db4\u0dbb\u0dd2\u0dca \u0dbd\u0d82\u0db4\u0dad\u0dca \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0d87\u0dcf. \u2022 \u0dc3\u0dd3/\u0dcf \u0dbd\u0d82\u0dba\u0da7\u0dd2\u0dba\u0dca \u0dcf\u0db4\u0da7 \u0dbd\u0d82\u0dd2\u0dc3\u0dd2\u0dc3\u0db0 \u0dbd\u0d82 \u0dcf\u0dae\u0daf\u0db4 \u0dbd\u0d82\u0dcf\u0dd4 \u0db4 \u0db4\u0dba \u0dbd\u0d82\u0dcf\u0db8\u0dd2\u0dad\u0dd2\u0dba - \u0dbd\u0d82020(.50.35\u0dca \u0dbd\u0d82\u0d9c\u0daf\u0dcf\u0dca \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0dbd\u0d82\u0daf\u0dca\u0daf\u0db4 \u0dbd\u0d82\u0dd2\u0dc3\u0dc3\u0dab\u0da2\u0dba\u0dca \u0dbd\u0d82\u0db1\u0dd2\u0da2 \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dd2\u0dc3\u0dc3\u0dab\u0da2 \u0dbd\u0d82\u0daf\u0db4\u0dbb\u0dca\u0dbd\u0dcf\u0db4 \u0dbd\u0d82\u0dcf\u0db8\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0db1\u0dd2\u0daf\u0dc4\u0dcf\u0dae \u0db4\u0da7 \u0dbd\u0d82\u0d87\u0dcf. \u0dbd\u0d82\n\n0204.50.35\u0dca \u0dbd\u0d82\u0d9c\u0daf\u0dcf\u0dca \u0dbd\u0d82\u0daf\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0dbd\u0d82\u0dcf \u0dc4\u0db4 \u0dbd\u0d82\u0dd2\u0dc3\u0dc3\u0dab\u0da2\u0dba \u0dbd\u0d82\u0dd2\u0db1\u0dd4\u0dc0 \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0db4\u0daf\u0dad\u0dd3.\n\n(vi) \u0d9c\u0daf\u0db4\u0dc5 \u0dbd\u0d82 \u0da2\u0db4 .\n\n(\u0d87) \u0d9c\u0daf\u0db4\u0dc5 \u0dbd\u0d82 \u0da2\u0db4 ."

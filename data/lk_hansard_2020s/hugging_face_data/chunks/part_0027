    "chunk_text": "\u0baa\u0bbe\u0ba3\u0b95\u0bae, \u0bb2\u0b95\u0bc1\u0b95\u0b95\u0bb2, \u0baa\u0b9a\u0b99\u0bcd\u0b95\u0bbe\u0bae\u0bae\u0bcd, \u0b8a\u0bb1\u0ba3\u0bbf \u0b9a\u0baa\u0bbe\u0ba9\u0bcd\u0bb1 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0ba8\u0bc0\u0bbe\u0bbf\u0ba9\u0bcd\u0bb1\u0bbf \u0bae\u0bbf\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0b95\u0bb7\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b87\u0bae\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0ba4\u0bc1\u0bae\u0bcd \u0baa\u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0bb2\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0ba4\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0b9a\u0bbf\u0baf\u0ba4\u0bcd \u0b9a\u0ba4\u0b95\u0bb5\u0baf\u0bbe\u0ba9 \u0b95\u0bc1\u0b9f\u0bbf\u0ba8\u0bc0\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bb5\u0b9a\u0bbe\u0baf \u0ba8\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd \u0b9a\u0ba4\u0b95\u0bb5\u0b95\u0b95\u0bb3\u0baa\u0bcd \u0baa\u0bc2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf \u0baa\u0b9a\u0baf\u0bcd\u0baf, \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0b9a\u0bc1 \u0baa\u0bb9\u0b9f\u0b93\u0baf\u0bbe \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0b95\u0ba4 \u0bb5\u0bbf\u0b95\u0bb0\u0bb5\u0bbf\u0bb2\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1, \u0b85\u0ba4\u0b95\u0ba9\u0b9a\u0bcd \u0baa\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0b9a\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0baa\u0bae\u0ba9\u0b95\u0bcd \u0b9a\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0baa\u0b95\u0bbe\u0bb3\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd. \u0b95\u0b9f\u0ba8\u0bcd\u0ba4 5\u0b86\u0bae\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 22\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b85\u0bae\u0bcd\u0baa\u0bbe\u0b95\u0bb1 \u0b95\u0b9a\u0bcd\u0b9a\u0b9a\u0bbe\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0b9f\u0bae\u0bcd\u0baa\u0baa\u0bb1\u0bcd\u0bb1 \u0bb5\u0bbf\u0b9a\u0b9a\u0b9f DCC \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bb2 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9c\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0b9f\u0baf\u0ba4\u0bcd\u0b95\u0ba4 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0baa\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0bb5\u0bcd\u0bb5\u0bbf\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd \u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0baa\u0b95\u0bbe\u0bb3\u0bcd\u0bb3 \u0bb5\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd.\n\n\u0baa\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0b9a\u0bb3, \u0d85\u0d9c\u0db4\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dda\u0dba \u0d9c\u0dbd\u0dca\u0d9a\u0dca \u0d9a\u0dc1\u0dbb\u0dca\u0dbd \u0dc1\u0d9a \u0d9a \u0d9a\u0dd1\u0dd2\u0db1 \u0db1\u0dd9\u0db1\u0db8 \u0db8\u0db1 \u0d9c\u0dc3\u0dda \u0d9a\u0dbb\u0db1 39\u0d9c\u0dd9\u0d9c\u0db1\u0d9a\u0dca \u0dd2\u0dca\u0db1 \u0dc1. \u0d91\u0db8 \u0db1\u0dd2\u0d9a\u200d\u0dc1\u0db4\u0dad\u0dca\u0db4 \u0db1\u0db8 \u0d9c\u0dc3\u0dda \u0dc3\u0dda\u0dd2\u0dbb \u0d9a\u0dbb \u0dd0\u0dca\u0db1 \u0dcf\u0db1\u0db4\u0dad \u0db1 \u0db8 \u0db8 \u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0d85\u0dd4\u0dab\u0dd4\u0dc0\u0daf\u0dd4 ]\u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0d91\u0db8 \u0db1\u0dd2\u0d9a\u200d\u0dc1\u0db4\u0dad\u0dca \u0db1\u0da9 \u0d9a\u0dbb\u0db1 \u0dc1. \u0dd0\u0dd4\u0dc0 \u0dbb\u0dc1\u0da2\u0dba \u0db1\u0db4\u0dad\u0db1\u0dc1\u0d9a\u0db1 \u0db1\u0dc5\u0dc1 \u0db8 \u0dc3\u0da2\u0dc1 \u0dc3\u0dc4 \u0db1\u0dc5\u0dc1 \u0db8 \u0db1\u0dc1\u0d9a\u0db1 \u0d87\u0db8\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0db8 \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dca\u0db1\u0dc1\u0dd9\u0db1 \u0db1\u0dd2\u0d9c \u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0db8 \u0d9c\u0dca \u0dd0\u0db1\u0db1 \u0db1\u0db1\u0dc4\u0db1\u0daf\u0dd2\u0dd2\u0db1 \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9a\u0d9c\u0dcf\u0db1 \u0dc1. \u0d9a\u0dd4\u0dc0\u0dda\u0dc1\u0d9a\u0dbb\u0d9a\u0dc1 \u0d9c\u0dca \u0d85\u0dd4\u0dab\u0dd4\u0dc0\u0dda\u0d9c\u0dda \u0da0\u0dbb\u0d9a\u0dca\u200d\u0dbb\u0d9c\u0dbd\u0dca\u0d9b \u0db1\u0dd2 \u0dc4 \u0db8 \u0d9a\u0dbb\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0d91\u0db8 \u0db1\u0dd2\u0d9a\u200d\u0dc1\u0db4\u0dad\u0dca\u0d9c\u0dda \u0d9c\u0dc3\u0dda \u0dc3\u0dda\u0dd2\u0dbb \u0d9a\u0dbb\u0dca\u0db1 \u0d85 \u0db1\u0dba \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dca\u0db1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0db8\u0db8 \u0dd0\u0dd4\u0dc0 \u0dc3\u0da2\u0dc1\u0d9c \u0dca \u0dd2\u0dbd\u0dca\u0d9a\u0db1 \u0dc1. \u0d91\u0db8 \u0db1\u0dd2\u0d9a\u200d\u0dc1\u0db4\u0dad\u0dca \u0dc3\u0dd2 \u0dbd\u0dd4\u0d9c\u0dd9\u0db1\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dda\u0dba \u0d9c\u0dbd\u0dca\u0d9a\u0dca \u0d9a\u0dc1\u0dbb\u0dca\u0dbd \u0dc1\u0d9a \u0d9a \u0dc3\u0dd2 \u0dbd\u0dd4 \u0db1\u0da9 \u0d9a\u0dbb\u0db1 \u0dcf \u0db8\u0dc1 \u0d9a\u0dd2 \u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0baa\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0b9a\u0bb3, \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0b95\u0b9f\u0baf \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0b95\u0b9f\u0baf \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bb5\u0bb3\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0b95\u0bb5\u0baf\u0bbf\u0b9a\u0bb2 \u0ba8\u0bbe\u0ba9\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0b9f\u0baf\u0b99\u0bcd\u0b95\u0b95\u0bb3 \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0bb5\u0b95\u0bcd\u0b95 \u0bb5\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd."
  },

    "chunk_text": "\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0dba\u0db8\u0dba \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dba\u0dc3\u0dca,- \u0d92 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0dda\u0daf\u0dba \u0db4\u0db1\u0dad\u0dca\u200d\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dd2\u0dba \u0dc0\u0da0\u0db1\u0dba \u0d9a\u0dbb \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d9c\u0dad\u0dab\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0dba\u0db8\u0dc4\u0dd2\u0daf\u0dd3 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0dba\u0d9a\u0dba\u0db1\u0d9a\u0dca\u0dad \u0dba\u0db4\u0dde\u0dc1\u0d9c\u0dad\u0dd2\u0d9a\u0dc0 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dba\u0dc0\u0dbd\u0dcf \u0dad\u0dd3\u0dda\u0dbb\u0da7 \u0dad\u0dd3\u0dbb\u0dab \u0d9c\u0dad\u0dda\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0\u0db4 \u0dba\u0dad\u0dca\u200d\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dbb\u0dd4 \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0d9a\u0dcf \u0dba\u0dba\u0dad\u0dca \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dd2\u0dba\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dda\u0dba \u0dc3\u0dd2\u0da7 \u0d85\u0daf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dc1\u0dc1\u0dd3\u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dd4\u0dda \u0dc4\u0dbb\u0dc4\u0dcf \u0d89\u0dc4 \u0da7 \u0d91\u0db1 \u0d9a\u0dbd\u0dca\u0db8 \u0d9a\u0db8\u0dd2\u0dd4\u0db4 \u0db8\u0d9f\u0dd2\u0dda \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dad\u0dc2\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf, \u0dc3\u0db8\u0dcf\u0da2 \u0dc3\u0dd4\u0db6\u0dc3\u0dcf\u0db0\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc4\u0dbb\u0dc4\u0dcf \u0d92 \u0dba\u0dad\u0dca\u200d\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dbb\u0dd4 \u0db4\u0dbb\u0dd2\u0d9c\u0dad\u0dab\u0d9a\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0dbb \u0dad\u0dca \u0d9a \u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0d9c\u0dad\u0dbb\u0dd4 \u0dc0\u0dd2\u0db4\u
    "chunk_text": "1989 \u0daf\u0db1\u0db3\u0dba\u0dc0\u0dcf \u0db4\u0dad 1\u0dc0\u0dd0\u0dd2\u0dbd \u0dd9\u0dcf \u0dba\u0dcf \u0da2\u0dba \u0db1\u0db4\u0dad\u0db1\u0dcf \u0db1 \u0dad\u0db8 \u0dcf \u0dad\u0dba\u0dcf \u0dc1\u0db0\u0daf\u0dda \u0dc0\u0dd0\u0da9 \u0db3 \u0db1 \u0daf\u0dbd\u0dca\u0dd9\u0db8\u0dca\u0dc0\u0dba \u0dcf \u0dd2\u0dbd\u0d9a\u0dd4\u0dca \u0dd9\u0dba\u0dd4 \u0da0\u0d9a\u0dca\u200d\u0dbb\u0daf\u0dbd\u0dca\u0d9b\u0dca\u200d \u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf , \u0db8 \u0dcf \u0dab\u0dca\u0da9\u0da9\u0dd2\u0dd9 \u0daf\u0dbb\u0dae\u0dab\u0dd2\u0dc0 \u0dd2\u0dbd \u0db1\u0dcf \u0db4\u0dad\u0db1\u0dca\u0daf\u0dda \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8 \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db1\u0daf \u0db1\u0dca. \u0d92\u0daf\u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dca\u0daf\u0db1\u0dca \u0db8 \u0dcf \u0dab\u0dca\u0da9\u0da9\u0dd2\u0dd9 \u0daf\u0dbb\u0dae\u0dab\u0dd2\u0dc0 \u0db4 \u0dad \u0dca \u0dc3\u0dd2 \u0dbd\u0dd4 \u0dba\u0dcf \u0da2\u0dba \u0dd2\u0dbd\n\n\u0dc1\u0daf\u0db0 \u0db1\u0db1 \u0dc0\u0dd4\u0daf\u0dab\u0dca\u0da9 \u0db1\u0dd0\u0dcf\u0dd0, \u0d94 \u0d9a\u0dd2 \u0db1 \u0dcf\u0dd0\u0da7\u0dd2 \u0db4. \u0dca\u0db8 \u0dcf\u0dba \u0dad\u0db8 \u0dcf \u0dad\u0dba\u0dcf \u0dc1\u0db0\u0dc0 \u0dd9\u0dcf \u0dbb\u0dca\u0dbd \u0dcf \u0dc0 \u0db4 \u0db3\u0dd4\u0dc5\u0dd4 \u0dd3\u0daf\u0db8\u0dca\u0daf\u0dd3 \u0d92 \u0dd9\u0dcf \u0db1\u0dca\u0dad\u0dcf \u0dc0\u0db1\u0dca\u0db4 \u0dca\u0dcf \u0db4\u0dad \u0daf\u0dcf \u0d94\u0dca\u0db4\u0dad \u0db1\u0db8 \u0da7\u0d9a\u0dca \u0db3 \u0dcf \u0d91\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0dcf \u0db8\u0dca \u0dca\u0dc1\u0dc0\u0dcf \u0dd9 \u0d9a\u0dca \u0db1\u0dd0\u0db1 \u0db1\u0dd0\u0d9f\u0dd2 \u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0da7\u0dcf . \u0d91\u0dad\u0dd0\u0db1\u0daf\u0dd2 \u0dad\u0db8 \u0dba\u0dd2, \u0da2\u0d92 \u0dba\u0da2\u0daf\u0dda \u0dd2\u0dbd\n\n\u0db1\u0dba \u0db1\u0dca \u0dca\u0dae\u0dc0\u0dbb\u0dca \u0dd9\u0dcf \u0dbb\u0dca\u0dbd \u0dcf \u0db1\u0db4\u0dad\u0dbb \u0db4 \u0db1\u0dd0\u0db8\u0dd2\u0dab\u0daf\u0db8\u0dca\u0daf\u0dd3 \u0dcf\u0dcf \u0dba\u0dcf \u0da2\u0dd9\u0dcf \u0db4\u0dad\u0daf\u0dda \u0daf \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2 \u0daf\u0dd3 \u0dba\u0dcf \u0da2\u0dba \u0daf\u0dca\u0dae\u0dc0\u0daf\u0dda \u0daf\u0d9c\u0dde\u0dba\u0dc0 \u0dbb\u0dd0\u0daf\u0dd9\u0db1 \u0d86\u0dd9\u0dcf \u0dba\u0daf\u0dda \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0dd9\u0dcf \u0dbb\u0dca\u0dbd \u0dcf \u0dba\u0dd3 \u0db3\u0dd4\u0db8\u0db8 \u0d9a\u0dd2\u0db1\u0dca \u0dca\u0dd0\u0dba\u0dc3\u0dd3\u0db8 \u0db4 \u0d89\u0da9 \u0daf\u0dd2 \u0dba\u0dd4\u0dd4 . \u0dad\u0dc0\u0dd9, \u0d91 \u0d9a\u0dca\u0daf\u0dc2\u0dca\u0da8\u0dae\u0dca\u200d\u0dbb \u0dba\u0dcf \u0da2\u0dd9\u0dcf \u0db4\u0dad \u0dca \u0dcf\u0dcf \u0dd9 \u0db3\u0dd4\u0dc5\u0dca \u0dc0\u0dd2 \u0dba\u0dd4\u0dd4 \u0da2 \u0d9a\u0dd2 \u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0daf\u0dab\u0dca\u0da9.\n\n\u0d9c\u0dbb\u0dd4 \u0db8 \u0db1\u0dca\u0dd3\u0dd4\u0db8 \u0dd2\u0dbd, \u0daf\u0db8\u0dca\u0dd9 \u0db3\u0dd4\u0dc5\u0dca \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca \u0dba\u0da2\u0daf\u0dda \u0dd2\u0dbd \u0db1\u0dba \u0db1\u0dca\u0db4 \u0db8\u0dd2\u0dca\u0d9a\u0dca \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8\u0dca \u0dad\u0db3\u0dd2\u0db1 \u0dad \u0db4 \u0daf\u0db1\u0dcf \u0daf\u0dc0\u0dba\u0dd2. \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8\u0dca \u0daf\u0dd3\u0db8 \u0db1\u0dcf \u0dc0 \u0db3\u0db1, \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8\u0dca \u0dad\u0db3\u0dd2\u0db1 \u0dad \u0db4 \u0dc4\u0dd2\u0db8\u0dd2 \u0dd2\u0dbd\u0db0\u0dae\u0da0\u0dd2\u0dad \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8 \u0d9a\u0dca \u0db1\u0dc0\u0dad\u0dd2\u0d9a\u0db1\u0dc0\u0dcf . \u0d92\u0dd9\u0db4 \u0dd9\u0dd1\u0dd2 \u0dad\u0dd4 \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0dcf\u0db4\u0dad, \u0d91\u0dd9\u0dd4 \u0dd9\u0dba\u0db1\u0dca\u0db1\u0db4 \u0dcf\u0db4\u0dad \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8\u0dca \u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0daf\u0dda \u0dad\u0db1\u0dd4\u0db8 \u0dd0\u0dad\u0dd2\u0d9a \u0d9a\u0dd2\u0db1\u0dca \u0daf\u0dad\u0dcf \u0dba\u0dc0 \u0dcf\u0dd0\u0d9a\u0dd2 \u0dcf \u0dc0\u0d9a\u0dca \u0db1\u0dd0\u0dcf\u0dd0. \u0daf\u0db8\u0dca\u0dd9 \u0dad\u0db8 \u0dba\u0dd2 \u0dad\u0dca\u0dca\u0dc0 . \u0daf\u0db8\u0dca \u0da0\u0d9a\u0dca\u200d\u0dbb\u0daf\u0dbd\u0dca\u0d9b\u0dca\u200d \u0dad\u0dd2\u0dc5 \u0dd2\u0dbd\u0d9a\u0dd4\u0dca \u0dd9\u0dba\u0dd4 \u0d91\u0dd9\u0d9a\u0dca \u0daf\u0db1\u0dcf \u0daf\u0dc0\u0dba\u0dd2. 2019\u0daf\u0dd3 \u0dba\u0dc0\u0dd4 \u0dc6\u0dae \u0dcf\u0dbb\u0dca\u0db8\u0dca, \u0db4\u0dad\u0dca\u0dcf \u0dca \u0db3\u0daf\u0dd2\u0dba\u0dd4\u0daf\u0dd3\u0db1\u0dca, \u0dca\u0da2\u0dd2\u0dca \u0daf\u0dda\u0db8 \u0dd9\u0dcf \u0dca \u0db3\u0dd4\u0dc5\u0dd4 \u0dad \u0d91\u0dc0\u0dd9\u0db4\n\n\u0db3\u0db8 \u0dad\u0dd2\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0dc3\u0dd2\u0da7\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0d91 \u0dd9\u0dba \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dca\u0daf\u0db1\u0dca. \u0daf\u0db3\u0dcf \u0daf\u0dcf\u0dcf \u0db8 \u0db1\u0dd0\u0dcf\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d91\u0db8 \u0da0\u0d9a\u0dca\u200d\u0dbb\u0daf\u0dbd\u0dca\u0d9b\u0dca\u200d\u0daf\u0dda \u0d9a\u0dd2 \u0dcf \u0dad\u0dd2\u0d9a\u0daf\u0db3\u0db1\u0dc0\u0dcf , \u0da2\u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8 \u0d9a\u0dca \u0daf\u0dcf \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8\u0dca \u0daf\u0dd3\u0db8 \u0db1\u0dcf \u0db3\u0db1 \u0dd2\u0dbd \u0db1\u0dba \u0db1\u0dca \u0dad\u0db8 \u0db1\u0dca\u0daf\u0dda \u0dad\u0db1\u0dd4\u0db8 \u0dad \u0dd2\u0dbd \u0db3\u0dd4\u0db8\u0db8\u0dd2\u0db1\u0dca \u0dca\u0dd0\u0dba\u0dc3\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2 \u0dba\u0dd4\u0dd4\u0dba\u0dd2\u0da2 \u0d9a\u0dd2 \u0dcf . \u0daf\u0db8\u0dca \u0db8 \u0dad \u0db1\u0dd9\u0db1\u0db8\u0dca \u0daf\u0dc0 \u0dcf \u0dad\u0db8 \u0dba\u0dd2 \u0dd9\u0dd0\u0db1\u0db4 \u0dba\u0dcf \u0da2\u0dba \u0daf\u0dca\u0dae\u0dc0\u0daf\u0dda \u0dd9\u0db4\u0dba\u0dd4\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca. \u0dd9\u0dd0\u0db1\u0dca \u0daf\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dd3\u0db8 \u0db1\u0dd9\u0db1\u0db8\u0dca \u0dd9\u0dba\u0daf\u0d9c\u0db1 \u0daf\u0dd9\u0dcf \u0dad\u0dd0\u0db1\u0dd9 \u0dcf\u0db4\u0dad \u0dd2\u0db6\u0dca \u0d9a\u0dd4\u0da9\u0dcf \u0daf\u0daf\u0dca\u0db7\u0db0\u0db1\u0dcf \u0db1 \u0dd9\u0dab\u0dca\u0da9\u0da9\u0dcf \u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0da2\u0dcf \u0dad\u0dd2\u0d9a\u0dc0\u0dcf \u0dd9 \u0dc0\u0dd4\u0dba\u0db1\u0dca\u0db1 \u0dcf\u0dd9\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca, \u0d92 \u0dcf\u0dba\u0dcf\u0dcf \u0daf\u0dca\u0dde\u0d9b\u0dca\u200d\u0dba \u0daf\u0dca\u0dae\u0dc0\u0dcf \u0dc0 \u0db6\u0dd2 \u0dc0\u0da7\u0dca\u0db4\u0db1\u0dca\u0db1 \u0dcf\u0dd9\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca, \u0dad\u0dd2\u0dc5 \u0d92\u0dd9\u0db4 \u0d89\u0da9 \u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dcf\u0dd0."

    "chunk_text": "\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82 \u0db4\u0da7\u0dad\u0dca \u0dbd\u0d82\u0da2\u0dcf \u0dbd\u0d82\u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0d89\u0dca \u0dbd\u0d82\u0d91\u0dca \u0dbd\u0d82\u0d9c\u0daf\u0dcf\u0dae\u0dcf\u0db4\u0daf\u0dca \u0dbd\u0d82\u0dcf\u0da2\u0dd2 \u0dbd\u0d82 \u0d9a \u0dbd\u0d82 \u0daf \u0dc5 \u0db4\u0da2 \u0dbd\u0d82\u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0dbd\u0d82\u0dcf\u0dba\u0dc3\u0dba. \u0dbd\u0d82\u0d87 \u0da2\u0dbb\u0dd2 \u0db4 \u0dbd\u0d82\u0d91\u0dca\u0dcf\u0dad\u0dca \u0dbd\u0d82\u0da2\u0dcf\u0da2\u0db4\u0daf\u0dba \u0dbd\u0d82 \u0d9a \u0d86 \u0dbd\u0d82\u0d9c \u0da2\u0dca \u0dbd\u0d82\u0dba\u0da7\u0daf\u0dbd\u0dca \u0dbd\u0d82\u0d91\u0dca \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2 \u0dbd\u0d82 \u0daf \u0dc5 \u0dbd\u0d82\u0db4\u0dba\u0dcf\u0dba\u0dba \u0dbd\u0d82\u0dcf\u0da2\u0dc4\u0dca \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dc3\u0dd0\u0db1\u0dd3 \u0db8\u0dca \u0dbd\u0d82\u0db4\u0dba\u0da2\u0db4\u0dbb\u0dca\u0dbd\u0dcf \u0dba\u0dca \u0dbd\u0d82\u0d9c \u0da2\u0dba \u0da2\u0dba \u0dbd\u0d82\u0dad\u0dd3\u0dbb\u0dd4\u0db6\u0dd4\u0dc0 \u0dbd\u0d82\u0db4\u0dd0\u0da2\u0dd3\u0da2\u0dca \u0dbd\u0d82\u0dd2\u0db1\u0dd4\u0dc0 \u0dbd\u0d82 \u0dba\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0dd2\u0dc5\u0da7 \u0dbd\u0d82\u0db4\u0db4\u0d9a\u0da2\u0dba \u0dbd\u0d82 \u0dba\u0dca\u0da2 \u0dbd\u0d82\u0db4\u0dd4\u0dc5\u0dd4\u0daf\u0dca \u0dbd\u0d82\u0d91 \u0dca \u0dbd\u0d82 \u0da2\u0db4 \u0daf\u0dd2. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0db4\u0da7 \u0dbd\u0d82\u0dd2\u0dc5\u0da7\u0dd2\u0dca \u0dbd\u0d82\u0dad\u0dd2\u0db6\u0dd2\u0da0\u0dca\u0da0\u0dd4\u0da0 \u0dbd\u0d82 \u0db4\u0dba\u0dab\u0dba\u0dca. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0db1\u0dd4\u0daf \u0dbd\u0d82\u0d9c\u0db4\u0da7 \u0dbd\u0d82\u0db4\u0dc5\u0dd4 \u0daf\u0dca\u0da2 \u0dbd\u0d82\u0dba\u0dba\u0da7 \u0dbd\u0d82(( \u0dbd\u0d82\u0d9c \u0da2\u0dba \u0da2\u0dba \u0dbd\u0d82\u0dad\u0dd3\u0dbb\u0dd4 \u0dbd\u0d82\u0db6 \u0daf\u0dca \u0dbd\u0d82\u0db4\u0dd0 \u0da2 \u0daf\u0db4. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0daf\u0dcf\u0dae\u0dcf\u0db4 \u0da2 \u0dbd\u0d82\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dcf \u0dc4\u0db4 \u0dbd\u0d82 \u0dc3 \u0dba\u0dca \u0dbd\u0d82\u0da2\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dbd\u0d82 \u0daf\u0d9a\u0db4 \u0dbd\u0d82\u0d9c\u0daf\u0db4\u0dc5 \u0dbd\u0d82 \u0da9\u0dd4\u0d9a\u0da9\u0db4\u0dba\u0db8\u0dca \u0dbd\u0d82\u0db4\u0dad\u0dca \u0dbd\u0d82 \u0dba\u0d9a\u0db4 \u0dbd\u0d82\u0dcf\u0db4\u0dca\u0dc2\u0dab\u0dd2\u0dba\u0dda \u0dbd\u0d82 \u0db8\u0dd2\u0da7\u0dd4 \u0dbd\u0d82\u0db4\u0dad\u0dca \u0dbd\u0d82 \u0dba\u0d9a\u0db4 \u0dbd\u0d82\u0d87 \u0da2\u0dbb\u0dd2 \u0db4\u0db1\u0dd4 \u0dbd\u0d82 \u0daf \u0dc5 \u0dbd\u0d82\u0dca\u0dba\u0dcf\u0da2\u0dba\u0dad\u0dca \u0dbd\u0d82\u0dcf\u0da2 \u0dbd\u0d82\u0db1\u0dd2\u0dba\u0dca\u0dcf\u0dba \u0dba\u0dca \u0dbd\u0d82\u0dcf\u0db4 \u0da0\u0dca\u0da0\u0dd4\u0da1\u0db4 \u0dbd\u0d82 \u0dc5\u0db4. \u0dbd\u0d82\u0d9c\u0daf \u0dbd\u0d82\u0daf\u0da2 \u0dbb\u0dd4 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dcf\u0db4 \u0da0\u0dca\u0da0\u0dd4\u0da1\u0db4 \u0dbd\u0d82\u0db4\u0daf\u0dad\u0dca\u0daf\u0db4 \u0dc3\u0da2 \u0dbd\u0d82\u0dba\u0db4 \u0db8\u0dca \u0dbd\u0d82\u200d\u0dbb\u0dad\u0dd2\u0db5\u0d9a\u0dba\u0dca \u0dbd\u0d82\u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dd2\u0db1\u0dba\u0dba\u0da7 \u0dbd\u0d82(( \u0dbd\u0d82\u0d9c \u0da2\u0dba \u0da2\u0dba \u0dbd\u0d82\u0dad\u0dd3\u0dbb\u0dd4 \u0dbd\u0d82\u0db6 \u0daf \u0dbd\u0d82\u0d91\u0dca \u0dbd\u0d82\u0d9c\u0daf\u0dd2\u0dba\u0dba \u0da2 \u0dbd\u0d82\u0dd2\u0db1\u0dba\u0dba\u0da7 \u0dbd\u0d8232 \u0dbd\u0d82\u0daf\u0dca\u0daf\u0db4\u0dad\u0dca \u0dbd\u0d82\u0d89\u0dca\u0db4\u0dc3\u0dd4\u0daf \u0dbd\u0d82\u0dd2\u0db1\u0dba\u0dba\u0da7 \u0dbd\u0d8202 \u0dbd\u0d82\u0daf\u0dca\u0daf\u0db4\u0dad\u0dca \u0dbd\u0d82\u0d9c\u0dca \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dc3\u0dca\u0da2 \u0dbd\u0d82\u0d9c\u0db4\u0da7 \u0dbd\u0d82\u200d\u0dbb\u0db8\u0dd2 \u0daf \u0dbd\u0d82\u0db4\u0dd4\u0dc5\u0dd4\u0daf\u0dca \u0da2 \u0dbd\u0d82\u0d9a\u0dd0\u0db6\u0dd4\u0dab\u0db4. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0dcf\u0da2\u0dd2 \u0dbd\u0d82\u0dd2\u0dc5\u0da7\u0dd2\u0dca \u0dbd\u0d82\u0d91\u0da2 \u0dbd\u0d82 \u0db4\u0dba\u0dab\u0db4\u0daf\u0d9a\u0da7 \u0dbd\u0d82\u0d9c\u0dd2\u0dc5 \u0dbd\u0d82\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0da2\u0dba \u0dbd\u0d82\u0dad\u0dd3\u0dca\u0dd4\u0dc0 \u0dbd\u0d82\u0d9c\u0dba \u0dc3\u0da2 \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db4\u0dad\u0dca\u0da2 \u0dbd\u0d82 \u0daf\u0dca \u0dca. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0dcf\u0dba \u0dbb\u0dca\u0dbd \u0dbd\u0d82\u0da2\u0dd1\u0dcf \u0da2 \u0dbd\u0d82\u0db6\u0d9a\u0dc4\u0dad\u0dca \u0db4\u0dba \u0dbd\u0d82\u0dbb\u0da2\u0dba \u0dbd\u0d82 \u0dba\u0db4\u0daf\u0db4 \u0dc3\u0da2 \u0dbd\u0d82\u0dcf\u0db4\u0da9\u0dd4\u0d9a\u0da9 \u0dbd\u0d82\u0db1\u0dd2\u0dc2\u0dae\u0db4\u0db4\u0daf\u0da2\u0dba \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8\u0da2 \u0dbd\u0d82\u0d92\u0daf\u0db4 \u0dbd\u0d82\u0d9c\u0db4\u0da2\u0dba\u0da2\u0dba \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8\u0da2 \u0dbd\u0d82\u0dba\u0da2 \u0dbd\u0d82 \u0db4\u0dba\u0dab\u0db4\u0daf\u0d9a \u0da2 \u0dbd\u0d825 9( \u0dbd\u0d82\u0d87 \u0da2\u0dbb\u0dd2 \u0db4 \u0dbd\u0d82\u0d91\u0dca\u0dcf\u0dad\u0dca \u0dbd\u0d82\u0da2\u0dcf\u0da2\u0db4\u0daf \u0dbd\u0d82 \u0daf \u0dc5 \u0dbd\u0d82\u0db4\u0da2 \u0dad\u0dca \u0dbd\u0d82325 \u0dbd\u0d82\u0daf\u0dc3\u0dca\u0dad\u0dd2\u0dba \u0dbd\u0d82\u0dcf\u0da2\u0dd2 \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db4\u0dad\u0dca\u0da2 \u0dbd\u0d82 \u0daf\u0dca \u0dca. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0db1\u0dd4\u0daf \u0dbd\u0d82\u0d94\u0dc0\u0dd4\u0dca \u0dbd\u0d82\u0dcf\u0dae\u0daf\u0db4\u0db0\u0dd3\u0da2\u0dad\u0dca\u0daf\u0dba \u0dbd\u0d82\u0da2\u0dcf \u0dbd\u0d82\u0db4\u0dd3\u0db8\u0dca\u0dc2\u0dab \u0dbd\u0d82 \u0da7\u0dd4\u0dad \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8 \u0da2\u0dca \u0dbd\u0d82\u0dba\u0db8\u0dca \u0dbd\u0d82\u0dd2\u0dc3\u0da2\u0dbb\u0dca\u0dbd \u0da2 \u0dbd\u0d82 \u0da7\u0dd4\u0dad \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8 \u0da2\u0dca \u0dbd\u0d82\u0d9a\u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0dbd\u0d82\u200d\u0dbb\u0dad\u0dd2\u0db5\u0d9a \u0dbd\u0d82\u0d9c\u0db1\u0dd4\u0daf \u0dbd\u0d82\u0dba\u0db8\u0dca \u0dbd\u0d82\u0dca \u0db4\u0dba\u0dba\u0dd2\u0dbb\u0dca \u0dbd\u0d82 \u0dbd\u0d82\u0dba\u0da7\u0daf\u0dbd\u0dca \u0dbd\u0d82\u0dc3\u0dab\u0da2\u0db4\u0daf \u0da7\u0da2 \u0dbd\u0d82\u0dcf\u0db4\u0da9\u0dd4\u0d9a\u0da9 \u0dbd\u0d82\u0db1\u0dd2\u0dc2\u0dae\u0db4\u0db4\u0daf\u0da2\u0dba \u0dbd\u0d82 \u0dc5 \u0dbd\u0d82 \u0db8\u0dca \u0dbd\u0d82\u0db6\u0d9a\u0dc4\u0dad\u0dca \u0db4\u0dba \u0dbd\u0d82\u0dbb\u0da2\u0dba \u0dbd\u0d82\u0dcf\u0db4\u0dd2\u0dc3\u0dcf \u0dbd\u0d82\u0dd2\u0dc3\u0dba \u0dbd\u0d82\u0dc4\u0dd0\u0dd2\u0dbb\u0dd2 \u0dbd\u0d82\u0dd2\u0dbb\u0dba\u0da2 \u0dbd\u0d82\u0d9c\u0daf\u0daf\u0db4\u0da2\u0da2 \u0dbd\u0d82\u0da2\u0dcf \u0dbd\u0d82\u0dba\u0da7\u0daf\u0dbd\u0dca \u0dbd\u0d82 9\u0dd2\u0dbb\u0dca \u0dbd\u0d82 \u0dcf \u0dba\u0db4\u0dc3\u0dad\u0dca \u0dbd\u0d82\u0dba\u0da7\u0daf\u0d9a\u0da7 \u0dbd\u0d82\u0dd2\u0db1\u0dba\u0dba\u0da7 \u0dbd\u0d8250.4 \u0dbd\u0d82\u0db6 \u0daf\u0dca \u0dbd\u0d82\u0dcf\u0dc4 \u0dbd\u0d82\n\n\u0da2\u0dba\u0da2\u0dba \u0dbd\u0d82 \u0dba\u0da2 \u0dbd\u0d82\u0d9c\u0dd4 \u0daf\u0dca\u200d\u0dbb\u0daf\u0dba\u0daf\u0d9a \u0dbd\u0d82\u0dba\u0db8\u0dca \u0dbd\u0d82\u0dca \u0db4\u0dba\u0dba \u0dbd\u0d82 \u0daf\u0da2 \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0db6\u0d9a\u0dc4\u0dad\u0dca \u0db4\u0dba \u0dbd\u0d82\u0dbb\u0da2\u0dba \u0dbd\u0d82\u0dcf\u0db8\u0dca\u0db6\u0dca\u0db0 \u0dbd\u0d82 \u0daf\u0da0\u0dca\u0da0\u0dd4\u0da0 \u0dbd\u0d82\u0dcf\u0db4\u0da9\u0dd4\u0d9a\u0da9 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4\u0daf \u0dbd\u0d82\u0dd2\u0dbb\u0dba\u0da2 \u0dbd\u0d82 \u0db4\u0dba\u0dab \u0d86 \u0da2 \u0dbd\u0d82\u0daf\u0dd0\u0da2\u0da7\u0dad\u0dca \u0dbd\u0d82\u0d91\u0dba \u0dbd\u0d82\u0d9c\u0db1\u0dd4\u0dc3\u0da2\u0da2\u0dba \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0db4\u0dd3\u0db8\u0dca\u0dc2\u0db4 \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0db1\u0dd4\u0daf \u0dbd\u0d82\u0dcf\u0da2\u0dd2 \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0d9c\u0dd4 \u0daf\u0dca \u0dbd\u0d82\u0dcf\u0db4\u0da9\u0dd4\u0d9a\u0da9 \u0dbd\u0d82\u0dca\u0da2\u0dba\u0da2\u0dba \u0dbd\u0d82 \u0dba\u0dca \u0dca. \u0dbd\u0d82"
